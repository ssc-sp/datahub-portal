{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "migrationName",
      "description": "Enter the migration name (e.g., AddUserTable)",
      "default": "NewMigration",
      "type": "promptString"
    },
    {
      "id": "tenantId",
      "description": "Pick Azure Tenant ID",
      "type": "pickString",
      "options": [
        "(163ent) 7198d08c-c362-4703-9854-53b6f0d8fc44",
        "(163Oxygen) 8c1a4d93-d828-4d0e-9303-fd3bd611c822"
      ],
      "default": "(163Oxygen) 8c1a4d93-d828-4d0e-9303-fd3bd611c822"
    }
  ],
  "tasks": [
    {
      "label": "Watch Portal (Hot Reload)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Portal/src/Datahub.Portal/Datahub.Portal.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Azure: Login (PowerShell - Device Code)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$tenant = ('${input:tenantId}' -split '\\)\\s+', 2)[1]; Import-Module Az.Accounts -ErrorAction Stop; Connect-AzAccount -UseDeviceAuthentication -Tenant $tenant; Get-AzContext | Format-List"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "EF Core: Add Migration",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef",
        "migrations",
        "add",
        "${input:migrationName}",
        "--project",
        "${workspaceFolder}/Portal/src/Datahub.Infrastructure/Datahub.Infrastructure.csproj",
        "--startup-project",
        "${workspaceFolder}/Portal/src/Datahub.Portal/Datahub.Portal.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "EF Core: Update Database",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef",
        "database",
        "update",
        "--project",
        "${workspaceFolder}/Portal/src/Datahub.Infrastructure/Datahub.Infrastructure.csproj",
        "--startup-project",
        "${workspaceFolder}/Portal/src/Datahub.Portal/Datahub.Portal.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Test: Run All Unit Tests",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/Datahub.sln"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "Fix: Format Code (dotnet format)",
      "command": "dotnet",
      "type": "process",
      "args": ["format", "${workspaceFolder}/Datahub.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Fix: Deep Clean (Nuke bin/obj)",
      "type": "shell",
      "command": "find . -iname 'bin' -o -iname 'obj' | xargs rm -rf",
      "windows": {
        "command": "Get-ChildItem -Inc -Include bin,obj -Recurse | Remove-Item -Force -Recurse"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Fix: Regenerate Dev Certs",
      "type": "shell",
      "command": "bash .devcontainer/portal-dev/post-create.sh",
      "presentation": { "reveal": "always" }
    }
  ]
}
