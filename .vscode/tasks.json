{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Portal (Hot Reload)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Portal/src/Datahub.Portal/Datahub.Portal.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    }
  ]
}