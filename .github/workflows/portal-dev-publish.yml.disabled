name: Build & Publish Portal (develop)

on:
  push:
    branches: [develop]
  workflow_dispatch:
  schedule:
    - cron: "17 */6 * * *" # 00:17, 06:17, 12:17, 18:17 UTC

permissions:
  id-token: write
  contents: read
  packages: write

env:
  DOCKERFILE: Dockerfiles/Dockerfile.portal
  CONTEXT: .
  PLATFORMS: linux/amd64
  IMAGE_GHCR: ghcr.io/${{ github.repository }}/datahub-portal
  PUSH_TO_JFROG: "false"
  IMAGE_JFROG: artifacts-artefacts.devops.cloud-nuage.canada.ca/docker-local/datahub-portal

concurrency:
  group: portal-develop-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-and-push:
    runs-on: ubuntu-latest

    steps:
      - name: Normalize image names (lowercase)
        run: |
          repo_lc="${GITHUB_REPOSITORY,,}"        # bash lowercase
          echo "REPO_LC=$repo_lc" >> "$GITHUB_ENV"
          echo "IMAGE_GHCR=ghcr.io/${repo_lc}/datahub-portal" >> "$GITHUB_ENV"

      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false

      - name: Set up Buildx
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4

      - name: Setup JFrog CLI (OIDC)
        id: setup-jfrog-cli
        uses: jfrog/setup-jfrog-cli@deda456d982fc5e9a7a020b63eb0d2968aedd33e # v5.1.0
        env:
          JF_URL: https://artifacts-artefacts.devops.cloud-nuage.canada.ca
        with:
          oidc-provider-name: github-oidc

      - name: Login to GHCR (push)
        uses: docker/login-action@af1e73f918a031802d376d3c8bbc3fe56130a9b0 # v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Jfrog Docker login
        uses: docker/login-action@af1e73f918a031802d376d3c8bbc3fe56130a9b0 # v4
        with:
          registry: https://artifacts-artefacts.devops.cloud-nuage.canada.ca
          username: ${{ steps.setup-jfrog-cli.outputs.oidc-user }}
          password: ${{ steps.setup-jfrog-cli.outputs.oidc-token }}

      - name: Read version.txt
        id: ver
        run: |
          if [ ! -f version.txt ]; then
            echo "version.txt not found"; exit 1
          fi
          v=$(sed -e 's/"//g' -e 's/[[:space:]]//g' version.txt)
          echo "version=$v" >> "$GITHUB_OUTPUT"

      - name: Compute tags (GHCR + optional JFrog)
        id: tags
        run: |
          VERSION="${STEPS_VER_OUTPUTS_VERSION}"
          DATECODE=$(date -u +%Y%m%d-%H%M)
          SHA_SHORT=${GITHUB_SHA::7}

          IFS='.' read -r MAJOR MINOR PATCH <<EOF
          $VERSION
          EOF

          # GHCR tags
          TAGS="${IMAGE_GHCR}:dev-${MAJOR}.${MINOR}.${PATCH}-${DATECODE}-g${SHA_SHORT}"
          TAGS="$TAGS,${IMAGE_GHCR}:dev-${VERSION}"
          TAGS="$TAGS,${IMAGE_GHCR}:dev-${MAJOR}.${MINOR}-latest"
          TAGS="$TAGS,${IMAGE_GHCR}:dev-${MAJOR}-latest"
          TAGS="$TAGS,${IMAGE_GHCR}:dev-latest"

          # Optional: also push same tags to JFrog docker repo
          if [ "${{ env.PUSH_TO_JFROG }}" = "true" ]; then
            TAGS="$TAGS,${{ env.IMAGE_JFROG }}:dev-${MAJOR}.${MINOR}.${PATCH}-${DATECODE}-g${SHA_SHORT}"
            TAGS="$TAGS,${{ env.IMAGE_JFROG }}:dev-${VERSION}"
            TAGS="$TAGS,${{ env.IMAGE_JFROG }}:dev-${MAJOR}.${MINOR}-latest"
            TAGS="$TAGS,${{ env.IMAGE_JFROG }}:dev-${MAJOR}-latest"
            TAGS="$TAGS,${{ env.IMAGE_JFROG }}:dev-latest"
          fi

          echo "tags=$TAGS" >> "$GITHUB_OUTPUT"
        env:
          STEPS_VER_OUTPUTS_VERSION: ${{ steps.ver.outputs.version }}

      - name: Build & Push (to all tags we computed)
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7
        with:
          provenance: false
          context: ${{ env.CONTEXT }}
          file: ${{ env.DOCKERFILE }}
          platforms: ${{ env.PLATFORMS }}
          push: true
          pull: true
          no-cache: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
          tags: ${{ steps.tags.outputs.tags }}
          labels: |
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            org.opencontainers.image.revision=${{ github.sha }}
            org.opencontainers.image.version=${{ steps.ver.outputs.version }}

      - name: Summary
        run: |
          echo "Pushed tags:"
          echo "${STEPS_TAGS_OUTPUTS_TAGS}" | tr ',' '\n'
        env:
          STEPS_TAGS_OUTPUTS_TAGS: ${{ steps.tags.outputs.tags }}
