<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<AzureFunctionsVersion>v4</AzureFunctionsVersion>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>7085b673-23cc-4759-933a-5a22d1004411</UserSecretsId>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="EmailTemplates\cost_alert.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\project_inactive_alert_dhadmin.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\user_invitation.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\project_inactive_alert.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\user_lock_alert.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\user_deletion_alert.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\bug_report.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\test_template.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="EmailTemplates\delete_notification.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Azure.Data.Tables" Version="12.11.*" />
		<PackageReference Include="Azure.Identity" Version="1.20.*">
			<Aliases>AzIdentity</Aliases>
		</PackageReference>
		<PackageReference Include="Azure.Storage.Queues" Version="12.23.*" />
		<PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.*" />
		<PackageReference Include="MassTransit" Version="8.5.*" />
		<PackageReference Include="MassTransit.WebJobs.ServiceBus" Version="8.5.*" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.1.*" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.23.*" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage" Version="6.8.*" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.*" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.*" />

		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.*" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.5" />
		<PackageReference Include="MailKit" Version="4.16.*" />
		<PackageReference Include="Microsoft.TeamFoundationServer.Client" Version="19.225.1" />
		<PackageReference Include="Microsoft.VisualStudio.Services.Client" Version="19.225.1" />
		<PackageReference Include="Microsoft.VisualStudio.Services.InteractiveClient" Version="19.225.1" />
	</ItemGroup>
	<ItemGroup>
		<None Update="host.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="local.settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Threading.ExecutionContext" Alias="ExecutionContext" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Datahub.Functions.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Portal\src\Datahub.Core\Datahub.Core.csproj" />
		<ProjectReference Include="..\..\..\Portal\src\Datahub.Infrastructure\Datahub.Infrastructure.csproj" />
		<ProjectReference Include="..\Datahub.Functions.Domain\Datahub.Functions.Domain.csproj" />
		<ProjectReference Include="..\..\..\Portal\src\Datahub.Portal\Datahub.Portal.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>
</Project>











