@inject IDbContextFactory<MetadataDbContext> ContextFactory
@inject NavigationManager NavigationManager
@using Datahub.Metadata.Model
@using Datahub.Metadata.DTO
@using MudBlazor
@using System.Timers

<div>
    <div style="display: flex; align-items: center;">
        <MudTextField T="string" @bind-Value="LastSearch" Placeholder="Search" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />

        @if (!string.IsNullOrEmpty(_lastSearch))
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClearSearch" />
        }
    </div>

    <MudTable T="FieldDefinition" Items="@_filteredDefinitions" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>@Localizer["Order"]</MudTh>
            <MudTh>@Localizer["ID"]</MudTh>
            <MudTh>@Localizer["English Name"]</MudTh>
            <MudTh>@Localizer["French Name"]</MudTh>
            <MudTh>@Localizer["Has Choices?"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@GetOrder(context)</MudTd>
            <MudTd>@GetName(context)</MudTd>
            <MudTd>@GetNameEnglish(context)</MudTd>
            <MudTd>@GetNameFrench(context)</MudTd>
            <MudTd>@GetHasChoices(context)</MudTd>
            <MudTd DataLabel=""><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => HandleEdit(context))" /></MudTd>
        </RowTemplate>
    </MudTable>

    <div style="margin-top: 16px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/metadata/newdefinition"))">@Localizer["Add Definition"]</MudButton>
    </div>
</div>

@code {
    private List<FieldDefinition> _fieldDefinitions = new();
    private List<FieldDefinition> _filteredDefinitions = new();

    private string _lastSearch;
    private System.Timers.Timer _debounceTimer;

    private string GetOrder(FieldDefinition result) => result.Sort_Order_NUM.ToString();
    private string GetName(FieldDefinition result) => result.Field_Name_TXT;
    private string GetNameEnglish(FieldDefinition result) => result.Name_English_TXT;
    private string GetNameFrench(FieldDefinition result) => result.Name_French_TXT;

    private RenderFragment GetHasChoices(FieldDefinition result)
    => result.HasChoices ? @<span>Yes</span> : @<span>No</span>;

    private RenderFragment GetEditFragment(FieldDefinition result)
    => @<div style="cursor: pointer;" onclick=@(() => HandleEdit(result))><i class="far fa-edit sm-icon"></i></div>;

    protected override async Task OnInitializedAsync()
    {
        using var ctx = ContextFactory.CreateDbContext();

        _fieldDefinitions = await ctx.FieldDefinitions
            .Include(d => d.Choices)
            .OrderBy(d => d.Sort_Order_NUM)
            .ToListAsync();

        ApplyFilter();
    }

    private string LastSearch
    {
        get => _lastSearch;
        set
        {
            _lastSearch = value;
            DebounceSearch();
        }
    }

    private void DebounceSearch()
    {
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
        }

        _debounceTimer = new System.Timers.Timer(300); // 300ms debounce time
        _debounceTimer.Elapsed += async (sender, e) =>
        {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
            _debounceTimer = null;
            await InvokeAsync(() => ApplyFilter());
        };
        _debounceTimer.Start();
    }

    private void ClearSearch()
    {
        _lastSearch = string.Empty;
        ApplyFilter();
    }

    private void HandleEdit(FieldDefinition definition)
    {
        NavigationManager.NavigateTo($"/metadata/definition/{definition.FieldDefinitionId}");
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(_lastSearch))
        {
            _filteredDefinitions = new List<FieldDefinition>(_fieldDefinitions);
        }
        else
        {
            _filteredDefinitions = _fieldDefinitions
                .Where(d => d.Field_Name_TXT.Contains(_lastSearch, StringComparison.OrdinalIgnoreCase) ||
                            d.Name_English_TXT.Contains(_lastSearch, StringComparison.OrdinalIgnoreCase) ||
                            d.Name_French_TXT.Contains(_lastSearch, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        StateHasChanged();
    }
}
