@using Datahub.Metadata.DTO
@using Datahub.Metadata.Model
@using MudBlazor

<div>
    <div>
        <div style="margin: 8px 0px 8px 0px;">
            <div>
                <MudText Typo="Typo.h6">Name English</MudText>
            </div>
            <div>
                <MudTextField T="string"
                              Placeholder="Enter section name (english)..."
                              @bind-Value="Section.English"
                              FullWidth="true" />
            </div>
        </div>

        <div style="margin: 8px 0px 8px 0px;">
            <div>
                <MudText Typo="Typo.h6">Name French</MudText>
            </div>
            <div>
                <MudTextField T="string"
                              Placeholder="Enter section name (french)..."
                              @bind-Value="Section.French"
                              FullWidth="true" />
            </div>
        </div>
    </div>

    <div>
        <MetadataSectionFields @key=@Section.ListId
                               Fields=@AvailableFields
                               Selection=@Section.Fields />
    </div>

    @if (IsNew)
    {
        <MudButton OnClick="@OnSaveNew" Disabled="@InvalidSection" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
        <MudButton OnClick="@OnDiscardNew" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
    }
</div>

@code {

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public MetadataSectionDetails Section { get; set; }

    [Parameter]
    public List<FieldDefinition> AvailableFields { get; set; }

    [Parameter]
    public EventCallback OnSaveNew { get; set; }

    [Parameter]
    public EventCallback OnDiscardNew { get; set; }

    private bool InvalidSection => string.IsNullOrEmpty(Section.English) || string.IsNullOrEmpty(Section.French);
}
