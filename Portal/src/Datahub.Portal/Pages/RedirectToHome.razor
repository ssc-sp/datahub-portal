@page "/"
@inject NavigationManager Navigation

@code {

    protected override void OnInitialized()
    {
        try
        {
            Navigation.NavigateTo(Localizer[PageRoutes.Home], true);
        }
        catch (NavigationException)
        {
            // Should be ignored, see https://github.com/dotnet/aspnetcore/issues/13582
        }
    }
}
