@page "/login"
@page "/connexion"
@layout BarebonesPublicLayout
@inject NavigationManager _navigationManager
@inject IUserInformationService _userInformationService
@inject DatahubPortalConfiguration _portalConfiguration

<PageTitle>@Localizer["Login - Federal Science DataHub"]</PageTitle>

<MudContainer MaxWidth=@MaxWidth.Medium>
    <MudPaper Class="pt-12 px-12 mt-12">
        <MudStack>
            <MudGrid>
                <MudItem xs="11">
                    <MudImage Src=@Localizer["/img/canada-fip.svg"] Class="mb-4" Alt="Government of Canada Wordmark / Symbole de mot du gouvernement du Canada" Style="max-height: 1.5rem" />
                </MudItem>
                <MudItem xs="1">
                    <LanguageToggle />
                </MudItem>
            </MudGrid>
            <DHMainContentTitle Title="@Localizer["MainTitle"]" />
        </MudStack>
        <MudText Typo="Typo.body1" Class="mt-4">
            @Localizer["To learn more about the FSDH, visit the "]
            <MudLink Href="@Localizer["https://www.canada.ca/en/shared-services/services/tools-to-equip-gc-workers/tools-science/federal-science-datahub.html"]" Typo="Typo.body1">@Localizer["Canada.ca pages"]</MudLink>
            @Localizer[" about the platform. For Government of Canada employees, more detailed information is available on the "]
            <MudLink Href="@Localizer["https://gcxgce.sharepoint.com/teams/10002160"]" Typo="Typo.body1">@Localizer["GCxchange"]</MudLink>
            @Localizer[" site (only available within the GC network)."]
        </MudText>
        <MudText Typo="Typo.body1" Class="mt-4">
            @Localizer["If it's your first time signing in, please follow the "]
            <MudLink Href="@Localizer["/account-setup"]" Typo="Typo.body1">@Localizer["Account Setup"]</MudLink>
            @Localizer[" instructions."]
        </MudText>
        <MudStack AlignItems="AlignItems.Center" Class="mt-4" Style="width: 100%">
            <MudText Typo="Typo.body1" Class="text-center">
                <strong>
                    @Localizer["Log in as:"]
                </strong>
            </MudText>
            <DHButton Class="px-16 my-2" Variant="Variant.Filled" Color="Color.Primary" Style="width:50%;" Href="@Localizer[PageRoutes.LoginEntra]">
                <span>
                    @Localizer["Government of Canada employee"]
                    <span class="sr-only"></span>
                </span>
            </DHButton>
            <DHButton Class="px-16 my-2" Variant="Variant.Filled" Style="width:50%;" Disabled="true">
                <span>
                    @Localizer["External user (coming soon)"]
                    <span class="sr-only"></span>
                </span>
            </DHButton>
        </MudStack>
        <DHFooter />
    </MudPaper>
</MudContainer>

