        <PropertyColumn Property="x => x.UniqueDepartments" Title="Department(s)"></PropertyColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="string" />
    </PagerContent>



</MudDataGrid>

<MudStack>
