@using Datahub.Application.Services
@using Datahub.Portal.Pages.Workspace.Reports.Charts
@using Datahub.Shared.Entities
@using System.Text.Json
@using Datahub.Application.Services.Cost
@using Datahub.Core.Model.Projects

@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject DatahubPortalConfiguration _datahubPortalConfiguration
@inject IJSRuntime _jsRuntime
@inject IProjectUserManagementService _projectUserManagementService

<MudStack>
    <MudText Typo="Typo.h2">DataHub Statistics</MudText>
    <MudText>This page shows statistics about the DataHub.</MudText>
    <MudSpacer />
    <DHButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@SidebarIcons.Download" OnClick="HandleDownload" Class="mr-4">@Localizer["Download to CSV"]</DHButton>

    <MudTable Sortable="true" T="DatahubProjectStatsRow" Striped="true" Loading="_isLoading" LoadingProgressColor="Color.Info" ServerData="LoadWorkspaceChecks" @ref="workspaceHealthTable">
        <ToolBarContent>
            <MudTextField Value="searchAcronym"
            Placeholder=@Localizer["Search by workspace name or acronym"]
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search"
            IconSize="Size.Medium" Class="mt-0"
            ValueChanged="SearchAcronymChanged"
            DebounceInterval="300"
            Label=""
            T="string"
            Immediate="true" />
            <MudSpacer />
            <MudSelect T="string" SelectedValues="selectedResources" SelectedValuesChanged=SelectedResourcesChanged Variant="Variant.Text" Dense="true" MultiSelection="true">
                <MudSelectItem T="string" Value="null" DataLabel="Lead(s)">@Localizer["All"]</MudSelectItem>
                @foreach (var status in _resources)
                {
                    <MudSelectItem T="string" Value="status">@Localizer[status.ToString()]</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudNumericField Value="numberUsers"
            ValueChanged="NumberUsersChanged"
            DebounceInterval="300"
            Label="Minimum Users in Workspace"
            T="int"
            Immediate="true"
            Min="0"/>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
            </MudTh>
            <MudTh>
                <MudTableSortLabel
                    InitialDirection="SortDirection.Ascending"
                    SortLabel="Workspace"
                    SortBy="@(new Func<DatahubProjectStatsRow, object>(x => x.Name))">Workspace</MudTableSortLabel>

            </MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortLabel="Department"
                    SortBy="@(new Func<DatahubProjectStatsRow, object>(x => x.Department))">Department</MudTableSortLabel>
                @*                 <MudTextField Value="searchDepartment"
                ValueChanged="SearchDepartmentChanged"
                DebounceInterval="300"
                Label=""
                T="string"
                Immediate="true" /> *@
            </MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortLabel="BudgetRemaining"
                    SortBy="@(new Func<DatahubProjectStatsRow, object>(x => x.BudgetRemaining))">Budget Remaining</MudTableSortLabel>
                @* <MudNumericField Value="percentBudget"
                ValueChanged="PercentBudgetChanged"
                DebounceInterval="300"
                Label="% Budget Remaining"
                T="int"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.Percent"
                Min="0"/> *@
            </MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortLabel="ProvisionedTools" 
                    SortBy="@(new Func<DatahubProjectStatsRow, object>(x => x.ProvisionedResources))">Provisioned Tools</MudTableSortLabel>
                @* <MudSelect T="string" SelectedValues="selectedResources" SelectedValuesChanged=SelectedResourcesChanged Variant="Variant.Text" Dense="true" MultiSelection="true">
                    <MudSelectItem T="string" Value="null" DataLabel="Lead(s)">@Localizer["All"]</MudSelectItem>
                    @foreach (var status in _resources)
                    {
                        <MudSelectItem T="string" Value="status">@Localizer[status.ToString()]</MudSelectItem>
                    }
                </MudSelect> *@
            </MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortLabel="LastLogin"
                    SortBy="@(new Func<DatahubProjectStatsRow, object>(x => x.LastLogin))">Last User Login</MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="ShowMore">
                <DHButton Size="Size.Small" OnClick="@(() => ShowUsersPressed(context.ProjectId, context.Acronym))">
                    @if(context.ShowUserDetails)
                    {
                        <MudIcon Icon="fa fa-chevron-right" Size="Size.Medium"></MudIcon>
                    }
                    else
                    {
                        <MudIcon Icon="fa fa-chevron-down"></MudIcon>
                    }

                </DHButton>
            </MudTd>
            <MudTd DataLabel="Workspace">
                <DHButton Href="@($"/{_datahubPortalConfiguration.ProjectUrlSegment}/{context.Acronym}")">
                    <strong> @context.Acronym </strong>
                </DHButton>
            </MudTd>
            <MudTd DataLabel="Department">
                @if(context.Department != context.Acronym)
                {
                    @context.Department
                }
            </MudTd>
            <MudTd DataLabel="Budget Remaining">
                <MudTooltip Text="@($"{context.BudgetSpent.ToString("C", CultureInfo.CurrentCulture)} / {context.BudgetLimit.ToString("C", CultureInfo.CurrentCulture)}")">
                    @if(context.BudgetRemaining < 0)
                    {
                        <MudText Style="color: red;">
                            @context.BudgetRemaining.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>
                    }
                    else
                    {
                        <MudText>
                            @context.BudgetRemaining.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>
                    }
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Provisioned Tools">
                @foreach(var tool in context.ProvisionedResources)
                {
                    <MudText>
                        @GetLabel(tool.ResourceType)
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Last User Login">
                @if(context.LastLogin > new DateTime(2023, 01, 01))
                {
                    @context.LastLogin
                }
            </MudTd>
        </RowTemplate>

        <ChildRowContent>
            @if (context.ShowUserDetails)
            {

                <MudTr>
                    <td colspan="7">
                        <MudCard Elevation="0">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1">Details for <strong>@context.Name</strong></MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent class="pl-6 py-0 pr-0">
                                @Localizer["Cost of last 7 days: "] @context.CostOfLastXDays.ToString("C", CultureInfo.CurrentCulture)
                                <br/>
                                @Localizer["Metadata status: "]
                                @if(context.MetadataComplete)
                                {
                                    
                                }
                                @if(context.AllUsers != null && context.AllUsers.Any())
                                {
                                    <MudTable Items="@context.AllUsers" Context="AllUsersContext" Elevation="0" Sortable="true" Dense Style="background-color: grey;">
                                        <HeaderContent>
                                            <MudTh>
                                                <MudTableSortLabel SortBy="@(new Func<string, object>(x => x))">
                                                    <strong>Name</strong>
                                                </MudTableSortLabel>
                                            </MudTh>
                                            <MudTh>
                                                <MudTableSortLabel SortBy="@(new Func<string, object>(x => x))">
                                                    <strong>Email</strong>
                                                </MudTableSortLabel>
                                            </MudTh>
                                            <MudTh>
                                                <MudTableSortLabel SortBy="@(new Func<string, object>(x => x))">
                                                    <strong>Role</strong>
                                                </MudTableSortLabel>
                                            </MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            @if (AllUsersContext.RoleId == 1)
                                            {
                                                <MudTd DataLabel="AllUsers" Style="background-color: lightcoral;">
                                                    @AllUsersContext.PortalUser.DisplayName
                                                </MudTd>
                                                <MudTd DataLabel="Leads" Style="background-color: lightcoral;">
                                                    @AllUsersContext.PortalUser.Email
                                                </MudTd>
                                                <MudTd DataLabel="Leads" Style="background-color: lightcoral;">
                                                    @GetRole(AllUsersContext.RoleId)
                                                </MudTd>
                                            }
                                            else
                                            {
                                                <MudTd DataLabel="AllUsers" Style="background-color: lightgrey;">
                                                    @AllUsersContext.PortalUser.DisplayName
                                                </MudTd>
                                                <MudTd DataLabel="Leads" Style="background-color: lightgrey;">
                                                    @AllUsersContext.PortalUser.Email
                                                </MudTd>
                                                <MudTd DataLabel="Leads" Style="background-color: lightgrey;">
                                                    @GetRole(AllUsersContext.RoleId)
                                                </MudTd>
                                            }
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudCardContent>
                        </MudCard>
                    </td>
                </MudTr>
            }
        </ChildRowContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="@Localizer["Rows per page:"]" InfoFormat="@("{first_item}-{last_item} " + Localizer["of"] + " {all_items}")" />
        </PagerContent>
    </MudTable>
</MudStack>

@code {

    [Parameter]
    public Datahub_Project Project { get; set; }

    private bool _isLoading = true;
    private bool _isReadOnly = true;
    private IJSObjectReference _module;

    private List<DatahubProjectStatsRow> _statsRows = new();
    private List<DatahubProjectStatsRow> _filteredItems = new();
    private List<DatahubProjectStatsRow> _workspaceInfrastructureHealthData = new();

    private string searchAcronym = "", searchLead = "";
    private int percentBudget = 0, numberUsers = 0;

    private IEnumerable<string> selectedResources = new HashSet<string>();

    private MudTable<DatahubProjectStatsRow> workspaceHealthTable;

    private List<Datahub_Project_User> userz;


    private List<string> _resources =
    [
        "new-project-template",
    "azure-storage-blob",
    "azure-databricks",
    "azure-app-service",
    "azure-postgres"
    //     TerraformTemplate.AzureDatabricks,
    // TerraformTemplate.AzureStorageBlob,
    // TerraformTemplate.AzureAppService,
    // TerraformTemplate.AzurePostgres,
    // TerraformTemplate.AzureArcGis,
    // TerraformTemplate.AzureAPI
    ];


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _module = await _jsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/Tools/Statistics/StatisticsPage.razor.js");


            await using var context = await _dbContextFactory.CreateDbContextAsync();
            const int numberOfDays = 7;




            _statsRows = context.Projects
                .Include(p => p.Credits)
                //.Include(p => p.Users)
                .Include(p => p.Resources)
                // .Include(p => p.ProjectRequestAudits)
                .AsEnumerable()
                .Select(p => new DatahubProjectStatsRow()
                {
                    ProjectId = p.Project_ID,
                    Name = p.Project_Name,
                    Acronym = p.Project_Acronym_CD,
                    MetadataComplete = p.MetadataAdded ?? false,
                    BudgetLimit = p.Project_Budget ?? 0,
                    BudgetSpent = p.Credits?.Current ?? 0,
                    CostOfLastXDays = GetLastXDaysOfCosts(p.Credits, numberOfDays),

                        //AllUsers = p.Users?.ToList(),
                        ProvisionedResources = p.Resources?.ToList(),
                        IsDeleted = p.IsDeleted,
                        Department = p.Sector_Name,
                        LastLogin = p.LastLoginDate

                    // Leads = p.Users?.Where(u => u.RoleId == (int) Project_Role.RoleNames.WorkspaceLead).Select(u => u.User_Name).ToList(),
                    // Admins = p.Users?.Where(u => u.RoleId == (int) Project_Role.RoleNames.Admin).Select(u => u.User_Name).ToList(),
                    // Collaborators = p.Users?.Where(u => u.RoleId == (int) Project_Role.RoleNames.Collaborator).Select(u => u.User_Name).ToList(),
                    // StorageStatus = p.Resources?
                    //     .Where(sr => sr.ResourceType.Contains(TerraformTemplate.AzureStorageBlob))
                    //     .Select(sr => sr.CreatedAt.HasValue ? DatahubProjectStatsRow.ResourceStatus.Complete : DatahubProjectStatsRow.ResourceStatus.Requested)
                    //     .FirstOrDefault() ?? DatahubProjectStatsRow.ResourceStatus.None,
                    // DatabricksStatus = p.Resources?
                    //     .Where(sr => sr.ResourceType.Contains(TerraformTemplate.AzureDatabricks))
                    //     .Select(sr => sr.CreatedAt.HasValue ? DatahubProjectStatsRow.ResourceStatus.Complete : DatahubProjectStatsRow.ResourceStatus.Requested)
                    //     .FirstOrDefault() ?? DatahubProjectStatsRow.ResourceStatus.None
                })
                .ToList();

            Console.WriteLine("-----------------------------------------------------");

            foreach (var row in _statsRows)
            {
                row.AllUsers = (await _projectUserManagementService.GetProjectUsersAsync(row.Acronym)).Where(r => r.RoleId != 1).OrderBy(u => u.RoleId).ToList();
            }

            _workspaceInfrastructureHealthData = _statsRows;

            await ReloadWorkspaceHealthCheckTableAsync();

            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectedResourcesChanged(IEnumerable<string> resources)
    {
        selectedResources = resources;
        await ReloadWorkspaceHealthCheckTableAsync();
    }

    private async Task SearchAcronymChanged(string search)
    {
        searchAcronym = search;
        await ReloadWorkspaceHealthCheckTableAsync();
    }

    private async Task SearchLeadChanged(string search)
    {
        searchLead = search;
        await ReloadWorkspaceHealthCheckTableAsync();
    }

    private async Task PercentBudgetChanged(int percent)
    {
        percentBudget = percent;
        await ReloadWorkspaceHealthCheckTableAsync();
    }

    private async Task NumberUsersChanged(int users)
    {
        numberUsers = users;
        await ReloadWorkspaceHealthCheckTableAsync();
    }

    private async Task ReloadWorkspaceHealthCheckTableAsync()
    {
        if (workspaceHealthTable is not null)
        {
            await workspaceHealthTable.ReloadServerData();
            // /Console.WriteLine("HELLLOOO DOWN THEREEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE");
        }
    }

    private async Task<TableData<DatahubProjectStatsRow>> LoadWorkspaceChecks(TableState state, CancellationToken cancellationToken)
    {
        var filteredData = _workspaceInfrastructureHealthData.AsEnumerable();

        // Apply type filter
        if (selectedResources.Any())
        {
            Console.WriteLine("resources: ");
            foreach(var tool in selectedResources)
            {
                filteredData = filteredData.Where(check => check.ProvisionedResources.Any(resource => resource.ResourceType.Contains(tool)));
                Console.WriteLine(tool);

            }
            
        }


        // Apply search filter
        if (!string.IsNullOrEmpty(searchAcronym))
        {
            filteredData = filteredData.Where(check => (check.Acronym.Contains(searchAcronym, StringComparison.OrdinalIgnoreCase) || check.Name.Contains(searchAcronym, StringComparison.OrdinalIgnoreCase)));
        }

        //Apply budget filter
        if (percentBudget > 0)
        {
            filteredData = filteredData.Where(check => (check.BudgetRemaining) * 100 <= (check.BudgetLimit) * percentBudget);
        }

        //Apply users filter
        if (numberUsers > 0)
        {
            filteredData = filteredData.Where(check => (check.AllUsers.Count() >= numberUsers));
        }

        // Apply sorting
        if (state.SortDirection != SortDirection.None)
        {
            Console.WriteLine($"SortLabel: {state.SortLabel}");
            Console.WriteLine($"Properties: {nameof(DatahubProjectStatsRow.Acronym)}, {nameof(DatahubProjectStatsRow.Department)}, {nameof(DatahubProjectStatsRow.BudgetRemaining)}");
            Func<DatahubProjectStatsRow, object> sortBy = state.SortLabel switch
            {
                nameof(DatahubProjectStatsRow.Acronym) => x => x.Acronym,
                nameof(DatahubProjectStatsRow.Department) => x => x.Department,
                nameof(DatahubProjectStatsRow.BudgetRemaining) => x => x.BudgetRemaining,
                nameof(DatahubProjectStatsRow.ProvisionedResources) => x => x.ProvisionedResources.Count(),
                nameof(DatahubProjectStatsRow.LastLogin) => x => x.LastLogin,
                _ => x => x.Acronym
            };

            filteredData = filteredData.OrderByDirection(state.SortDirection, sortBy);
        }

        // Apply pagination
        var totalItems = filteredData.Count();
        var pagedData = filteredData
            .Skip(state.Page * state.PageSize)
            .Take(state.PageSize)
            .ToList();

        return await Task.FromResult(new TableData<DatahubProjectStatsRow> { TotalItems = totalItems, Items = pagedData });
    }

    private async void ShowUsersPressed(int projectId, string acronym)
    {
        //PopulateUserList(acronym);
        var row = _statsRows.First(r => r.ProjectId == projectId);
        row.ShowUserDetails = !row.ShowUserDetails;
    }

    private static decimal GetLastXDaysOfCosts(Project_Credits projectCredits, int days)
    {
        if (projectCredits == null || projectCredits.CurrentPerDay == null)
        {
            return 0;
        }

        var currentPerDay = JsonSerializer.Deserialize(projectCredits.CurrentPerDay, typeof(List<DailyServiceCost>)) as List<DailyServiceCost>;
        var cost = currentPerDay?.Where(c => c.Date > DateTime.Now.AddDays(-days)).Sum(c => c.Amount) ?? 0;

        return cost;
    }


    private string GetOrg(string email)
    {
        if(email==null)
        {
            return "unknown";
        }
        var org = "";
        try
        {
            org = email.Split("@")[1].Split('-')[0];
        }
        catch
        {
            org = "unknown";
        }

        return org.ToUpper();
    }

    private string GetRole(int? num)
    {
        if(num == null)
        {
            return "None";
        }
        switch(num)
        {
            case (int)Project_Role.RoleNames.Remove:
                return "Removed";
            case (int)Project_Role.RoleNames.Admin:
                return "Admin";
            case (int)Project_Role.RoleNames.WorkspaceLead:
                return "Lead";
            case (int)Project_Role.RoleNames.Collaborator:
                return "Collaborator";
            default:
                return "Guest";
        }
    }

    private string GetLabel(string tool)
    {
        return tool switch
        {
            "terraform:new-project-template" => Localizer["New Project Template"],
            "terraform:azure-storage-blob" => Localizer["Azure Storage Blob"],
            "terraform:azure-databricks" => Localizer["Azure Databricks"],
            "terraform:azure-app-service" => Localizer["Azure App Service"],
            "terraform:azure-postgres" => Localizer["Azure Postgres"],
            _ => tool
        };
    }

    // CSV download
    private async Task HandleDownload()
    {
        var fileStream = GenerateCsvStream();
        var fileName = $"WorkspaceStatistics_{DateTime.Now.ToString("yyyy-MM-dd")}.csv";
        using var streamReference = new DotNetStreamReference(stream: fileStream);
        await _module.InvokeVoidAsync("downloadFileFromStream", fileName, streamReference);
    }

    private Stream GenerateCsvStream()
    {
        var stream = new MemoryStream();
        var writer = new StreamWriter(stream);
        writer.WriteLine("Acroynm,Name,Lead,Budget Remaining");
        foreach (var cost in _statsRows)
        {
            writer.WriteLine($"{cost.Acronym},{cost.Name},{cost.Leads},{cost.BudgetRemaining}");
        }

        writer.Flush();
        stream.Position = 0;
        return stream;
    }




}