@using Datahub.Application.Services
@using Datahub.Application.Services.Subscriptions
@using Datahub.Core.Model.Subscriptions

@inject INetworkingManagementService _networkingService
@inject ISubnetPoolService _subnetPoolService
@inject IDatahubAzureSubscriptionService _subscriptionService
@inject ISnackbar _snackbar
@inject ILogger<NetworkingManagementPage> _logger

<MudStack Spacing="4">
    <MudText Typo="Typo.h2">Networking Management</MudText>
    <MudText>
        Manage Azure Virtual Networks (VNets) and their subnets. Each workspace is mapped to 8 subnets sharing the same subnet group number.
    </MudText>

    @* ── VNet section ── *@
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h3">Virtual Networks</MudText>
        @* Only needed to set up an environment's VNet; a portal uses a single VNet. *@
        @if (_vnets.Count == 0)
        {
            <DHButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@SidebarIcons.Plus"
                      OnClick="@OpenAddVNetDialog">
                Add VNet
            </DHButton>
        }
    </MudStack>

    <MudTable Items="_vnets"
              T="VNet"
              Dense="true"
              Hover="true"
              Outlined="true"
              CanCancelEdit="true"
              SortLabel="@Localizer["Sort by"]"
              CommitEditTooltip="@Localizer["Commit edit"]"
              CancelEditTooltip="@Localizer["Cancel edit"]"
              IsEditRowSwitchingBlocked="true"
              EditTrigger="TableEditTrigger.EditButton"
              ApplyButtonPosition="TableApplyButtonPosition.Start"
              EditButtonPosition="TableEditButtonPosition.Start"
              RowEditPreview="@BackupVNet"
              RowEditCancel="@CancelVNetEdit"
              RowEditCommit="@CommitVNetEdit">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="@(new Func<VNet, object>(x => x.Id))">ID</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="@(new Func<VNet, object>(x => x.VNetName))">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>VNet Resource ID</MudTh>
            <MudTh>Subscription</MudTh>
            <MudTh>Subnets</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.VNetName</MudTd>
            <MudTd DataLabel="VNet Resource ID">
                <MudText Style="font-family:monospace; font-size:0.8rem; word-break:break-all">@context.VNetId</MudText>
            </MudTd>
            <MudTd DataLabel="Subscription">@GetSubscriptionLabel(context.SubscriptionId)</MudTd>
            <MudTd DataLabel="Subnets">
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Lan"
                           OnClick="@(() => SelectVNet(context))">
                    @context.Subnets.Count subnet(s)
                </MudButton>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@SidebarIcons.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteVNet(context))" />
            </MudTd>
        </RowTemplate>
        <RowEditingTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Name">
                <MudTextField @bind-Value="@context.VNetName" Required />
            </MudTd>
            <MudTd DataLabel="VNet Resource ID">
                <MudTextField @bind-Value="@context.VNetId" Required />
            </MudTd>
            <MudTd DataLabel="Subscription">@GetSubscriptionLabel(context.SubscriptionId)</MudTd>
            <MudTd />
            <MudTd />
        </RowEditingTemplate>
        <EditButtonContent Context="button">
            <MudIconButton Size="@Size.Small" Icon="@SidebarIcons.Edit" Class="pa-0"
                           OnClick="@button.ButtonAction" Disabled="@button.ButtonDisabled" />
        </EditButtonContent>
    </MudTable>

    @* ── Subnet section ── *@
    @if (_selectedVNet is not null)
    {
        <MudDivider Class="my-2" />
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h3">
                Subnets — <em>@_selectedVNet.VNetName</em>
            </MudText>
            <MudStack Row>
                <DHButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@SidebarIcons.Plus"
                          OnClick="@OpenUpdateRangeDialog">
                    Update range
                </DHButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Close subnets panel"
                               OnClick="@(() => _selectedVNet = null)" />
            </MudStack>
        </MudStack>

        <MudText>
            @if (_subnets.Count == 0)
            {
                @:No subnet groups yet. Use <strong>Update range</strong> to add the groups that exist in the VNet.
            }
            else
            {
                <strong>Groups @RangeStart–@RangeEnd</strong>
                @: · @CountWithStatus(SubnetGroupStatus.InUse) in use · @CountWithStatus(SubnetGroupStatus.Available) available · @CountWithStatus(SubnetGroupStatus.CoolingDown) cooling down
            }
        </MudText>

        <MudTable Items="_subnets"
                  T="Subnet"
                  Dense="true"
                  Hover="true"
                  Outlined="true"
                  SortLabel="@Localizer["Sort by"]">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="@(new Func<Subnet, object>(x => x.SubnetGroup))">Subnet Group</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => x.SubnetName))">Name</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => GetUsage(x).Status))">Status</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => GetUsage(x).WorkspaceAcronym ?? string.Empty))">Workspace</MudTableSortLabel>
                </MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var usage = GetUsage(context); }
                <MudTd DataLabel="Subnet Group">@context.SubnetGroup</MudTd>
                <MudTd DataLabel="Name">
                    <MudText Style="font-family:monospace; font-size:0.85rem">@context.SubnetName</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(usage.Status)" Variant="Variant.Outlined">
                        @GetStatusLabel(usage)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Workspace">@(usage.WorkspaceAcronym ?? "—")</MudTd>
                <MudTd DataLabel="Actions">
                    @if (usage.Status == SubnetGroupStatus.Available)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Link"
                                   OnClick="@(() => OpenAttachDialog(context))">
                            Attach
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.LinkOff"
                                   OnClick="@(() => OpenReleaseDialog(context))">
                            Release
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@* ── Attach subnet group dialog ── *@
<MudDialog @bind-Visible="_showAttach" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Attach subnet group @_groupForAction?.SubnetGroup</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>Record that a workspace uses this subnet group. It will no longer be assigned to new Protected B workspaces.</MudText>
            <MudTextField Label="Workspace acronym" @bind-Value="_attachAcronym" Immediate="true" />
            @if (_actionError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAttach = false)">Cancel</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary"
                  Disabled="@string.IsNullOrWhiteSpace(_attachAcronym)" OnClick="@SubmitAttach">
            Attach
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Release subnet group dialog ── *@
<MudDialog @bind-Visible="_showRelease" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Release subnet group @_groupForAction?.SubnetGroup</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_groupForAction is not null && GetUsage(_groupForAction) is { } releaseUsage)
            {
                @if (releaseUsage.Status == SubnetGroupStatus.InUse)
                {
                    <MudAlert Severity="Severity.Warning">
                        Workspace @releaseUsage.WorkspaceAcronym is not deleted and may still use these subnets.
                        Once released, the group can be assigned to a new Protected B workspace, whose deployment
                        will fail if the subnets are still in use.
                    </MudAlert>
                }
                else
                {
                    <MudText>
                        Workspace @releaseUsage.WorkspaceAcronym was deleted recently. Release the group only if its
                        resources have been removed from the subnets.
                    </MudText>
                }
            }
            <MudText>The group will be available to new Protected B workspaces straight away.</MudText>
            @if (_actionError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showRelease = false)">Cancel</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@SubmitRelease">
            Release
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Add VNet dialog ── *@
<MudDialog @bind-Visible="_showAddVNet" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Virtual Network</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_vnetForm" @bind-IsValid="_vnetFormValid">
            <MudStack Spacing="3">
                <MudSelect T="int" Label="Subscription" Required RequiredError="Subscription is required"
                           @bind-Value="_newVNet.SubscriptionId">
                    @foreach (var sub in _subscriptions)
                    {
                        <MudSelectItem Value="@sub.Id">@sub.Nickname (@sub.SubscriptionName)</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField Label="VNet Name" Required RequiredError="VNet name is required"
                              @bind-Value="_newVNet.VNetName" Placeholder="e.g. workspace-vnet" />
                <MudTextField Label="VNet Resource ID" Required RequiredError="VNet resource ID is required"
                              @bind-Value="_newVNet.VNetId"
                              Placeholder="e.g. /subscriptions/.../virtualNetworks/workspace-vnet" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAddVNet = false)">Cancel</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary"
                  Disabled="@(!_vnetFormValid)" OnClick="@SubmitAddVNet">
            Add VNet
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Update range dialog ── *@
<MudDialog @bind-Visible="_showUpdateRange" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Update the subnet group range</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Dense="true">
                Only include groups whose subnets exist in the VNet. Otherwise new Protected B workspaces get groups
                that don't exist and fail to deploy.
            </MudAlert>
            <MudText>
                @(_subnets.Count == 0 ? "There are no groups yet." : $"The range is currently groups {RangeStart}–{RangeEnd}.")
                Groups outside the new range are removed; groups in use or cooling down must be released first.
            </MudText>
            <MudStack Row>
                <MudNumericField T="int" Label="First group" @bind-Value="_rangeFirst" Min="1" />
                <MudNumericField T="int" Label="Last group" @bind-Value="_rangeLast" Min="1" />
            </MudStack>
            @if (_rangeError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_rangeError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showUpdateRange = false)">Cancel</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitUpdateRange">
            Update range
        </DHButton>
    </DialogActions>
</MudDialog>
