@using Datahub.Application.Services
@using Datahub.Application.Services.Subscriptions
@using Datahub.Core.Model.Subscriptions

@inject INetworkingManagementService _networkingService
@inject ISubnetPoolService _subnetPoolService
@inject IDatahubAzureSubscriptionService _subscriptionService
@inject ISnackbar _snackbar
@inject ILogger<NetworkingManagementPage> _logger

<MudStack Spacing="4">
    <MudText Typo="Typo.h2">@Localizer["Networking Management"]</MudText>
    <MudText>
        @Localizer["Manage Azure Virtual Networks (VNets) and their subnets. Each workspace is mapped to 8 subnets sharing the same subnet group number."]
    </MudText>

    @* ── VNet section ── *@
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h3">@Localizer["Virtual Networks"]</MudText>
        @* Only needed to set up an environment's VNet; a portal uses a single VNet. *@
        @if (_vnets.Count == 0)
        {
            <DHButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@SidebarIcons.Plus"
                      OnClick="@OpenAddVNetDialog">
                @Localizer["Add VNet"]
            </DHButton>
        }
    </MudStack>

    <MudTable Items="_vnets"
              T="VNet"
              Dense="true"
              Hover="true"
              Outlined="true"
              CanCancelEdit="true"
              SortLabel="@Localizer["Sort by"]"
              CommitEditTooltip="@Localizer["Commit edit"]"
              CancelEditTooltip="@Localizer["Cancel edit"]"
              IsEditRowSwitchingBlocked="true"
              EditTrigger="TableEditTrigger.EditButton"
              ApplyButtonPosition="TableApplyButtonPosition.Start"
              EditButtonPosition="TableEditButtonPosition.Start"
              RowEditPreview="@BackupVNet"
              RowEditCancel="@CancelVNetEdit"
              RowEditCommit="@CommitVNetEdit">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="@(new Func<VNet, object>(x => x.Id))">@Localizer["ID"]</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="@(new Func<VNet, object>(x => x.VNetName))">@Localizer["Name"]</MudTableSortLabel>
            </MudTh>
            <MudTh>@Localizer["VNet Resource ID"]</MudTh>
            <MudTh>@Localizer["Subscription"]</MudTh>
            <MudTh>@Localizer["Subnets"]</MudTh>
            <MudTh>@Localizer["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Localizer["ID"]">@context.Id</MudTd>
            <MudTd DataLabel="@Localizer["Name"]">@context.VNetName</MudTd>
            <MudTd DataLabel="@Localizer["VNet Resource ID"]">
                <MudText Style="font-family:monospace; font-size:0.8rem; word-break:break-all">@context.VNetId</MudText>
            </MudTd>
            <MudTd DataLabel="@Localizer["Subscription"]">@GetSubscriptionLabel(context.SubscriptionId)</MudTd>
            <MudTd DataLabel="@Localizer["Subnets"]">
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Lan"
                           OnClick="@(() => SelectVNet(context))">
                    @Localizer["{0} subnet(s)", context.Subnets.Count]
                </MudButton>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@SidebarIcons.Delete" Size="Size.Small" Color="Color.Error" aria-label="@Localizer["Delete VNet"]"
                               OnClick="@(() => DeleteVNet(context))" />
            </MudTd>
        </RowTemplate>
        <RowEditingTemplate>
            <MudTd DataLabel="@Localizer["ID"]">@context.Id</MudTd>
            <MudTd DataLabel="@Localizer["Name"]">
                <MudTextField @bind-Value="@context.VNetName" Required />
            </MudTd>
            <MudTd DataLabel="@Localizer["VNet Resource ID"]">
                <MudTextField @bind-Value="@context.VNetId" Required />
            </MudTd>
            <MudTd DataLabel="@Localizer["Subscription"]">@GetSubscriptionLabel(context.SubscriptionId)</MudTd>
            <MudTd />
            <MudTd />
        </RowEditingTemplate>
        <EditButtonContent Context="button">
            <MudIconButton Size="@Size.Small" Icon="@SidebarIcons.Edit" Class="pa-0"
                           OnClick="@button.ButtonAction" Disabled="@button.ButtonDisabled" />
        </EditButtonContent>
    </MudTable>

    @* ── Subnet section ── *@
    @if (_selectedVNet is not null)
    {
        <MudDivider Class="my-2" />
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h3">
                @Localizer["Subnets"] — <em>@_selectedVNet.VNetName</em>
            </MudText>
            <MudStack Row>
                <DHButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@SidebarIcons.Plus"
                          OnClick="@OpenUpdateRangeDialog">
                    @Localizer["Update range"]
                </DHButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@Localizer["Close subnets panel"]"
                               OnClick="@(() => _selectedVNet = null)" />
            </MudStack>
        </MudStack>

        <MudText>
            @if (_subnets.Count == 0)
            {
                @Localizer["No subnet groups yet. Use Update range to add the groups that exist in the VNet."]
            }
            else
            {
                <strong>@Localizer["Groups {0}–{1}", RangeStart, RangeEnd]</strong>
                @: · @Localizer["{0} in use", CountWithStatus(SubnetGroupStatus.InUse)] · @Localizer["{0} available", CountWithStatus(SubnetGroupStatus.Available)] · @Localizer["{0} cooling down", CountWithStatus(SubnetGroupStatus.CoolingDown)]
            }
        </MudText>

        <MudTable Items="_subnets"
                  T="Subnet"
                  Dense="true"
                  Hover="true"
                  Outlined="true"
                  SortLabel="@Localizer["Sort by"]">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="@(new Func<Subnet, object>(x => x.SubnetGroup))">@Localizer["Subnet Group"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => x.SubnetName))">@Localizer["Name"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => GetUsage(x).Status))">@Localizer["Status"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Subnet, object>(x => GetUsage(x).WorkspaceAcronym ?? string.Empty))">@Localizer["Workspace"]</MudTableSortLabel>
                </MudTh>
                <MudTh>@Localizer["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var usage = GetUsage(context); }
                <MudTd DataLabel="@Localizer["Subnet Group"]">@context.SubnetGroup</MudTd>
                <MudTd DataLabel="@Localizer["Name"]">
                    <MudText Style="font-family:monospace; font-size:0.85rem">@context.SubnetName</MudText>
                </MudTd>
                <MudTd DataLabel="@Localizer["Status"]">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(usage.Status)" Variant="Variant.Outlined">
                        @GetStatusLabel(usage)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@Localizer["Workspace"]">@(usage.WorkspaceAcronym ?? "—")</MudTd>
                <MudTd DataLabel="@Localizer["Actions"]">
                    @if (usage.Status == SubnetGroupStatus.Available)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Link"
                                   OnClick="@(() => OpenAttachDialog(context))">
                            @Localizer["Attach"]
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.LinkOff"
                                   OnClick="@(() => OpenReleaseDialog(context))">
                            @Localizer["Release"]
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@* ── Attach subnet group dialog ── *@
<MudDialog @bind-Visible="_showAttach" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["Attach subnet group {0}", _groupForAction?.SubnetGroup ?? 0]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>@Localizer["Record that a workspace uses this subnet group. It will no longer be assigned to new Protected B workspaces."]</MudText>
            <MudTextField Label="@Localizer["Workspace acronym"]" @bind-Value="_attachAcronym" Immediate="true" />
            @if (_actionError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAttach = false)">@Localizer["Cancel"]</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary"
                  Disabled="@string.IsNullOrWhiteSpace(_attachAcronym)" OnClick="@SubmitAttach">
            @Localizer["Attach"]
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Release subnet group dialog ── *@
<MudDialog @bind-Visible="_showRelease" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["Release subnet group {0}", _groupForAction?.SubnetGroup ?? 0]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_groupForAction is not null && GetUsage(_groupForAction) is { } releaseUsage)
            {
                @if (releaseUsage.Status == SubnetGroupStatus.InUse)
                {
                    <MudAlert Severity="Severity.Warning">
                        @Localizer["Workspace {0} is not deleted and may still use these subnets. Once released, the group can be assigned to a new Protected B workspace, whose deployment will fail if the subnets are still in use.", releaseUsage.WorkspaceAcronym ?? string.Empty]
                    </MudAlert>
                }
                else
                {
                    <MudText>
                        @Localizer["Workspace {0} was deleted recently. Release the group only if its resources have been removed from the subnets.", releaseUsage.WorkspaceAcronym ?? string.Empty]
                    </MudText>
                }
            }
            <MudText>@Localizer["The group will be available to new Protected B workspaces straight away."]</MudText>
            @if (_actionError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_actionError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showRelease = false)">@Localizer["Cancel"]</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@SubmitRelease">
            @Localizer["Release"]
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Add VNet dialog ── *@
<MudDialog @bind-Visible="_showAddVNet" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["Add Virtual Network"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_vnetForm" @bind-IsValid="_vnetFormValid">
            <MudStack Spacing="3">
                <MudSelect T="int" Label="@Localizer["Subscription"]" Required RequiredError="@Localizer["Subscription is required"]"
                           @bind-Value="_newVNet.SubscriptionId">
                    @foreach (var sub in _subscriptions)
                    {
                        <MudSelectItem Value="@sub.Id">@sub.Nickname (@sub.SubscriptionName)</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField Label="@Localizer["VNet Name"]" Required RequiredError="@Localizer["VNet name is required"]"
                              @bind-Value="_newVNet.VNetName" Placeholder="@Localizer["e.g. {0}", "workspace-vnet"]" />
                <MudTextField Label="@Localizer["VNet Resource ID"]" Required RequiredError="@Localizer["VNet resource ID is required"]"
                              @bind-Value="_newVNet.VNetId"
                              Placeholder="@Localizer["e.g. {0}", "/subscriptions/.../virtualNetworks/workspace-vnet"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAddVNet = false)">@Localizer["Cancel"]</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary"
                  Disabled="@(!_vnetFormValid)" OnClick="@SubmitAddVNet">
            @Localizer["Add VNet"]
        </DHButton>
    </DialogActions>
</MudDialog>

@* ── Update range dialog ── *@
<MudDialog @bind-Visible="_showUpdateRange" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["Update the subnet group range"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Dense="true">
                @Localizer["Only include groups whose subnets exist in the VNet. Otherwise new Protected B workspaces get groups that don't exist and fail to deploy."]
            </MudAlert>
            <MudText>
                @(_subnets.Count == 0 ? Localizer["There are no groups yet."] : Localizer["The range is currently groups {0}–{1}.", RangeStart, RangeEnd])
                @Localizer["Groups outside the new range are removed; groups in use or cooling down must be released first."]
            </MudText>
            <MudStack Row>
                <MudNumericField T="int" Label="@Localizer["First group"]" @bind-Value="_rangeFirst" Min="1" />
                <MudNumericField T="int" Label="@Localizer["Last group"]" @bind-Value="_rangeLast" Min="1" />
            </MudStack>
            @if (_rangeError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_rangeError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showUpdateRange = false)">@Localizer["Cancel"]</MudButton>
        <DHButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitUpdateRange">
            @Localizer["Update range"]
        </DHButton>
    </DialogActions>
</MudDialog>
