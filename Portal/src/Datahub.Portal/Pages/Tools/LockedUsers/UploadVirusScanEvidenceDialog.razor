@using Datahub.Core.Model.Users
@using Datahub.Core.Model.Projects
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject ISnackbar _snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.body1">
                @Localizer["Upload a screenshot of the virus scan report for workspace: {0}", WorkspaceName]
            </MudText>
            <MudAlert Severity="Severity.Info" Dense="true">
                @Localizer["The evidence will be reviewed by DataHub administrators. Once approved, the user will regain access to all workspaces."]
            </MudAlert>

            <MudFileUpload T="IBrowserFile" 
                          Accept=".png,.jpg,.jpeg,.pdf" 
                          FilesChanged="OnFileSelected"
                          MaximumFileCount="1">
                <ActivatorContent>
                    <DHButton Variant="Variant.Filled"
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.CloudUpload">
                        @Localizer["Select File"]
                    </DHButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (_selectedFile != null)
            {
                <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.AttachFile">
                    @_selectedFile.Name (@FormatFileSize(_selectedFile.Size))
                </MudChip>
            }

            @if (_uploadProgress > 0)
            {
                <MudProgressLinear Value="_uploadProgress" Color="Color.Primary" Size="Size.Medium"/>
                <MudText Typo="Typo.caption">@Localizer["Uploading... {0}%", _uploadProgress.ToString("F0")]</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <DHButton OnClick="Cancel" Variant="Variant.Text">@Localizer["Cancel"]</DHButton>
        <DHButton OnClick="Upload" 
                 Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 Disabled="@(_selectedFile == null || _uploading)">
            @Localizer["Upload"]
        </DHButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string WorkspaceAcronym { get; set; } = "";
    
    [Parameter] public string WorkspaceName { get; set; } = "";

    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private double _uploadProgress;

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        StateHasChanged();
    }

    private async Task Upload()
    {
        if (_selectedFile == null || string.IsNullOrEmpty(WorkspaceAcronym))
            return;

        _uploading = true;
        _uploadProgress = 0;
        StateHasChanged();

        try
        {
            // MOCK: Simulate upload progress (in production, would upload to Azure Blob Storage)
            for (int i = 0; i <= 100; i += 10)
            {
                _uploadProgress = i;
                StateHasChanged();
                await Task.Delay(100);
            }

            // MOCK: In production, would save URL to database
            // For demo, just show success message
            var mockUrl = $"mock://evidence/{WorkspaceAcronym}/{_selectedFile.Name}";

            _snackbar.Add(Localizer["Virus scan evidence uploaded successfully for {0} (DEMO).", WorkspaceAcronym], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _snackbar.Add(Localizer["Failed to upload evidence: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
