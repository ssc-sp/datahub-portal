@using Datahub.Core.Model.Users
@using Datahub.Infrastructure.Extensions
@using Datahub.Infrastructure.Queues.Messages
@using Datahub.Shared.Clients
@using Datahub.Shared.Configuration
@using MassTransit
@using Microsoft.JSInterop
@using Microsoft.TeamFoundation.WorkItemTracking.WebApi.Models
@implements IAsyncDisposable

@inject IUserSettingsService _userSettingsService
@inject IUserInformationService _userInformationService
@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject IDialogService DialogService
@inject NavigationManager _navigationManager
@inject IJSRuntime _jsRuntime
@inject ILocalStorageService _localStorage
@inject ISendEndpointProvider _sendEndpointProvider
@inject AzureDevOpsClient _azureDevOpsClient

@attribute [Route(PageRoutes.Help)]
@attribute [Route(PageRoutes.Help_FR)]
@attribute [Route(PageRoutes.HelpWithParam)]
@attribute [Route(PageRoutes.HelpWithParam_FR)]
@attribute [ExternalUserPage]

<PageTitle>
    @Localizer["Help - {0}", Localizer["MainTitle"]]
</PageTitle>

<DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.Authenticated">
    <MudStack Spacing="6">
        <DHMainContentTitle Title="@Localizer["Support"]" />
        <ul class="help-card-row" style="display: flex; align-items: flex-start; gap: 25px; flex-wrap: wrap">
            <li class="d-flex flex-1">
                <SupportRequestForm Workspaces="@_ticketWorkspaces" OnSubmit="SubmitFormAsync" />
            </li>
            <li class="d-flex flex-1">
                <DocsCardContent />
            </li>
        </ul>
        <MudDivider />
        <MudText Typo="Typo.h2">@Localizer["Your Support Requests"]</MudText>
        <MudText Typo="Typo.body1">@Localizer["These are your previously submitted support requests. Requests may take up to 15 minutes to appear here."]</MudText>
        <MudTable Items="@_issues" Loading="@_loading" Hover Dense>
            <HeaderContent>
                <MudTh>@Localizer["ID"]</MudTh>
                <MudTh>@Localizer["Title"]</MudTh>
                <MudTh>@Localizer["Description"]</MudTh>
                <MudTh>@Localizer["Status"]</MudTh>
                <MudTh>@Localizer["Submitted_DT"]</MudTh>
                <MudTh>@Localizer["Last Update"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>
                    <MudChip Class="dh_themed_chip" T="string" Color="@GetColor(context.State)">
                        @Localizer[context.Message]
                    </MudChip>
                </MudTd>
                <MudTd>@context.SubmittedDate</MudTd>
                <MudTd>@context.ChangedDate</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@Localizer["Rows per page:"]"
                               InfoFormat="@("{first_item}-{last_item} " + Localizer["of"] + " {all_items}")" />
            </PagerContent>
        </MudTable>
    </MudStack>
</DatahubAuthView>

@code {
    [Parameter]
    public string? CorrelationId { get; set; }

    private PortalUser _viewedUser = null!;
    private string _ticketName = string.Empty;
    private string _ticketEmail = string.Empty;
    private string _ticketPortalLanguage = string.Empty;
    private string _ticketOrg = string.Empty;
    private IJSObjectReference? _module;
    private List<IssueForDisplaying> _issues = [];
    private readonly List<string> _ticketWorkspaces = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _viewedUser = await _userInformationService.GetCurrentPortalUserAsync();
        _ticketName = _viewedUser.DisplayName;
        _ticketEmail = _viewedUser.Email;
        _ticketOrg = GetOrg(_ticketEmail);
        _issues = await GetIssuesCreatedByUser(_ticketName);
        _ticketPortalLanguage = await _userSettingsService.GetUserLanguage();

        await using var dbContext = await _dbContextFactory.CreateDbContextAsync();
        var userRoles = await dbContext.UserRolesLinks
            .Include(userRole => userRole.Role)
            .Include(userRole => userRole.Project)
            .ThenInclude(project => project.UserRoles)
            .Include(userRole => userRole.PortalUser)
            .Where(userRole => userRole.PortalUser == _viewedUser)
            .ToListAsync();

        foreach (var project in userRoles.Select(userRole => userRole.Project).Where(project => !project.IsDeleted))
        {
            if (!_ticketWorkspaces.Contains(project.Project_Name, StringComparer.Ordinal))
            {
                _ticketWorkspaces.Add(project.Project_Name);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await _jsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/Help/HelpPage.razor.js");
        }
        catch (Exception)
        {
            _module = await _jsRuntime.InvokeAsync<IJSObjectReference>("import",
                "./_content/Datahub.Portal/Pages/Help/HelpPage.razor.js");
        }
    }

    private async Task SubmitFormAsync(SupportRequestFormData request)
    {
        var description = string.IsNullOrWhiteSpace(CorrelationId)
            ? request.Description
            : $"{request.Description} \n\n cid: {CorrelationId}";

        var url = _navigationManager.Uri;
        var userAgent = await _module!.InvokeAsync<string>("retrieveUserAgent");
        var resolution = await _module.InvokeAsync<string>("retrieveResolution");
        var timezone = await _module.InvokeAsync<string>("retrieveTimeZone");

        var localStorageData = new Dictionary<string, string?>();
        foreach (var key in await _localStorage.KeysAsync())
        {
            localStorageData.Add(key, await _localStorage.GetItemAsStringAsync(key));
        }

        var bugReport = new BugReportMessage(
            UserName: _ticketName,
            UserEmail: _ticketEmail,
            UserOrganization: _ticketOrg,
            PortalLanguage: _ticketPortalLanguage,
            PreferredLanguage: request.PreferredLanguage,
            Timezone: timezone,
            Workspaces: request.Workspaces.Count > 0 ? string.Join(", ", request.Workspaces) : "N/A",
            Topics: request.Topics.Count > 0 ? string.Join("; ", request.Topics) : "Issue",
            URL: url,
            UserAgent: userAgent,
            Resolution: resolution,
            LocalStorage: Newtonsoft.Json.JsonConvert.SerializeObject(localStorageData),
            BugReportType: BugReportTypes.SupportRequest,
            Description: description);

        await _sendEndpointProvider.SendDatahubServiceBusMessage(QueueConstants.BugReportQueueName, bugReport);
        await DialogService.ShowMessageBoxAsync(
            Localizer["Success"],
            Localizer["Your support ticket has been created. Thank you!"],
            yesText: "OK");
    }

    private static string GetOrg(string email)
    {
        try
        {
            var domain = email.Split('@')[1];
            return domain == domain.Split(".gc.ca")[0]
                ? "external"
                : domain.Split(".gc.ca")[0];
        }
        catch
        {
            return "unknown";
        }
    }

    public async Task<List<IssueForDisplaying>> GetIssuesCreatedByUser(string userName)
    {
        var issues = new List<IssueForDisplaying>();
        var query = $"SELECT [System.Id], [System.Title], [System.CreatedBy], [System.CreatedDate], [System.ChangedDate], [System.Tags] FROM WorkItems WHERE [Submitted By] = '{userName}' AND NOT [System.Title] CONTAINS 'xception'";
        var client = await _azureDevOpsClient.WorkItemClientAsync();
        var result = await client.QueryByWiqlAsync(new Wiql { Query = query }).ConfigureAwait(false);
        var ids = result.WorkItems.Select(item => item.Id).ToArray();

        for (var index = 0; index < ids.Length; index += 150)
        {
            var workItems = await client.GetWorkItemsAsync(ids.Skip(index).Take(150).ToArray()).ConfigureAwait(false);
            issues.AddRange(workItems.Select(workItem => new IssueForDisplaying(workItem, true)));
        }

        _loading = false;
        issues.Reverse();
        return issues;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Can occur during Blazor circuit teardown.
        }
    }

    private static Color GetColor(string status)
    {
        return status switch
        {
            "Closed" => Color.Success,
            "Waiting" => Color.Warning,
            _ => Color.Default
        };
    }
}
