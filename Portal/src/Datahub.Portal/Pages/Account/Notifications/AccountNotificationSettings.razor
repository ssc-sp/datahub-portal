@using Datahub.Application.Services.UserManagement
@using Datahub.Core.Model.Achievements
@using Datahub.Core.Model.Users
@using Datahub.Portal.Components.User
@using GcdsWrapper.Blazor

@inject IUserInformationService _userInformationService
@inject DatahubPortalConfiguration _datahubPortalConfiguration

<DatahubAuthView AuthLevel=DatahubAuthView.AuthLevels.UserUID UserUID=@ViewedUser.UserUID()>
    
    <Authorized>
        @* TODO: External users will not receive email notifications *@
        <MudStack Spacing="8" Class="mb-16">
            <MudStack>
                <DHMainContentTitle Title="@Localizer["Email Notifications"]" />
                <MudDivider/>
            </MudStack>
            <SettingsField Label="@Localizer["Email preferences"]" Description="@Localizer["Choose your preferred frequency of communications from the DataHub team"]">
                <GcdsRadios Name="email-preferences" Legend="@Localizer["Email preferences"]" Options="@EmailPreferenceOptions" Value="@EmailPreferenceValue" ValueExpression="@(() => EmailPreferenceValue)" Disabled />
            </SettingsField>

        </MudStack>

    </Authorized>

    <NotAuthorized>
        <UserViewProfileIconButton ViewedUserGraphId=@ViewedUser.UserUID() />
    </NotAuthorized>

</DatahubAuthView>


@code {

    [Parameter]
    public PortalUser ViewedUser { get; set; }

    [Parameter]
    public EventCallback<PortalUser> OnViewedUserChanged { get; set; }

    private string EmailPreferenceValue => "all";

    private IReadOnlyCollection<GcdsRadioOption> EmailPreferenceOptions =>
    [
        new("email-preferences-all", Localizer["I want to receive all notifications"], "all"),
        new("email-preferences-important", Localizer["I want to receive only important notifications"], "important"),
        new("email-preferences-critical", Localizer["I want to receive only critical notifications"], "critical")
    ];

}
