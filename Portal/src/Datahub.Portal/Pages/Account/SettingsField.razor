@using GcdsWrapper.Blazor
<MudStack>
    <GcdsText>
        <strong>
            @Label
        </strong>
    </GcdsText>
    <GcdsText>
        @Description
    </GcdsText>
    <MudElement>
        @ChildContent
    </MudElement>
</MudStack>

@code {

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public string Description { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

}
