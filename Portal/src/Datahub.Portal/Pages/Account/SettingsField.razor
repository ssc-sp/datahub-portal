@using GcdsWrapper.Blazor
<MudStack>
    <GcdsText MarginBottom="0">
        <strong>
            @Label
        </strong>
    </GcdsText>
    <GcdsText MarginBottom="0" MarginTop="0">
        @Description
    </GcdsText>
    <MudElement>
        @ChildContent
    </MudElement>
</MudStack>

@code {

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public string Description { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

}
