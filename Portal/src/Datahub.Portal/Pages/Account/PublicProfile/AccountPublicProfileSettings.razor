@using Datahub.Application.Services.UserManagement
@using Datahub.Core.Model.Achievements
@using Datahub.Core.Model.Users
@using Datahub.Portal.Components.User
@using GcdsWrapper.Blazor

@inject DatahubPortalConfiguration _datahubPortalConfiguration
@inject IDialogService _dialogService
@inject IUserSettingsService _userSettingsService

<DatahubAuthView AuthLevel=DatahubAuthView.AuthLevels.UserUID UserUID=@ViewedUser.UserUID()>

    <Authorized>
        <MudStack Spacing="8" Class="mb-16">
@*             <MudStack>
                <DHMainContentTitle Title="@Localizer["Public profile"]"/>
                <MudDivider/>
            </MudStack> *@
            <SettingsField Label="@Localizer["Display Name"]" Description="@Localizer["Your display name will be shown around DataHub as your username."]">
                <GcdsInput Id="profile-display-name" Name="profile-display-name" Disabled Value="@ViewedUser.DisplayName" ValueExpression="@(() => ViewedUser.DisplayName)" Label="@Localizer["Display name"]" />
            </SettingsField>
            <SettingsField Label="@Localizer["Email Address"]" Description="@Localizer["Your email address will be used to send you notifications."]">
                <GcdsInput Id="profile-email" Name="profile-email" Disabled Value="@ViewedUser.Email" ValueExpression="@(() => ViewedUser.Email)" Label="@Localizer["Email"]" />
            </SettingsField>
            <SettingsField Label="@Localizer["Profile Picture"]" Description="@Localizer["Your profile picture will be displayed beside your name around DataHub. You can it at any time and unlock more variations from completing achievements."]">
                <ImageSelectionView
                    ViewedUser="@ViewedUser"
                    IsProfilePictureDialog="@true"
                    OnImageSelected="@(code => HandleImageSelected(code, true))"/>
            </SettingsField>
            <SettingsField Label="@Localizer["Profile Background"]" Description="@Localizer["Your profile background will be displayed on your profile page. You can unlock more variations from completing achievements and change it at any time."]">
                <ImageSelectionView
                    ViewedUser="@ViewedUser"
                    IsProfilePictureDialog="@false"
                    OnImageSelected="@(code => HandleImageSelected(code, false))"/>
            </SettingsField>
            @* <MudDivider/> *@
            <SettingsField Label="@Localizer["Display Achievements"]" Description="@Localizer["Choose whether to hide or display your achievements in DataHub. This will also prevent the achievement notifications from displaying on your screen."]">
                <GcdsCheckboxes Name="show-achievements" Legend="@Localizer["Show Achievements"]" Options="@ShowAchievementsOptions" Value="@ShowAchievementsValue" ValueChanged="HandleShowAchievementsChanged" ValueExpression="@(() => ShowAchievementsValue)" />
            </SettingsField>
            <SettingsField Label="@Localizer["Display page alerts and tutorials"]" Description="@Localizer["Choose whether to hide or display alert and tutorial dialogs in Datahub."]">
                <GcdsCheckboxes Name="show-alerts" Legend="@Localizer["Show alerts and tutorials"]" Options="@ShowAlertsOptions" Value="@ShowAlertsValue" ValueChanged="HandleShowAlertsChanged" ValueExpression="@(() => ShowAlertsValue)" />
                <GcdsButton Type="GcdsButtonType.Button" OnClick="ClearAlerts">@Localizer["Reset alert settings"]</GcdsButton>
            </SettingsField>
        </MudStack>
    </Authorized>

    <NotAuthorized>
        <UserViewProfileIconButton ViewedUser=@ViewedUser />
    </NotAuthorized>

</DatahubAuthView>


@code {

    [Parameter] public PortalUser ViewedUser { get; set; }

    [Parameter] public EventCallback<PortalUser> OnViewedUserChanged { get; set; }

    private async Task HandleImageSelected(string code, bool isProfilePicture)
    {
        ViewedUser.ProfilePictureUrl = isProfilePicture ? code : ViewedUser.ProfilePictureUrl;
        ViewedUser.BannerPictureUrl = isProfilePicture ? ViewedUser.BannerPictureUrl : code;

        await OnViewedUserChanged.InvokeAsync(ViewedUser);
    }

    private IReadOnlyCollection<GcdsCheckboxOption> ShowAchievementsOptions =>
        [new("show-achievements-option", Localizer["Show Achievements"], "show")];

    private string[] ShowAchievementsValue => ViewedUser.UserSettings.HideAchievements ? [] : ["show"];

    private IReadOnlyCollection<GcdsCheckboxOption> ShowAlertsOptions =>
        [new("show-alerts-option", Localizer["Show alerts and tutorials"], "show")];

    private string[] ShowAlertsValue => ViewedUser.UserSettings.HideAlerts ? [] : ["show"];

    private async Task HandleShowAchievementsChanged(string[]? values)
    {
        ViewedUser.UserSettings.HideAchievements = values?.Contains("show") != true;
        await OnViewedUserChanged.InvokeAsync(ViewedUser);
    }

    private async Task HandleShowAlertsChanged(string[]? values)
    {
        ViewedUser.UserSettings.HideAlerts = values?.Contains("show") != true;
        await OnViewedUserChanged.InvokeAsync(ViewedUser);
    }

    private async Task ClearAlerts()
    {
        ViewedUser.UserSettings.HiddenAlerts = null;
        await OnViewedUserChanged.InvokeAsync(ViewedUser);
    }

}
