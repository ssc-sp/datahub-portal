@using Datahub.Application.Services
@using Datahub.Portal.Components
@using Datahub.Portal.Pages.Workspace
@using static Datahub.Core.DevTools
@inject IWorkspaceCreationService _projectCreationService
@inject NavigationManager _navigationManager
@inject DatahubPortalConfiguration _portalConfiguration

@attribute [Route(PageRoutes.CreateWorkspace)]
@attribute [Route(PageRoutes.CreateWorkspace_FR)]

<PageTitle>@Localizer["Create a Workspace - Federal Science DataHub"]</PageTitle>

<DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.Authenticated">
    <FSDHEnvironment Environments="@_environmentsToAllowCreation">
        <CreateWorkspaceForm />
    </FSDHEnvironment>
    <FSDHEnvironment Environments="@_environmentsToShowDisabledMessage">
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
            @Localizer["Workspace creation is disabled in this environment. Please contact FSDH support to create a workspace."]
        </MudAlert>
        <DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.DatahubSupport" ElevatedWorkspaceAccessEnabled="true">
            <CreateWorkspaceForm />
        </DatahubAuthView>
    </FSDHEnvironment>
</DatahubAuthView>

@code {
    private List<TopBarEnvironments> _environmentsToShowDisabledMessage = new List<TopBarEnvironments> { TopBarEnvironments.Development, TopBarEnvironments.Production, TopBarEnvironments.ProductionProtected };
    private List<TopBarEnvironments> _environmentsToAllowCreation = new List<TopBarEnvironments> { TopBarEnvironments.Development, TopBarEnvironments.Integration, TopBarEnvironments.ProofOfConcept, TopBarEnvironments.QualityControl };
}
