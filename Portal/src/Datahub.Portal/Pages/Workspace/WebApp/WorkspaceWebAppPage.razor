@using Datahub.Application.Services.ReverseProxy
@using Datahub.Portal.Pages.Account
@using Datahub.Shared.Entities
@using Datahub.Shared.Entities.WorkspaceToolConfiguration
@using Microsoft.Identity.Web
@using Datahub.Core.Model.Projects
@using Datahub.Application.Services.WebApp
@using GcdsWrapper.Blazor

@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject IKeyVaultUserService _keyVaultUserService
@inject ISnackbar _snackbar
@inject ILogger<WorkspaceWebAppPage> _logger
@inject MicrosoftIdentityConsentAndConditionalAccessHandler _consentHandler
@inject IWorkspaceWebAppManagementService _webAppMgmtService
@inject IReverseProxyManagerService ReverseProxyManagerService

@if (!_isElevated)
{
    <DHLoadingInitializer Message="@Localizer["Validating your credentials..."]"/>
    return;
}
<MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <DHMainContentTitle Title="@Localizer["Web application"]"/>
        @if (_isConfigured)
        {
            <MudStack AlignItems="AlignItems.End" Justify="Justify.Center">
                <DHIcon Icon="@SidebarIcons.Circle" Color="@(_webAppState ? Color.Success : Color.Error)"
                        Title="@(_webAppState ? Localizer["Running"] : Localizer["Stopped"])"/>
            </MudStack>
        }
        <MudSpacer/>
        @if (_isProvisioned)
        {
            @if (_isConfigured)
            {
                @if (!_webAppState)
                {
                    <DHButton HtmlTag="button" Disabled="@_isStartStopping" Variant="Variant.Filled"
                              StartIcon="@SidebarIcons.Start"
                              IconColor="@Color.Success" Size="Size.Small"
                              OnClick="@(async () => { await ExecuteAsyncWithStateChangeDelay(_webAppMgmtService.Start, _webAppId, 2000); })">
                        @if (_isStartStopping)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small"/>
                        }
                        else
                        {
                            @Localizer["Start"]
                        }
                    </DHButton>
                }
                else
                {
                    <DHButton HtmlTag="button" Disabled="@_isStartStopping" Variant="Variant.Filled"
                              StartIcon="@SidebarIcons.Stop"
                              IconColor="@Color.Error" Size="Size.Small"
                              OnClick="@(async () => { await ExecuteAsyncWithStateChangeDelay(_webAppMgmtService.Stop, _webAppId, 2000); })">
                        @if (_isStartStopping)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small"/>
                        }
                        else
                        {
                            @Localizer["Stop"]
                        }
                    </DHButton>
                }

                <DHButton HtmlTag="button" Disabled="@(_isRestarting || !_webAppState)" Variant="Variant.Filled"
                          StartIcon="@SidebarIcons.Restart" Size="Size.Small"
                          OnClick="@(async () => { await ExecuteAsyncWithStateChangeDelay(_webAppMgmtService.Restart, _webAppId, 2000); })">
                    @if (_isRestarting)
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small"/>
                    }
                    else
                    {
                        @Localizer["Restart"]
                    }
                </DHButton>

                <DHButton HtmlTag="button" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                          StartIcon="@SidebarIcons.Redeploy" OnClick="@(async () => await RedeployWebApp())">
                    @if (_isRedeploying)
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small"/>
                    }
                    else
                    {
                        @Localizer["Redeploy"]
                    }
                </DHButton>
            }

            <DHButton @ref="_configureButton" HtmlTag="button" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled"
                      StartIcon="@SidebarIcons.Gear"
                      Disabled="@(_isLoadingConfiguration || _showConfigurationForm)"
                      aria-expanded="@(_showConfigurationForm ? "true" : "false")"
                      aria-controls="web-app-configuration-form"
                      OnClick="ShowWebAppConfigurationAsync">
                @Localizer["Configure"]
            </DHButton>
        }
    </MudStack>

    @if (_showConfigurationForm && _configurationToEdit is not null)
    {
        <WebAppConfigurationForm Configuration="@_configurationToEdit"
                                 OnSubmit="HandleConfigurationSubmittedAsync"
                                 OnCancelled="HideConfigurationFormAsync" />
    }

    <GcdsText>
        @Localizer["On this page, you can manage your web application. You can view and edit the configurations of your web application"]
    </GcdsText>

    @if (_isProvisioned && _isConfigured)
    {
        <GcdsNotice NoticeRole="info" NoticeTitle="@Localizer["Note"]" NoticeTitleTag="h2">
            <GcdsText>@Localizer["Restart your application using the 'Restart' button to apply changes to your images or environment variables."]</GcdsText>
            <GcdsText>@Localizer["Redeploy your application using the 'Redeploy' button to apply changes to your docker-compose file."]</GcdsText>
        </GcdsNotice>
        <GcdsHeading Tag="h2">@Localizer["Quick settings"]</GcdsHeading>
        <MudPaper Class="pa-4">
            <SettingsField Label=@Localizer["URL rewriting"]
                           Description="@Localizer["The {0} proxy rewrites URL paths which is supported by most web applications who do not configure the base href. However some frameworks (such as python dash) do configure a base url. For these frameworks, the URL rewrite option should be disabled and the proxied URL should be configured inside the application as base url.", Localizer["MainAcronym"]]">
                <MudSwitch
                    T=@bool
                    Value=@_isUrlRewritingEnabled
                    Color=@Color.Primary
                    Label=@Localizer["Enable URL rewriting"]
                    ValueChanged=@HandleToggleUrlRewriting
                    Disabled=@_isSaving/>
            </SettingsField>
        </MudPaper>
        <GcdsText>
            <em>@Localizer["Quick settings are applied immediately. No need to restart your web application."]</em>
        </GcdsText>
        
        <WorkspaceWebAppInfoTable
            @ref=@_webappInfoTable
            WebAppHost="@_webAppHost"
            Framework="@_webAppFramework"
            GitRepo="@_webAppRepo"
            ComposePath="@_webAppCompose"
            WorkspaceAcronym="@WorkspaceAcronym"/>
    }
    else if (_isProvisioned)
    {
        <GcdsText>
            @Localizer["This web application is not configured yet. Please configure it by clicking the 'Configure' button at the top right of the page."]
        </GcdsText>
    }
    else
    {
        <GcdsText>
            @Localizer["This web application is not provisioned yet. Please come back soon."]
        </GcdsText>
    }
    @if (_resource is not null && _isConfigured)
    {
        <EnvironmentVariablesTable resource="@_resource" projectAcronym="@WorkspaceAcronym" isEditable="true"
                                   @ref="@_envVarTable"/>
    }
    @if (_isConfigured)
    {
        <GcdsHeading Tag="h2">@Localizer["Web application logs"]</GcdsHeading>
        <MudPaper Class="py-4" Elevation="1">
            <MudStack Row Class="px-4" AlignItems="AlignItems.Center">
                <GcdsHeading Tag="h3">
                    @Localizer["Runtime logs"]
                </GcdsHeading>
                <MudSpacer/>
                <DHButton HtmlTag="Button" OnClick="ToggleLogs" IconSize="Size.Large" Variant="Variant.Filled"
                          EndIcon="@(_showLogs ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)">@(_showLogs ? Localizer["Hide"] : Localizer["View"])</DHButton>
            </MudStack>
            <MudCollapse @bind-Expanded="@_showLogs">
                <iframe id="logStreamIframe" src="@($"/api/healthcheck/webapplogstream?ws={WorkspaceAcronym}")"
                        style="height: 500px;">
                    <!-- Fallback content for browsers that do not support iframes -->
                    Your browser does not support iframes.
                </iframe>
            </MudCollapse>
        </MudPaper>
        <GcdsText>
            <em>@Localizer["Please note that the logs are only available when the web application is running. Logs may be delayed by a few minutes."]</em>
        </GcdsText>
    }
    @if (_isProvisioned)
    {
        <GcdsHeading Tag="h2">@Localizer["Additional information"]</GcdsHeading>
        <GcdsNotice NoticeRole="warning" NoticeTitle="@Localizer["Warning"]" NoticeTitleTag="h2">
            <GcdsText>@Localizer["Please read the following information before configuring your web application to avoid any issues."]</GcdsText>
        </GcdsNotice>
        <GcdsText>
            @Localizer["Web applications in {0} are deployed and hosted using the ", Localizer["MainAcronym"]]
            <GcdsLink Href="https://azure.microsoft.com/en-ca/products/app-service">@Localizer["Azure App Service. "]</GcdsLink>
            @Localizer["For this reason, there are certain limitations you must follow in order to successfully deploy your web application."]
        </GcdsText>
        <GcdsText>
            @Localizer["Limitations to docker compose:"]
        </GcdsText>
        <GcdsText>
            @Localizer["The following are supported and unsupported docker compose configuration options as per "]
            <GcdsLink
                Href="https://learn.microsoft.com/en-us/azure/app-service/configure-custom-container?tabs=debian&pivots=container-linux#configure-multi-container-apps">
                @Localizer["Microsoft's documentation on multi-container web apps. "]
            </GcdsLink>
        </GcdsText>
        <GcdsText>
            @Localizer["Supported options:"]
        </GcdsText>
        <GcdsText>
            <ul class="ml-4">
                <li style="display: list-item; list-style-type: circle">
                    <code>command</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>entrypoint</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>environment</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>image</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>ports</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>restart</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>services</code>
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>volumes</code>, @Localizer["please contact us to set-up volumes as they require more configuration."]
                </li>
            </ul>
        </GcdsText>
        <GcdsText>
            @Localizer["Unsupported options:"]
        </GcdsText>
        <GcdsText>
            <ul class="ml-4">
                <li style="display: list-item; list-style-type: circle">
                    <code>build</code> @Localizer[", not allowed without "] <code>image</code>.
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>depends_on</code> @Localizer[", will be ignored."]
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>networks</code> @Localizer[", will be ignored."]
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>secrets</code>@Localizer[", will be ignored."]
                </li>
                <li style="display: list-item; list-style-type: circle">
                    <code>ports</code>@Localizer[" other than 80 and 8080 will be ignored."]
                </li>
            </ul>
        </GcdsText>
        <GcdsHeading Tag="h4">@Localizer["Syntax limitations:"]</GcdsHeading>
        <GcdsText>
            <ul class="ml-4">
                <li style="display: list-item; list-style-type: circle">
                    <code>version: "X"</code>@Localizer[" must always be the first YAML statement in the file."]
                </li>
                <li style="display: list-item; list-style-type: circle">@Localizer["ports section in the YAML must use quoted numbers."]</li>
                <li style="display: list-item; list-style-type: circle">@Localizer["image > volume section in the YAML must be quoted and cannot have permissions definitions."]</li>
                <li style="display: list-item; list-style-type: circle">@Localizer["volumes section must not have an empty curly brace after the volume name."]</li>
            </ul>
        </GcdsText>
        <GcdsHeading Tag="h3">@Localizer["Limitations to images:"]</GcdsHeading>
        <GcdsText>
            @Localizer["We currently only support public images, i.e. images that are available on Docker Hub or other public repositories. In order to deploy private images, please fill a support request."]
        </GcdsText>
    }
</MudStack>


@code {

    [Parameter, EditorRequired] public string WorkspaceAcronym { get; set; }
    [Parameter] public bool ElevatedWorkspaceAccessEnabled { get; set; } = false;

    private string _webAppHost = "<web_app_host>";
    private string _webAppId = "<web_app_id>";
    private string _webAppFramework = "<framework>";
    private string _webAppRepo = "<git_repo>";
    private string _webAppCompose = "<path_to_compose>";

    private AppServiceConfiguration _appConfiguration;
    private Project_Resources2 _resource;
    private EnvironmentVariablesTable _envVarTable;

    private bool _isUrlRewritingEnabled;
    private WorkspaceWebAppInfoTable _webappInfoTable;

    private bool _isConfigured;
    private bool _isProvisioned;
    private bool _isElevated;
    private bool _webAppState;
    private bool _isStartStopping;
    private bool _isRestarting;
    private bool _isSaving;
    private bool _isRedeploying;
    private bool _showLogs;
    private bool _showConfigurationForm;
    private bool _isLoadingConfiguration;
    private bool _isSubmittingConfiguration;
    private bool _focusConfigureButton;
    private AppServiceConfiguration? _configurationToEdit;
    private DHButton? _configureButton;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            await _keyVaultUserService.AuthenticateWithUserContext();
            _isElevated = true;
        }
        catch (MicrosoftIdentityWebChallengeUserException e)
        {
            _consentHandler.HandleException(e);
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Failed to get consent from user");
        }

        _resource = await _webAppMgmtService.GetResource(WorkspaceAcronym);
        await HydrateValues();
        _webAppState = await _webAppMgmtService.GetState(_webAppId);
        StateHasChanged();
    }

    private void ToggleLogs()
    {
        _showLogs = !_showLogs;
    }

    private async Task HandleToggleUrlRewriting(bool value)
    {
        _isSaving = true;
        var oldValue = _isUrlRewritingEnabled;
        _isUrlRewritingEnabled = value;
        using var ctx = await _dbContextFactory.CreateDbContextAsync();
        var workspace = await ctx.Projects.FirstOrDefaultAsync(x => x.Project_Acronym_CD == WorkspaceAcronym);
        if (workspace != null)
        {
            workspace.WebAppUrlRewritingEnabled = value;
            await ctx.SaveChangesAsync();
            _snackbar.Add(Localizer["URL Rewriting setting updated"], Severity.Success);
            if (_webappInfoTable != null)
            {
                _webappInfoTable.RefreshUrl();
            }
        }
        else
        {
            _isUrlRewritingEnabled = oldValue;
            _snackbar.Add(Localizer["Could not update URL Rewriting setting"], Severity.Error);
        }

        ReverseProxyManagerService.ReloadConfiguration();
        _isSaving = false;
    }

    private async Task HydrateValues()
    {
        using var ctx = await _dbContextFactory.CreateDbContextAsync();
        var workspace = await ctx.Projects
            .Include(x => x.Resources)
            .FirstOrDefaultAsync(x => x.Project_Acronym_CD == WorkspaceAcronym);
        _appConfiguration = TerraformVariableExtraction.ExtractAppServiceConfiguration(workspace);
        _isUrlRewritingEnabled = workspace.WebAppUrlRewritingEnabled;

        if (_appConfiguration != null)
        {
            _webAppHost = _appConfiguration.HostName;
            _webAppId = _appConfiguration.Id;

            _isProvisioned = !(string.IsNullOrWhiteSpace(_webAppHost) && string.IsNullOrWhiteSpace(_webAppId));
            _isConfigured = !(string.IsNullOrWhiteSpace(_appConfiguration.Framework) && string.IsNullOrWhiteSpace(_appConfiguration.GitRepo) && string.IsNullOrWhiteSpace(_appConfiguration.ComposePath));

            if (_isConfigured)
            {
                _webAppFramework = _appConfiguration.Framework;
                _webAppRepo = _appConfiguration.GitRepo;
                _webAppCompose = _appConfiguration.ComposePath;
            }
        }
    }

    private async Task ExecuteAsyncWithStateChangeDelay(Func<string, Task<bool>> action, string webAppId, int delay)
    {
        if (action.Method.Name == "Start" || action.Method.Name == "Stop")
        {
            _isStartStopping = true;
        }
        else if (action.Method.Name == "Restart")
        {
            _isRestarting = true;
        }

        StateHasChanged();
        switch (action.Method.Name)
        {
            case "Start":
                await _webAppMgmtService.Start(webAppId, WorkspaceAcronym);
                _envVarTable.needsRestart = false;
                break;
            case "Restart":
                await _webAppMgmtService.Restart(webAppId, WorkspaceAcronym);
                _envVarTable.needsRestart = false;
                break;
            default:
                await action.Invoke(webAppId);
                break;
        }

        await Task.Delay(delay);
        _webAppState = await _webAppMgmtService.GetState(_webAppId);
        _isStartStopping = false;
        _isRestarting = false;
        StateHasChanged();
    }

    private async Task RedeployWebApp()
    {
        _isRedeploying = true;
        StateHasChanged();
        await Task.Delay(1000);
        await ConfigureWebApp(_appConfiguration);
        _isRedeploying = false;
        StateHasChanged();
    }

    private async Task ShowWebAppConfigurationAsync()
    {
        if (_isLoadingConfiguration || _showConfigurationForm || _appConfiguration is null)
        {
            return;
        }

        _isLoadingConfiguration = true;
        try
        {
            _configurationToEdit = (AppServiceConfiguration)_appConfiguration.Clone();
            if (_configurationToEdit.IsGitRepoPrivate)
            {
                _configurationToEdit.GitToken = await _keyVaultUserService.GetSecretAsync(
                    WorkspaceAcronym,
                    _configurationToEdit.GitTokenSecretName);
            }

            _showConfigurationForm = true;
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Failed to load web app configuration");
            _snackbar.Add(Localizer["Web application configuration failed"], Severity.Error);
        }
        finally
        {
            _isLoadingConfiguration = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleConfigurationSubmittedAsync(AppServiceConfiguration configuration)
    {
        if (_isSubmittingConfiguration)
        {
            return;
        }

        _isSubmittingConfiguration = true;
        try
        {
            await ConfigureWebApp(configuration);
            await HideConfigurationFormAsync();
        }
        finally
        {
            _isSubmittingConfiguration = false;
        }
    }

    private async Task HideConfigurationFormAsync()
    {
        _showConfigurationForm = false;
        _configurationToEdit = null;
        _focusConfigureButton = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusConfigureButton && _configureButton is not null)
        {
            _focusConfigureButton = false;
            await _configureButton.FocusAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ConfigureWebApp(AppServiceConfiguration configuration)
    {
        try
        {
            await _webAppMgmtService.SaveConfiguration(WorkspaceAcronym, configuration);
            await _webAppMgmtService.FillSystemConfiguration(WorkspaceAcronym, configuration);
            await SetGitToken(configuration);
            await _webAppMgmtService.Configure(WorkspaceAcronym, configuration);
            ReverseProxyManagerService.ReloadConfiguration();
            _logger.LogInformation("Web app configuration processed");
            _snackbar.Add(Localizer["Web application configuration processed. It can take several minutes before your changes are applied."], Severity.Success);
            StateHasChanged();
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Failed to save web app configuration");
            _snackbar.Add(Localizer["Web application configuration failed"], Severity.Error);
        }
    }

    private async Task SetGitToken(AppServiceConfiguration config)
    {
        if (!string.IsNullOrWhiteSpace(config.GitToken))
        {
            try
            {
                await _keyVaultUserService.StoreOrUpdateSecret(WorkspaceAcronym, config.GitTokenSecretName, config.GitToken);
                _logger.LogInformation("Git token stored");
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Failed to store git token");
            }
        }
    }

}
