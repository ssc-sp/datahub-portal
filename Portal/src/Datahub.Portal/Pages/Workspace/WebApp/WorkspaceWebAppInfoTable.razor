@using Datahub.Application.Services.ReverseProxy
@using GcdsWrapper.Blazor
@inject IReverseProxyConfigService ReverseProxyConfigService

<GcdsHeading Tag="h2">@Localizer["Web application information"]</GcdsHeading>
<GcdsTable Columns="@Columns"
           Data="@Rows"
           Filter="false"
           Sort="false"
           Pagination="false">
    <span slot="caption" class="sr-only">@Localizer["Web application information"]</span>
</GcdsTable>
<GcdsText>
    @Localizer["The share link is used to share the web application with other users in your workspace. The proxy link is a direct access to your web application but may be subject to firewall issues."]
</GcdsText>


@code {
    [Parameter] public string WebAppHost { get; set; }


    [Parameter] public string Framework { get; set; }

    [Parameter] public string GitRepo { get; set; }

    [Parameter] public string ComposePath { get; set; }
    [Parameter] public string WorkspaceAcronym { get; set; }

    private string shareLink = null!;

    private string _url;

    private IReadOnlyCollection<TableColumn> Columns =>
    [
        new("property", Localizer["Property"], true),
        new("value", Localizer["Value"])
    ];

    private IReadOnlyCollection<IReadOnlyDictionary<string, string>> Rows =>
    [
        CreateRow(Localizer["Share link"], shareLink),
        CreateRow(Localizer["Proxy URL for development"], _url),
        CreateRow(Localizer["Framework"], Framework),
        CreateRow(Localizer["Git Repo"], GitRepo),
        CreateRow(Localizer["Path to compose"], ComposePath)
    ];

    protected override void OnParametersSet()
    {
        RefreshUrl();
        shareLink = PageRoutes.WorkspaceWebAppShare.Replace("{WorkspaceAcronymParam}", WorkspaceAcronym);
    }

    public void RefreshUrl()
    {
        _url = ReverseProxyConfigService.BuildWebAppURL(WorkspaceAcronym);
    }

    private static IReadOnlyDictionary<string, string> CreateRow(string property, string value) =>
        new Dictionary<string, string>
        {
            ["property"] = property,
            ["value"] = value
        };

    private sealed record TableColumn(string Field, string Header, bool RowHeader = false);
}
