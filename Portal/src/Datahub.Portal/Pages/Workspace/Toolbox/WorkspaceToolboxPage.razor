@using Datahub.Application.Services
@using Datahub.Core.Model.Achievements
@using Datahub.Shared.Entities
@using Datahub.Core.Model.Projects
@using Datahub.Shared
@using Datahub.Core.Services.Projects
@using Datahub.Portal.Pages.Account

@inherits ViewUserBase<WorkspaceToolboxPage>

@inject IDbContextFactory<DatahubProjectDBContext> _contextFactory
@inject IResourceMessagingService _resourceMessagingService
@inject IRequestManagementService _requestManagementService
@inject IUserInformationService _userInformationService
@inject ILogger<WorkspaceToolboxPage> _logger
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager
@inject IDialogService _dialogService

@if (_initializing)
{
    <DHLoadingInitializer Message="@Localizer["Loading..."]"/>
    return;
}

<MudStack>
    <DHMainContentTitle Title="@Localizer["Toolbox Catalogue"]"/>
    <MudText>
        @Localizer["The Toolbox Catalogue is a collection of tools that can be added to your workspace. You can add tools to your workspace by clicking on the 'Add to Workspace' button."]
    </MudText>

    <MudPaper Elevation="0" Outlined>
        @if (!_metadataRequired)
        {
            <MudStack Row Spacing="0">
                <MudStepper Style="@(_activeIndex == 2 ? "width: 100%" : "width: 75%")"
                            @bind-ActiveIndex="@_activeIndex">
                    <MudStep Title=@Localizer["Select"]>
                        <MudText Typo="Typo.h2" Class="mb-2">
                            @Localizer["Select tools to add, remove or configure in your workspace"]
                        </MudText>
                        <MudText Class="mb-4">
                            @Localizer["The tool catalog will list tools that are not yet in your workspace. You will be able to select from those which you would like to add to your workspace."]
                        </MudText>
                        <MudText Typo="Typo.h3" Class="mb-4">
                            @Localizer["Tool catalog"]
                        </MudText>
                        <MudStack Spacing="2" Class="mb-4" Style="flex-shrink: 0">
                            @foreach (var tool in _toolCatalog)
                            {
                                <ToolboxItem ToolName="@GetLabel(tool)" ToolIcon="@GetIcon(tool)"
                                             ToolCategory="@GetCategory(tool)" ShowDetails="@(_ => ShowInfoSheet(tool))">
                                    @switch (_toolAvailabilityStatusMap[tool])
                                    {
                                        case AvailabilityStatus.Available:
                                            <DHButton OnClick="@(_ => AddTool(tool))"
                                                      EndIcon="@Icons.Material.Outlined.Add"
                                                      DisableRipple
                                                      HtmlTag="button"
                                                      Variant="Variant.Filled" Color="Color.Primary">
                                                @Localizer["Add"]
                                            </DHButton>
                                            break;
                                        case AvailabilityStatus.Disabled:
                                            <MudText Style="font-style: italic">
                                                @Localizer["Disabled"]
                                            </MudText>
                                            break;
                                        case AvailabilityStatus.UnderDevelopment:
                                            <MudText Style="font-style: italic">
                                                @Localizer["Under Development"]
                                            </MudText>
                                            break;
                                    }
                                </ToolboxItem>
                            }
                        </MudStack>
                        <MudStack Row>

                            <MudText Typo="Typo.h3" Class="mb-4">
                                @Localizer["Tools in workspace"]
                            </MudText>

                        </MudStack>
                        <MudStack Spacing="2" Class="mb-4">
                            @foreach (var template in _originalWorkspaceDefinition.Templates)
                            {
                                var tool = template.Name;
                                <ToolboxItem ToolName="@GetLabel(tool)" ToolIcon="@GetIcon(tool)"
                                             ToolCategory="@GetCategory(tool)" ShowDetails="@(_ => ShowInfoSheet(tool))">
                                    @switch (template.Status)
                                    {
                                        case TerraformStatus.Completed:

                                            var configurable = _configurableToolList.Contains(tool);
                                            var permanent = _permanentToolList.Contains(tool);

                                            <DHButton EndIcon="@SidebarIcons.Gear"
                                                      Variant="Variant.Filled" Color="Color.Default" DisableRipple
                                                      OnClick="@(_ => ConfigureTool(tool))"
                                                      Disabled="@(!configurable)"
                                                      HtmlTag="button"
                                                      title="@(configurable ? "" : Localizer["This tool cannot be configured currently."])">
                                                @Localizer["Configure"]
                                            </DHButton>
                                            <DHButton EndIcon="@Icons.Material.Outlined.Delete"
                                                      Variant="Variant.Filled" Color="Color.Error" DisableRipple
                                                      OnClick="@(_ => RemoveTool(tool))"
                                                      Disabled="@(permanent)"
                                                      HtmlTag="button"
                                                      title="@(permanent ? Localizer["This tool cannot be removed currently."] : "")">
                                                @Localizer["Remove"]
                                            </DHButton>
                                            break;
                                        case TerraformStatus.InProgress:
                                        case TerraformStatus.CreateRequested:
                                            <MudText Style="font-style: italic">
                                                @Localizer["In Progress"]
                                            </MudText>
                                            break;
                                        case TerraformStatus.Failed:
                                            <MudText Style="font-style: italic">
                                                @Localizer["Failed"]
                                            </MudText>
                                            break;
                                        case TerraformStatus.Deleted:
                                        case TerraformStatus.DeleteRequested:
                                            <MudText Style="font-style: italic">
                                                @Localizer["Deleted"]
                                            </MudText>
                                            break;
                                    }
                                </ToolboxItem>
                            }
                        </MudStack>
                        <MudText Style="font-style: italic">
                            @Localizer["Some tools may not be configurable or removable through the toolbox just yet. For more information, please submit a support request."]
                        </MudText>
                    </MudStep>
                    <MudStep Title=@Localizer["Configure"]>
                        <MudText Typo="Typo.h2" Class="mb-4">
                            @Localizer["Configure the tools you have added to your workspace"]
                        </MudText>
                        <MudStack Spacing="4">
                            @foreach (var tool in _toolsToConfigure.Concat(_toolsToAdd))
                            {
                                <MudPaper Elevation="0" Outlined Class="pa-4">
                                    <MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
                                        <DHIcon Icon="@GetIcon(tool)" Size="Size.Large"/>
                                        <MudText Typo="Typo.h3">
                                            @GetLabel(tool) configuration
                                        </MudText>
                                    </MudStack>
                                    <MudStack Spacing="2">
                                        @switch (tool)
                                        {
                                            case TerraformTemplate.AzurePostgres:
                                            case TerraformTemplate.AzureAppService:
                                                <SettingsField Label="@Localizer["Database tier"]"
                                                               Description="@Localizer["Choose a tier for the compute of your database. This will affect the performance and cost of your database."]">
                                                    <MudSelect T="string" Label="@Localizer["Database tier"]">
                                                        <MudSelectItem
                                                            Value="@basicTier">@Localizer["Basic"]</MudSelectItem>
                                                        <MudSelectItem
                                                            Value="@generalPurposeTier">@Localizer["General Purpose"]</MudSelectItem>
                                                        <MudSelectItem
                                                            Value="@memoryOptimizedTier">@Localizer["Memory Optimized"]</MudSelectItem>
                                                    </MudSelect>
                                                </SettingsField>
                                                <SettingsField Label="@Localizer["Database size"]"
                                                               Description="@Localizer["Choose the size of your database. This will affect the cost of your database"]">
                                                    <MudSelect T="string" Label="@Localizer["Database size"]">
                                                        <MudSelectItem
                                                            Value="@basicTier">@Localizer["Basic"]</MudSelectItem>
                                                        <MudSelectItem
                                                            Value="@generalPurposeTier">@Localizer["General Purpose"]</MudSelectItem>
                                                        <MudSelectItem
                                                            Value="@memoryOptimizedTier">@Localizer["Memory Optimized"]</MudSelectItem>
                                                    </MudSelect>
                                                </SettingsField>
                                                break;
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudStep>
                    <MudStep Title=@Localizer["Review"]>
                        <MudText Typo="Typo.h2" Class="mb-4">
                            @Localizer["Review the tools you have selected to add, remove or configure in your workspace"]
                        </MudText>
                        <MudText Class="mb-4">
                            @Localizer["Make sure that the following information is correct before submitting your request. Tool requests cannot be cancelled and may take some time to process."]
                        </MudText>
                        <MudStack Row Justify="Justify.Center" Class="my-8">
                            <MudPaper Elevation="0" Outlined Class="pa-4">
                                <MudStack Row Spacing="8">
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.h3">
                                            @Localizer["ADD:"]
                                        </MudText>
                                        @if (!_toolsToAdd.Any())
                                        {
                                            <MudText Style="font-style: italic">Nothing</MudText>
                                        }
                                        @foreach (var tool in _toolsToAdd)
                                        {
                                            <MudText>
                                                @GetLabel(tool).ToUpper()
                                            </MudText>
                                            @switch (tool)
                                            {
                                                case TerraformTemplate.AzurePostgres:
                                                case TerraformTemplate.AzureAppService:
                                                    <MudText Style="font-style: italic">
                                                        - @Localizer["Database tier:"] @basicTier
                                                    </MudText>
                                                    <MudText Style="font-style: italic">
                                                        - @Localizer["Database size:"] @basicTier
                                                    </MudText>
                                                    break;
                                            }
                                        }
                                    </MudStack>
                                    <MudDivider Vertical FlexItem/>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h3">
                                            @Localizer["CONFIGURE:"]
                                        </MudText>
                                        @foreach (var tool in _toolsToConfigure)
                                        {
                                            <MudText>
                                                @GetLabel(tool).ToUpper()
                                            </MudText>
                                            @switch (tool)
                                            {
                                                case TerraformTemplate.AzurePostgres:
                                                case TerraformTemplate.AzureAppService:
                                                    <MudText Style="font-style: italic">
                                                        - @Localizer["Database tier:"] @basicTier
                                                    </MudText>
                                                    <MudText Style="font-style: italic">
                                                        - @Localizer["Database size:"] @basicTier
                                                    </MudText>
                                                    break;
                                            }
                                        }
                                    </MudStack>
                                    <MudDivider Vertical FlexItem/>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h3">
                                            @Localizer["REMOVE:"]
                                        </MudText>
                                        @foreach (var tool in _toolsToRemove)
                                        {
                                            <MudText>
                                                @GetLabel(tool).ToUpper()
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h3">
                                    @Localizer["Cost information"]
                                </MudText>
                                <MudText>
                                    - @Localizer["Current estimated daily cost: "] <strong>$2.16</strong>
                                </MudText>
                                <MudText>
                                    - @Localizer["New estimated daily cost: "] <strong>$4.78 (+$2.62)</strong>
                                </MudText>
                                <MudText>
                                    - <strong>18% (+2%)</strong> of current budget per month
                                </MudText>
                                <MudText>
                                    - <strong>16.5</strong> months until reaching budget limit
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText>
                            @Localizer["By clicking complete, you are confirming that the information above is correct and that you understand the cost implications of your request."]
                        </MudText>
                    </MudStep>
                </MudStepper>
                @if (_activeIndex != 2)
                {
                    <MudDivider Vertical DividerType="DividerType.Middle" FlexItem/>
                    <MudStack Class="pa-4" Spacing="0">
                        <MudText Typo="Typo.h2" Class="mb-4">
                            @Localizer["Summary"]
                        </MudText>
                        @if (_toolsToAdd.Any())
                        {
                            <MudText Typo="Typo.h3" Class="mb-2">
                                @Localizer["Tools to add:"]
                            </MudText>
                            <MudStack Spacing="2" Class="mb-4">
                                @foreach (var tool in _toolsToAdd)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center">
                                        <MudText>
                                            @GetLabel(tool)
                                        </MudText>
                                        @if (_activeIndex == 0)
                                        {
                                            <MudSpacer/>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                                           Color="Color.Error"
                                                           OnClick="@(_ => RevertAddTool(tool))" Size="Size.Small"/>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        }
                        @if (_toolsToConfigure.Any())
                        {
                            <MudText Typo="Typo.h3" Class="mb-2">
                                @Localizer["Tools to configure:"]
                            </MudText>
                            <MudStack Spacing="2" Class="mb-4">
                                @foreach (var tool in _toolsToConfigure)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center">
                                        <MudText>
                                            @GetLabel(tool)
                                        </MudText>
                                        @if (_activeIndex == 0)
                                        {
                                            <MudSpacer/>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                                           Color="Color.Error"
                                                           OnClick="@(_ => RevertConfigureTool(tool))"
                                                           Size="Size.Small"/>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        }
                        @if (_toolsToRemove.Any())
                        {
                            <MudText Typo="Typo.h3" Class="mb-4">
                                @Localizer["Tools to remove:"]
                            </MudText>
                            <MudStack Spacing="2" Class="mb-4">
                                @foreach (var tool in _toolsToRemove)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center">
                                        <MudText>
                                            @GetLabel(tool)
                                        </MudText>
                                        @if (_activeIndex == 0)
                                        {
                                            <MudSpacer/>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                                           Color="Color.Error"
                                                           OnClick="@(_ => RevertRemoveTool(tool))" Size="Size.Small"/>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        }
                        <MudSpacer/>
                        <MudText Style="font-style: italic">
                            @Localizer["Current estimated daily cost: $2.16"]
                        </MudText>
                        <MudText Style="font-style: italic">
                            @Localizer["New estimated daily cost: $4.78"]
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Style="color: #000;" Class="mb-6">
                @Localizer["Looks like you haven't added metadata to your workspace yet. Please add metadata to your workspace to be able to request tools."]
                <MudLink Href="@_metadataUrl">@Localizer["Go to metadata page"]</MudLink>
            </MudAlert>
        }
    </MudPaper>
</MudStack>

@code {

    [Parameter] public string WorkspaceAcronym { get; set; }
    [Parameter] public bool ElevatedWorkspaceAccessEnabled { get; set; } = false;

    private Datahub_Project _workspace;
    private WorkspaceDefinition _originalWorkspaceDefinition;
    private WorkspaceDefinition _newWorkspaceDefinition;
    private PortalUser _viewedPortalUser;
    private string basicTier = "Basic";
    private string generalPurposeTier = "General Purpose";
    private string memoryOptimizedTier = "Memory Optimized";

    private List<string> _toolCatalog = new();
    private List<string> _toolsToAdd = new();
    private List<string> _toolsToRemove = new();
    private List<string> _toolsToConfigure = new();

    private bool _metadataRequired = true;
    private bool _initializing = true;

    private int _activeIndex;

    private string _metadataUrl => $"{PageRoutes.WorkspacePrefix}/{WorkspaceAcronym}/{WorkspaceSidebar.SectionViews.Metadata}";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await using var context = await _contextFactory.CreateDbContextAsync();
        _viewedPortalUser = await GetViewedPortalUserWithAchievementsAsync();
        _workspace = await context.Projects
            .AsNoTracking()
            .Include(w => w.Resources)
            .Include(w => w.Credits)
            .FirstAsync(w => w.Project_Acronym_CD == WorkspaceAcronym);
        _originalWorkspaceDefinition = await _resourceMessagingService.GetWorkspaceDefinition(_workspace.Project_Acronym_CD, _viewedPortalUser.Email);
        // TODO: Implement object cloning instead of making 2 calls ^ v
        _newWorkspaceDefinition = await _resourceMessagingService.GetWorkspaceDefinition(_workspace.Project_Acronym_CD, _viewedPortalUser.Email);
        // TODO: Update this piece of code once the metadata is filled in via GC Hosting

        _metadataRequired = _workspace.MetadataAdded != true;
        PopulateCatalog();
        _initializing = false;
        await InvokeAsync(StateHasChanged);
    }

    private string FetchWorkspaceResourceStatus(string resourceType)
    {
        if (_toolAvailabilityStatusMap[resourceType] != AvailabilityStatus.Available)
        {
            return _toolAvailabilityStatusMap[resourceType];
        }

        var resource = _workspace.Resources
            .FirstOrDefault(r => r.ResourceType == TerraformTemplate.GetTerraformServiceType(resourceType));

        if (resource is null)
        {
            return _workspace.IsOverBudget ? AvailabilityStatus.Disabled : AvailabilityStatus.Available;
        }

        if (resource.Status is not null) return resource.Status;

        _logger.LogWarning("Resource {ResourceType} in workspace {WorkspaceAcronym} has no status", resourceType, WorkspaceAcronym);
        // TODO: Add a default status for resources that have no status
        return TerraformStatus.Completed;
    }

    private async Task AddResourceToWorkspace(string resource)
    {
        _logger.LogInformation("Adding tool {Tool} to workspace {WorkspaceAcronym}", resource, WorkspaceAcronym);
        _toolDisplayStatusMap[resource] = TerraformStatus.CreateRequested;
        await InvokeAsync(StateHasChanged);

        try
        {
            var resourceType = TerraformTemplate.GetTerraformServiceType(resource);
            await using var ctx = await _contextFactory.CreateDbContextAsync();

            var exists = await ctx.Project_Resources2
                .AnyAsync(r => r.ProjectId == _workspace.Project_ID && r.ResourceType == resourceType);

            if (exists)
            {
                _snackbar.Add(Localizer["{0} is already added to your workspace", GetLabel(resource)], Severity.Info);
                return;
            }

            var currentUser = await _userInformationService.GetCurrentPortalUserAsync();
            var template = new TerraformTemplate(resource, TerraformStatus.CreateRequested);
            await _requestManagementService.HandleTerraformRequestServiceAsync(_workspace, template, currentUser);
            _logger.LogInformation("Tool {Tool} successfully added to workspace {WorkspaceAcronym}", resource, WorkspaceAcronym);
            _snackbar.Add(Localizer["{0} successfully added to your workspace", GetLabel(resource)], Severity.Success);

            _toolDisplayStatusMap[resource] = TerraformStatus.InProgress;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Error adding tool {Tool} to workspace {WorkspaceAcronym}", resource, WorkspaceAcronym);

            _toolDisplayStatusMap[resource] = TerraformStatus.Failed;
            _snackbar.Add(Localizer["Error adding {0} to your workspace", GetLabel(resource)], Severity.Error);
        }
    }

    private void NavigateToResourceDeletePage(string resourceName)
    {
        _navigationManager.NavigateTo($"{PageRoutes.WorkspacePrefix}/{WorkspaceAcronym}/{WorkspaceSidebar.SectionViews.Delete}/{resourceName}");
    }


}