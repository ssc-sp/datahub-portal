@namespace Datahub.Portal.Pages.Workspace.Delete

@using Datahub.Application.Services
@using Datahub.Core.Extensions;
@using Datahub.Core.Model.Projects
@using Datahub.Portal.Pages.Account
@using Datahub.Shared
@using Datahub.Shared.Entities
@using GcdsWrapper.Blazor
@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject IUserInformationService _userInformationService
@inject IResourceMessagingService _resourceMessagingService
@inject IJSRuntime _jSRuntime
@inject ISnackbar _snackbar
@inject IProjectDeletionService _projectDeletionService

@inject NavigationManager _navigationManager

<DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.WorkspaceLead" ProjectAcronym="@WorkspaceAcronym" ElevatedWorkspaceAccessEnabled="true">
    <Authorized>
        <div class="px-4">
            <GcdsText>
                @Localizer["Are you sure you want to delete the following workspace: {0}?", WorkspaceAcronym]
            </GcdsText>

            <GcdsCheckboxes Name="workspace-deletion-confirmations"
                            Legend="@Localizer["This action is permanent. Upon deletion, the workspace and all its resources will be deleted"]"
                            Options="@DeletionConfirmationOptions"
                            Value="@_selectedConfirmations"
                            ValueChanged="HandleConfirmationsChanged"
                            ValueExpression="@(() => _selectedConfirmations)" />

            <GcdsInput Id="workspace-deletion-acronym"
                       Name="workspace-deletion-acronym"
                       Label="@Localizer["Please type {0} to confirm the deletion.", WorkspaceAcronym]"
                       @bind-Value="_deleteConfirmation" />

            @if (_error.Equals("_emptyConfirmation"))
            {
                <div role="alert">
                    <GcdsNotice NoticeRole="danger"
                                NoticeTitle="@Localizer["Please enter a workspace acronym."]"
                                NoticeTitleTag="h2" />
                </div>
            }
            else if (_error.Equals("_badConfirmation"))
            {
                <div role="alert">
                    <GcdsNotice NoticeRole="danger"
                                NoticeTitle="@Localizer["Incorrect workspace acronym."]"
                                NoticeTitleTag="h2" />
                </div>
            }

            <GcdsGrid Columns="1fr" ColumnsTablet="max-content max-content">
                <GcdsButton Type="GcdsButtonType.Link" Role="GcdsButtonRole.Secondary" Href="@_settingsPage">
                    @Localizer["Cancel"]
                </GcdsButton>
                <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Danger" Disabled="@_disableDeleteButton" OnClick="ConfirmDeletion">
                    @_deleteButtonText
                </GcdsButton>
            </GcdsGrid>
        </div>
    </Authorized>
    <NotAuthorized>
        <GcdsNotice NoticeRole="warning" NoticeTitle="@Localizer["Access Denied"]" NoticeTitleTag="h2" />
    </NotAuthorized>
</DatahubAuthView>
@code
{
    [Parameter]
    public string WorkspaceAcronym { get; set; }
    [Parameter]
    public bool ElevatedWorkspaceAccessEnabled { get; set; } = true;

    private string _deleteConfirmation;
    private string _error = "";
    private string _settingsPage => $"{PageRoutes.WorkspacePrefix}/{WorkspaceAcronym}/{WorkspaceSidebar.SectionViews.Settings}";
    private bool _deleteRequested;
    private bool _disableDeleteButton;
    private string _deleteButtonText = "Delete Workspace";
    private string[] _selectedConfirmations = [];
    private Project_Delete_Questionnaire _questionnaire = new Project_Delete_Questionnaire();

    private IReadOnlyCollection<GcdsCheckboxOption> DeletionConfirmationOptions =>
    [
        new(nameof(Project_Delete_Questionnaire.IsWorkspaceNotRequired), Localizer["The workspace is no longer required."], nameof(Project_Delete_Questionnaire.IsWorkspaceNotRequired)),
        new(nameof(Project_Delete_Questionnaire.IsDataMigrated), Localizer["All data or information of business value in the workspace has been migrated to the departmental repositories."], nameof(Project_Delete_Questionnaire.IsDataMigrated)),
        new(nameof(Project_Delete_Questionnaire.IsDataNotSubjectToLitigation), Localizer["Data or information in the workspace is not subject to a litigation hold."], nameof(Project_Delete_Questionnaire.IsDataNotSubjectToLitigation)),
        new(nameof(Project_Delete_Questionnaire.DoesDataNotHaveArchivalValue), Localizer["Data or information in the workspace does not have archival value according to the Disposition Authorization issued by Library and Archives Canada."], nameof(Project_Delete_Questionnaire.DoesDataNotHaveArchivalValue)),
        new(nameof(Project_Delete_Questionnaire.IsDeletionConfirmed), Localizer["I confirm the data, information, applications, notebooks, storage, etc. can be removed from the workspace, and the workspace can be deleted. Once deleted, the data cannot be recovered."], nameof(Project_Delete_Questionnaire.IsDeletionConfirmed))
    ];


    protected override async Task OnInitializedAsync()
    {
        var workspaceTemplateTypes = TerraformTemplate.WorkspaceTemplateServiceTypes;
        await using var ctx = await _dbContextFactory.CreateDbContextAsync();
        var newTemplateResource = await ctx.Project_Resources2.Where(
                    r => r.Project.Project_Acronym_CD == WorkspaceAcronym &&
                    workspaceTemplateTypes.Contains(r.ResourceType))
                    .FirstOrDefaultAsync();

        if (newTemplateResource != null)
        {
            _deleteRequested = newTemplateResource.Status == TerraformStatus.DeleteRequested || newTemplateResource.Status == TerraformStatus.Deleted;
        }

        _deleteButtonText = _deleteRequested ? Localizer["Deleted"] : Localizer["Delete Workspace"];
        _disableDeleteButton = _deleteRequested || !IsQuestionnaireComplete();

        if (WorkspaceAcronym == null)
        {
            _snackbar.Add(Localizer["Invalid parameters, redirecting"], Severity.Error);
            _navigationManager.NavigateTo(_settingsPage);
            return;
        }
    }

    private bool IsQuestionnaireComplete()
    {
        return _questionnaire.IsWorkspaceNotRequired &&
                _questionnaire.IsDataMigrated &&
                _questionnaire.IsDataNotSubjectToLitigation &&
                _questionnaire.DoesDataNotHaveArchivalValue &&
                _questionnaire.IsDeletionConfirmed;
    }

    private void HandleConfirmationsChanged(string[]? selectedConfirmations)
    {
        _selectedConfirmations = selectedConfirmations ?? [];
        _questionnaire.IsWorkspaceNotRequired = _selectedConfirmations.Contains(nameof(Project_Delete_Questionnaire.IsWorkspaceNotRequired));
        _questionnaire.IsDataMigrated = _selectedConfirmations.Contains(nameof(Project_Delete_Questionnaire.IsDataMigrated));
        _questionnaire.IsDataNotSubjectToLitigation = _selectedConfirmations.Contains(nameof(Project_Delete_Questionnaire.IsDataNotSubjectToLitigation));
        _questionnaire.DoesDataNotHaveArchivalValue = _selectedConfirmations.Contains(nameof(Project_Delete_Questionnaire.DoesDataNotHaveArchivalValue));
        _questionnaire.IsDeletionConfirmed = _selectedConfirmations.Contains(nameof(Project_Delete_Questionnaire.IsDeletionConfirmed));

        _disableDeleteButton = _deleteRequested || !IsQuestionnaireComplete();
    }

    private async Task ConfirmDeletion()
    {
        if (string.IsNullOrEmpty(_deleteConfirmation))
        {
            _snackbar.Add(Localizer["Please enter a workspace acronym."], Severity.Error);
            _error = "_emptyConfirmation";
        }
        else if (!_deleteConfirmation.Equals(WorkspaceAcronym))
        {
            _snackbar.Add(Localizer["Incorrect workspace acronym."], Severity.Error);
            _error = "_badConfirmation";
        }
        else
        {
            var message = string.Format(Localizer["Are you sure you want to delete the workspace {0}?"], WorkspaceAcronym);
            if (!await _jSRuntime.InvokeAsync<bool>("confirm", message))
                return;

            var isRecentLinksCleaned = await _projectDeletionService.CleanWorkspaceFromRecentLinks(WorkspaceAcronym);
            _deleteRequested = await _projectDeletionService.DeleteWorkspace(WorkspaceAcronym, _questionnaire);

            if (_deleteRequested)
            {
                _navigationManager.NavigateTo(Localizer[PageRoutes.Home]);
            }
            else
            {
                _snackbar.Add(Localizer["An error occured when deleting this workspace. Please contact support."], Severity.Error);
            }

        }
    }
}
