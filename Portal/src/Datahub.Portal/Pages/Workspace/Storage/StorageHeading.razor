@using Datahub.Application.Services.Publishing
@using Datahub.Core.Model.Projects
@using Datahub.Core.Model.Users
@using Datahub.Core.Storage;
@using Datahub.Metadata.Model;
@using Datahub.Application.Services
@using Datahub.Application.Services.Metadata
@using Datahub.Application.Services.UserManagement
@using Datahub.Infrastructure.Services.Security
@using Datahub.Infrastructure.Services.Storage
@using Datahub.Shared.Entities
@using Microsoft.JSInterop

@inject NavigationManager _navigationManager
@inject IUserInformationService _userInformationService
@inject IJSRuntime _jsRuntime
@inject IPortalUserTelemetryService _telemetryService
@inject IServiceAuthManager ServiceAuthManager
@inject IMetadataBrokerService MetadataBrokerService
@inject IProjectUserManagementService _projectUserManagementService
@inject IOpenDataPublishingService _openDataPublishingService
@inject DatahubPortalConfiguration _config
@inject IDialogService _dialogService
@inject ISnackbar _snackbar
@implements IAsyncDisposable

    
<div class="heading">
    <div class="actions">
        @foreach(var action in _buttonActions)
        {
            if ((action is ButtonAction.BackToContainers && !ShowBackToContainers)
                || (action is ButtonAction.NewFolder && !ShowNewFolder)
                || (action is ButtonAction.DeleteFolder && !ShowDeleteFolder)
                || (action is ButtonAction.Publish && !ShowPublish))
            { continue; }
            else if (action is ButtonAction.TierChange)
            {
                <MudSelect T="string"
                           Variant="Variant.Outlined"
                           Value="@SelectedStorageTier"
                           ValueChanged="@(async (string v) => await HandleTierChange(v))"
                           Label="@Localizer["Storage Tier"]"
                           Disabled="@GetDisabled(action)"
                           FitContent="true"
                           Margin="Margin.Dense"
                           aria-label="Storage tier">
                    @foreach (string s in _storageTiers)
                    {
                        <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <DHButton @onclick="() => GetButtonActionHandler(action)" StartIcon="@GetButtonActionIcon(action)" Disabled="@GetDisabled(action)">
                    @Localizer[ButtonActionToString(action)]
                </DHButton>
            }
        }
    </div>

    <HeadingBreadcrumbs SetCurrentFolder="@SetCurrentFolder" CurrentFolder="@CurrentFolder" ContainerName="@ContainerName" />
</div>

@code {

    [CascadingParameter(Name = "ProjectAcronym")]
    public string ProjectAcronym { get; set; } = null!;

    [CascadingParameter(Name = "PortalUser")]
    public PortalUser PortalUser { get; set; } = null!;

    [CascadingParameter(Name = "Project")]
    public Datahub_Project Project { get; set; } = null!;

    [Parameter]
    public string CurrentFolder { get; set; } = null!;

    [Parameter]
    public HashSet<string>? SelectedItems { get; set; }

    [Parameter]
    public List<string> Folders { get; set; }

    [Parameter]
    public List<PortalFileMetadata>? Files { get; set; }

    [Parameter]
    public Func<string, bool> CanDeleteFolder { get; set; } = _ => true;

    [Parameter]
    public EventCallback<string> SetCurrentFolder { get; set; }

    [Parameter]
    public EventCallback<string> OnFileDelete { get; set; }

    [Parameter]
    public EventCallback<string> OnFileDownload { get; set; }

    [Parameter]
    public EventCallback<string> OnFileRename { get; set; }

    [Parameter]
    public EventCallback<string> OnNewFolder { get; set; }

    [Parameter]
    public EventCallback OnDeleteFolder { get; set; }

    [Parameter]
    public EventCallback<IEnumerable<FileMetadata>> OnPublishFiles { get; set; }

    [Parameter]
    public Guid MetadataSignature { get; set; } = Guid.NewGuid();

    [Parameter]
    public bool ShowNewFolder { get; set; } = true;

    [Parameter]
    public bool ShowDeleteFolder { get; set; } = true;

    [Parameter]
    public bool ShowPublish { get; set; } = true;

    [Parameter]
    public bool ShowBackToContainers { get; set; } = false;

    [Parameter]
    public bool ShowMntHierarchy { get; set; } = false;

    [Parameter]
    public bool Readonly { get; set; } = false;

    [Parameter]
    public EventCallback OnBackToContainers { get; set; }
    
    [Parameter]
    public ICloudStorageManager StorageManager { get; set; }

    [Parameter]
    public string ContainerName { get; set; } = "datahub";

    private IJSObjectReference _module = null!;

    private List<PortalFileMetadata>? _selectedFiles;
    private bool _ownsSelectedFiles;
    private bool _isUnclassifiedSingleFile;
    private bool _isElectron = true;
    private bool _isPublishingBlockedForWorkspace = false;

    // private bool _isDatahubAdmin;
    // private bool _isProjectMember;

    private Project_Role _currentUserRole = null!;
    private DotNetObjectReference<StorageHeading> _dotNetHelper = null!;

    private List<ButtonAction> _buttonActions = new()
    {
        ButtonAction.BackToContainers,
        ButtonAction.Upload,
        ButtonAction.Download,
        ButtonAction.Rename,
        ButtonAction.Delete,
        ButtonAction.NewFolder,
        ButtonAction.DeleteFolder,
        ButtonAction.TierChange,
        ButtonAction.Publish
    };

    // private string _storageTier;
    private List<string> _storageTiers = new List<string> { "Hot", "Cool", "Cold", "Archive" };

    [Parameter]
    public string SelectedStorageTier { get; set; } = "Hot";

    [Parameter]
    public EventCallback<string> OnStorageTierChanged { get; set; }

    [Parameter]
    public bool IsStorageTierDisabled { get; set; } = false;

    private Dictionary<ButtonAction, bool> _actionDisabled = new();

    private bool GetDisabled(ButtonAction action)
    {
        return _actionDisabled.TryGetValue(action, out var v) ? v : true;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await _userInformationService.GetCurrentPortalUserAsync();
        var projectUsers = await _projectUserManagementService.GetProjectUsersAsync(ProjectAcronym);
        _currentUserRole = projectUsers.FirstOrDefault(pu => pu.PortalUser.Id == currentUser.Id)?.Role;
        
        // Check if publishing is blocked for this workspace
        _isPublishingBlockedForWorkspace = await _openDataPublishingService.IsPublishingBlockedForWorkspaceAsync(ProjectAcronym);
        _storageTiers = StorageManager.GetFileStorageTiersList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _module = await _jsRuntime.InvokeAsync<IJSObjectReference>("import",
                "./Pages/Workspace/Storage/StorageHeading.razor.js");
            _dotNetHelper = DotNetObjectReference.Create(this);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        _selectedFiles = Files?
            .Where(f => SelectedItems != null && SelectedItems.Contains(f.name))
            .ToList();

        // TODO: This is a hack until SSC properly sets the owner of a file
        if (Environment.GetEnvironmentVariable("HostingProfile") == "ssc")
        {
            _ownsSelectedFiles = _selectedFiles != null;
        }
        else
        {
            _ownsSelectedFiles = _selectedFiles?
                .TrueForAll(file => file?.ownedby?.Equals(PortalUser.UserUID(), StringComparison.InvariantCulture) ?? false)
                .Equals(true) ?? false;

            if (_ownsSelectedFiles && _selectedFiles?.Count == 1)
            {
                var fileClassification = await MetadataBrokerService.GetObjectClassification(_selectedFiles[0].id);
                _isUnclassifiedSingleFile = (fileClassification ?? ClassificationType.Unclassified) == ClassificationType.Unclassified;
            }
            else
            {
                _isUnclassifiedSingleFile = false;
            }
        }

        // Precompute disabled state for actions using the async IsActionDisabled
        _actionDisabled.Clear();
        foreach (var action in _buttonActions)
        {
            try
            {
                _actionDisabled[action] = await IsActionDisabled(action);
            }
            catch
            {
                _actionDisabled[action] = true;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> IsCurrentUserMemberOfProject()
    {
        var hasRole = Project.UserRoles.Any(u => u.PortalUser == PortalUser);
        if (hasRole)
            return true;

        return await ServiceAuthManager.IsProjectAdmin(PortalUser, ProjectAcronym);
    }

    private async Task ShowPublishingBlockedDialog()
    {
        await _dialogService.ShowMessageBoxAsync(
            Localizer["Publishing Disabled"],
            Localizer["Publishing has been disabled for this workspace by the administrator."],
            yesText: Localizer["OK"]
        );
    }

    private const string JobStatusComplete = "Completed";

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // ignored
        }
    }
}
