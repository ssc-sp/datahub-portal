@using Datahub.Core.Storage
@using MudBlazor
@inject ILogger<FileMetadataEditor> Logger

<div>
    <MudText Typo="Typo.h5">Storage Metadata</MudText>

    @if (EditMode)
    {
        <div class="metadata-entries">
            @foreach (var entry in _metadata)
            {
                <div class="d-flex align-items-center">
                    <MudTextField Value="entry.Key" Placeholder="Key" Class="me-2" Immediate="false" />
                    <MudTextField Value="entry.Value" Placeholder="Value" Class="me-2" Immediate="false" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="(() => RemoveEntry(entry.Key))" />
                </div>
            }
        </div>
        <DHButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddEntry">Add key</DHButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Color="Color.Error">@_error</MudText>
        }
        <MudSpacer />
        <DHButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" FullWidth="false">Save</DHButton>
        <DHButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="EditModeToggle" FullWidth="false">Cancel</DHButton>
    }
    else
    {
        <DHButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditModeToggle" Title="Edit metadata">@Localizer["Edit metadata"]</DHButton>
        <div class="properties">
            @foreach (var entry in _metadata)
            {
                <MudText Class="label">@entry.Key</MudText>
                <MudText Class="text">@entry.Value</MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public string ContainerName { get; set; } = "datahub";
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public ICloudStorageManager StorageManager { get; set; } = null!;

    private IDictionary<string, string> _metadata { get; set; } = new Dictionary<string, string>();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        _metadata = await StorageManager.GetFileMetadataAsync(ContainerName, FileName);
    }

    private void AddEntry()
    {
        _metadata.Add(string.Empty, string.Empty);
    }

    private void RemoveEntry(string key)
    {
        _metadata.Remove(key);
    }

    private void EditModeToggle()
    {
        EditMode = !EditMode;
    }

    private async Task Save()
    {
        _error = null;

        // Validate keys
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in _metadata.Where(e => !string.IsNullOrWhiteSpace(e.Key)))
        {
            if (dict.ContainsKey(kv.Key))
            {
                _error = "Duplicate keys are not allowed.";
                return;
            }
            dict[kv.Key] = kv.Value ?? string.Empty;
        }

        try
        {
            if (StorageManager is null)
            {
                _error = "Storage manager unavailable.";
                return;
            }

            await StorageManager.SetFileMetadataAsync(ContainerName, FileName, dict);

            EditMode = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save metadata");
            _error = ex.Message;
        }
    }
}
