@using Datahub.Core.Storage
@using MudBlazor
@inject ILogger<FileMetadataEditor> Logger

<div>
    <MudText Typo="Typo.h5">Storage Metadata</MudText>

    @if (EditMode)
    {
        <div class="metadata-entries">
            @for (var i = 0; i < _metadata.Count; i++)
            {
                var entry = _metadata[i];
                <div class="d-flex align-items-center">
                    <MudTextField @bind-Value="entry.Key" Placeholder="Key" Class="me-2" Immediate="false" />
                    <MudTextField @bind-Value="entry.Value" Placeholder="Value" Class="me-2" Immediate="false" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="(() => RemoveEntry(entry))" />
                </div>
            }
        </div>
        <DHButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddEntry">Add key</DHButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Color="Color.Error">@_error</MudText>
        }
        <MudSpacer />
        <DHButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" FullWidth="false">Save</DHButton>
        <DHButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="EditModeToggle" FullWidth="false">Cancel</DHButton>
    }
    else
    {
        <DHButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditModeToggle" Title="Edit metadata">@Localizer["Edit metadata"]</DHButton>
        <div class="properties">
            @foreach (var entry in _metadata)
            {
                <MudText Class="label">@entry.Key</MudText>
                <MudText Class="text">@entry.Value</MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public string ContainerName { get; set; } = "datahub";
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public ICloudStorageManager StorageManager { get; set; } = null!;

    private List<MetadataEntry> _metadata { get; set; } = new List<MetadataEntry>();
    private string? _error;

    private class MetadataEntry
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (StorageManager is not null)
        {
            var dict = await StorageManager.GetFileMetadataAsync(ContainerName, FileName);
            _metadata = dict.Select(kv => new MetadataEntry { Key = kv.Key, Value = kv.Value }).ToList();
        }
    }

    private void AddEntry()
    {
        _metadata.Add(new MetadataEntry());
    }

    private void RemoveEntry(MetadataEntry entry)
    {
        if (entry is not null)
            _metadata.Remove(entry);
    }

    private async Task EditModeToggle()
    {
        EditMode = !EditMode;
        // If cancelling edits, reload metadata to discard changes
        if (!EditMode && StorageManager is not null)
        {
            var dict = await StorageManager.GetFileMetadataAsync(ContainerName, FileName);
            _metadata = dict.Select(kv => new MetadataEntry { Key = kv.Key, Value = kv.Value }).ToList();
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        _error = null;

        // Validate keys
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var entry in _metadata.Where(e => !string.IsNullOrWhiteSpace(e.Key)))
        {
            if (dict.ContainsKey(entry.Key))
            {
                _error = "Duplicate keys are not allowed.";
                return;
            }
            dict[entry.Key] = entry.Value ?? string.Empty;
        }

        try
        {
            if (StorageManager is null)
            {
                _error = "Storage manager unavailable.";
                return;
            }

            await StorageManager.SetFileMetadataAsync(ContainerName, FileName, dict);

            EditMode = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save metadata");
            _error = ex.Message;
        }
    }
}
