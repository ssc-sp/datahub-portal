@using Datahub.Portal.Pages.Workspace.Storage.Container
@using Datahub.Core.Storage;
@* AzCopy.razor *@

@if (TermsAcknowledged)
{
    <MudStack>
        <MudElement>
            <SASTokenButton OnSubstitutionsChanged="HandleSubstitutionsChanged" Container="@Container" ExpiryDays="3"/>
        </MudElement>
        <EmbeddedWiki PageNameEn="/UserGuide/Storage/Use-AzCopy.md"
                      PageNameFr="/fr/UserGuide/Storage/Utilisez-AzCopy.md"
                      Substitutions="_substitutions"/>
    </MudStack>
}
else
{
    <AcknowledgementConfirmation 
        OnAccepted=@OnTermsAccepted
        MarkdownPathEn="/UserGuide/Acknowledgements/StorageTokenTC.md"
        MarkdownPathFr="/fr/UserGuide/Acknowledgements/StorageTokenTC-fr.md"
        ButtonText=@Localizer["Accept Storage Access Token Terms"] />
}

@code {

    [Parameter, EditorRequired]
    public CloudStorageContainer Container { get; set; }

    [Parameter, EditorRequired]
    public bool TermsAcknowledged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnTermsAccepted { get; set; }

    private List<(string, string)> _substitutions;

    private void HandleSubstitutionsChanged(List<(string, string)> substitutions)
    {
        _substitutions = substitutions;
    }

}