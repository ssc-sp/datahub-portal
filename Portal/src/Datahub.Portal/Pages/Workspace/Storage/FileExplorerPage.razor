@using Azure.Core
@implements IAsyncDisposable
@using Datahub.Application.Services;
@using Datahub.Application.Services.Storage
@using Datahub.Core.Model.CloudStorage;
@using Datahub.Core.Model.Projects
@using Datahub.Core.Model.Users
@using Datahub.Core.Model
@using Datahub.Core.Storage;
@using Datahub.Core.Data
@using Datahub.Infrastructure.Services.Security
@using Datahub.Infrastructure.Services.Storage
@using Datahub.Metadata.Model
@using Datahub.Portal.Pages.Workspace.Storage.Container
@using Datahub.Portal.Pages.Workspace.Storage.ResourcePages
@using Microsoft.Extensions.Options
@using Microsoft.FeatureManagement
@using Microsoft.Graph.Models;
@using Microsoft.Identity.Client
@using Microsoft.Identity.Web;
@using System.Security.Claims
@using GcdsWrapper.Blazor
@using Microsoft.JSInterop
@using System.Threading

@inject IJSRuntime StorageJsRuntime
@inject MicrosoftIdentityConsentAndConditionalAccessHandler _consentHandler
@inject IDbContextFactory<DatahubProjectDBContext> _dbFactoryProject
@inject IUserInformationService _userInformationService
@inject IUserTokenCredentialService _userTokenCredentialService
@inject IProjectStorageConfigurationService _projectStorageConfigService
@inject ILogger<FileExplorerPage> _logger
@inject CloudStorageManagerFactory _cloudStorageManagerFactory
@inject DatahubPortalConfiguration _datahubPortalConfiguration
@inject NavigationManager NavigationManager
@inject IKeyVaultUserService _keyVaultUserService
@inject IFeatureManagerSnapshot featureManager

<!--suppress CssUnresolvedCustomProperty -->
<PageTitle>@_title</PageTitle>

@if (_loading)
{
    <DHLoadingInitializer />
    return;
}
<MudStack>
    <MudStack Row Justify="Justify.SpaceBetween">
        <DHMainContentTitle Title="@Localizer["{0} Storage Explorer", WorkspaceAcronym]" />
    </MudStack>
    <WorkspaceAlerts WorkspaceAcronym="@WorkspaceAcronym" View="@WorkspaceSidebar.SectionViews.Storage" />
    @if (_isProjectKeyEnabled == true)
    {
        <CascadingValue Value="@WorkspaceAcronym" Name="ProjectAcronym">
            <CascadingValue Value="@_project" Name="Project">
                <CascadingValue Value="_user" Name="PortalUser">
                    @if (!_failedToLoadContainers)
                    {
                        <MudStack Class="my-6">
                            <StorageContainerSelector SelectedContainer="_selectedContainer"
                                                      SelectedContainerChanged="SelectContainerAsync"
                                                      CloudContainers="_cloudContainers"
                                                      AllowBringYourOwn="@(_classification != ClassificationType.ProtectedB)"
                                                      Disabled="@(_storageSettings is not null || _removalAccount is not null)"
                                                      FormOpen="@(_storageSettings is not null)"
                                                      RemovalOpen="@(_removalAccount is not null)"
                                                      OnAddProviderClicked="AddCloudStorageAccount"
                                                      OnEditProviderClicked="EditCloudStorageAccount"
                                                      OnRemoveProviderClicked="RemoveCloudStorageAccount" />
                        </MudStack>
                    }
                    <div role="status" aria-live="polite">
                        @if (!string.IsNullOrEmpty(_storageStatus))
                        {
                            <GcdsText>@_storageStatus</GcdsText>
                        }
                    </div>
                    <DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.WorkspaceAdmin" ProjectAcronym="@WorkspaceAcronym">
                        @if (_storageSettings is not null)
                        {
                            <StorageConfigurationForm @key="_storageSettings" ProjectCloudStorage="_storageSettings"
                                                      CloudProvider="_storageProvider" WorkspaceAcronym="@WorkspaceAcronym"
                                                      OnSaved="SaveCloudStorageAccountAsync" OnCancelled="CloseStorageFormAsync" />
                        }
                        @if (_removalAccount is not null)
                        {
                            <StorageAccountRemovalForm AccountName="@_removalAccount.AccountName" OnConfirmed="ConfirmRemoveStorageAsync" OnCancelled="CloseStorageFormAsync" />
                        }
                    </DatahubAuthView>
                    <MudPaper Elevation="0" Class="file-explorer-layout-wrapper py-4 px-6">
                        <MudTabs Elevation="0" ActivePanelIndexChanged="OnActiveTabChanged">
                            <MudTabPanel Text="@(!MultiContainer ? SelectedContainer?.Name : Localizer["Workspace Files"])"
                                         ToolTip="@(!MultiContainer ? SelectedContainer?.Name : Localizer["Workspace files connected to the workspace tools and only accessible with departmental accounts"])"
                                         Icon="fas fa-hdd">
                                @if (_failedToLoadContainers)
                                {
                                    <MudAlert Severity="Severity.Error">
                                        <MudText>@Localizer["Failed to load storage containers"]</MudText>
                                    </MudAlert>
                                }
                                else
                                {
                                    <!-- Search Section -->
                                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
                                        <MudTextField @bind-Value="_searchQuery" Placeholder="@Localizer["Search files or folders"]" Class="mx-2" Adornment="Adornment.End" AdornmentIcon="fas fa-times" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" OnAdornmentClick="ClearSearch" />
                                        <MudButton OnClick="SearchFiles" Color="Color.Primary">@Localizer["Search"]</MudButton>
                                    </MudStack>

                                    @if (IsLoading)
                                    {
                                        <DHLoadingInitializer />
                                    }
                                    else if (_searchPerformed && !_searchResults.Any())
                                    {
                                        <MudText>@Localizer["No results found."]</MudText>
                                    }
                                    else if (_searchPerformed)
                                    {
                                        <SearchResultsExplorer ProjectId=@_projectId
                                                               Container="@_selectedContainer"
                                                               SearchResults="_searchResults" />
                                    }
                                    else
                                    {
                                        <FileExplorer ProjectId=@_projectId Container="@_selectedContainer" />                                        
                                    }

                                }
                            </MudTabPanel>
                            @if (ShouldShowSharedTab)
                            {
                                <MudTabPanel Text="@Localizer["Shared"]" Icon="fas fa-share-alt" ToolTip="Files shared with all external users.">
                                    <MudStack Class="py-6 px-2">
                                        <FileExplorer ProjectId=@_projectId Container="@SharedContainer" />
                                    </MudStack>
                                </MudTabPanel>
                                <MudTabPanel Text="@Localizer["Users"]" Icon="fas fa-person" ToolTip="Files shared with external users. Each external user can only access files within their user folder.">
                                    <MudStack Class="py-6 px-2">
                                        <FileExplorer ProjectId=@_projectId Container="@UsersContainer" />
                                    </MudStack>
                                </MudTabPanel>
                            }
                            <DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.WorkspaceCollaborator"
                                             ProjectAcronym="@WorkspaceAcronym">
                                @if (SelectedContainer is not null && SelectedContainer.StorageManager.AzCopyEnabled && _classification != ClassificationType.ProtectedB)
                                {
                                    <MudTabPanel Text="@Localizer["AzCopy"]" Icon="fas fa-info-circle">
                                        <MudStack Class="py-6 px-2">
                                            <AzCopy Container=@SelectedContainer
                                                    TermsAcknowledged=@_tokenTermsAcknowledged
                                                    OnTermsAccepted=@AgreeToAccessTokenTerms />
                                        </MudStack>
                                    </MudTabPanel>
                                }
                                @if (SelectedContainer is not null && SelectedContainer.StorageManager.DatabrickEnabled)
                                {
                                    <MudTabPanel Text="@Localizer["Databricks Access"]" Icon="fas fa-info-circle">
                                        <MudStack Class="py-6 px-2">
                                            <Databricks Container="@SelectedContainer" />
                                        </MudStack>
                                    </MudTabPanel>
                                }
                                @if (SelectedContainer is not null && SelectedContainer.StorageManager.AzCopyEnabled && _uploaderEnabled && _classification != ClassificationType.ProtectedB)
                                {
                                    <MudTabPanel Text="@Localizer["DataHub Uploader"]" Icon="fas fa-info-circle">
                                        <MudStack Class="py-6 px-2">
                                            <UploaderCode Container=@SelectedContainer
                                                          TermsAcknowledged=@_tokenTermsAcknowledged
                                                          OnTermsAccepted=@AgreeToAccessTokenTerms />
                                        </MudStack>
                                    </MudTabPanel>
                                }
                            </DatahubAuthView>
                        </MudTabs>
                    </MudPaper>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    }
    else
    {
        if (_isProjectKeyEnabled == false)
        {
            <MudPaper Elevation="0" Outlined Class="pa-4">
                <MudText>
                    @Localizer["Access to storage was disabled due to workspace being over budget."]
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Outlined Class="pa-4">
                <MudProgressCircular Color="Color.Default" Indeterminate="true" />
            </MudPaper>
        }
    }
</MudStack>

    @code {

    [Parameter] public required string WorkspaceAcronym { get; set; }
    [Parameter] public bool ElevatedWorkspaceAccessEnabled { get; set; } = false;

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private Datahub_Project? _project;
    private int? _projectId;
    private string _title;

    private List<CloudStorageContainer> _cloudContainers = new();
    private CloudStorageContainer? _selectedContainer;
    private CloudStorageContainer? _workspaceContainer;

    private List<(string Icon, string LabelText, RenderFragment Content)> _tabs = new();
    private PortalUser _user = null!;
    private ClaimsPrincipal? _authenticatedUser;

    private bool _tokenTermsAcknowledged = false;

    private void AgreeToAccessTokenTerms() => _tokenTermsAcknowledged = true;

    private bool _loading = true;
    private bool? _isProjectKeyEnabled;
    private bool _failedToLoadContainers = false;
    private bool MultiContainer => _cloudContainers?.Count > 1;
    private bool _isUserProjectAdmin = false;
    private ProjectCloudStorage? _storageSettings;
    private CloudStorageProviderType _storageProvider;
    private CloudStorageContainer? _removalAccount;
    private string? _storageStatus;
    private string _storageTriggerId = "storage-add-button";
    private string? _storageFocusId;
    private IJSObjectReference? _storageModule;
    private ClassificationType? _classification;

    private string _searchQuery = string.Empty;
    private List<FileSearchResult> _searchResults = new();
    private bool _searchPerformed = false;
    private int _searchVersion;
    private bool IsLoading { get; set; } = false;
    private bool _isEntraUser = false;
    private bool _uploaderEnabled = false;
    private TokenCredential? _credential;
    private readonly CancellationTokenSource _searchCancellationTokenSource = new();
    private bool _hasExternalUsersInWorkspace = false;

    private CloudStorageContainer? UsersContainer => _cloudContainers.FirstOrDefault(c =>
        c.Name.Equals(IWorkspaceStorageManagementService.AzureExternalUsersContainerName, StringComparison.OrdinalIgnoreCase));
    private CloudStorageContainer? SharedContainer => _cloudContainers.FirstOrDefault(c =>
        c.Name.Equals(IWorkspaceStorageManagementService.AzureSharedContainerName, StringComparison.OrdinalIgnoreCase));

    private bool ShouldShowSharedTab =>
        !_loading &&
        !_failedToLoadContainers &&
        _hasExternalUsersInWorkspace &&
        UsersContainer is not null &&
        SharedContainer is not null;

    protected override async Task OnInitializedAsync()
    {
        if (_project != null)
        {
            return;
        }

        // Get authenticated user from authentication state
        var authState = await AuthenticationStateTask;
        _authenticatedUser = authState.User;

        await using var projectContext = await _dbFactoryProject.CreateDbContextAsync();

        _user = await _userInformationService.GetCurrentPortalUserAsync() ?? throw new InvalidOperationException("User is not authenticated");
        _isEntraUser = await _userInformationService.IsEntraUser();
        if (_isEntraUser)
        {
            _isUserProjectAdmin = await _userInformationService.IsUserProjectAdmin(WorkspaceAcronym) ||
                                  await _userInformationService.IsUserProjectWorkspaceLead(WorkspaceAcronym);
        }
        _project = await projectContext.Projects
            .Include(p => p.UserRoles)
            .ThenInclude(ur => ur.PortalUser)
            .ThenInclude(pu => pu.ExternalUser)
            .AsSingleQuery()
            .Where(p => p.Project_Acronym_CD == WorkspaceAcronym)
            .FirstOrDefaultAsync();
        _classification = _project?.Data_Sensitivity;
        _hasExternalUsersInWorkspace = _project?.UserRoles.Any(ur =>
            ur.PortalUser?.ExternalUser is { UserDeactivatedAt: null }) == true;
        _uploaderEnabled = await featureManager.IsEnabledAsync(Features.Storage_Uploader_Feature);

        var acronym = _project?.Project_Acronym_CD;
        _title = $"{acronym} - {Localizer["Storage"]} - {Localizer["MainTitle"]}";
        _projectId = _project?.Project_ID;
        try
        {
            if (_isEntraUser)
            {
                await _keyVaultUserService.AuthenticateWithUserContext();
                var user = await _userInformationService.GetAuthenticatedUser();
                var token = await _userTokenCredentialService.GetUserToken(user, UserTokenService.Storage);
                _credential = _userTokenCredentialService.GetTokenCredentialForUser(UserTokenService.Storage, token);
                _isProjectKeyEnabled = true; // Entra users will authenticate to storage with their user context, so project key is not required for them.
            }
            else
            {
                _isProjectKeyEnabled = await IsProjectKeyEnabled();
                if (_isProjectKeyEnabled == false) throw new Exception("Project key disabled");
                //await keyVaultUserService.AuthenticateWithPortalContext();
            }
            await LoadContainersAsync();
        }
        catch (MsalUiRequiredException e)
        {
            _consentHandler.HandleException(e);
        }
        catch (MicrosoftIdentityWebChallengeUserException e)
        {
            _consentHandler.HandleException(e);
        }
        catch (Azure.RequestFailedException e)
        {
            _logger.LogInformation(e, "Error loading cloud storage connection. Possibly due to Access Key not being set.");
            _failedToLoadContainers = true;
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Error loading cloud storage connection");
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadContainersAsync()
    {
        var previousContainer = _selectedContainer;
        _cloudContainers = new();

        // pick the project storage containers
        var accountName = _projectStorageConfigService.GetProjectStorageAccountName(WorkspaceAcronym);
        AzureCloudStorageManager projectStorageManager;
        if (!_isEntraUser)
        {
            var accountKey = await _projectStorageConfigService.GetProjectStorageAccountKey(WorkspaceAcronym);
            projectStorageManager = new AzureCloudStorageManager(accountName, accountKey);
        }
        else
        {
            projectStorageManager = new AzureCloudStorageManager(accountName, _credential!);
        }

        var containerNames = await projectStorageManager.GetContainersAsync();

        _cloudContainers.AddRange(containerNames.Select(c => new CloudStorageContainer(accountName, c, CloudStorageProviderType.Azure, projectStorageManager)));
        var dbStorage = await GetCloudStorages();
        foreach (var stg in dbStorage.Where(s => s.Enabled || _isUserProjectAdmin))
        {
            try
            {
                var storageManager = await _cloudStorageManagerFactory.CreateCloudStorageManager(WorkspaceAcronym, stg);
                if (storageManager is null)
                {
                    continue;
                }

                containerNames = await storageManager.GetContainersAsync();
                _cloudContainers.AddRange(containerNames.Select(c => new CloudStorageContainer(storageManager, c, stg.Id, stg.Enabled)));
            }
            catch (Exception ex)
            {
                _logger.LogCritical(ex, "Cannot access one or more configured storage containers.");
                try
                {
                    await using var ctx = await _dbFactoryProject.CreateDbContextAsync();
                    ctx.Attach(stg);
                    stg.Enabled = false;
                    await ctx.SaveChangesAsync();
                }
                catch (Exception ex2)
                {
                    _logger.LogCritical(ex2, "Error disabling inaccessible storage containers.");
                }
            }
        }
        _cloudContainers = _cloudContainers.Where(c => c.ContainerName != IWorkspaceStorageManagementService.AzureExternalUploadContainerName).ToList();

        _workspaceContainer = _cloudContainers.FirstOrDefault(c => c.Id is null && c.Enabled && c.ContainerName == IWorkspaceStorageManagementService.AzureDefaultContainerName);
        _selectedContainer = StorageContainerSelection.SelectAfterReload(_cloudContainers, previousContainer, _workspaceContainer);
        ClearSearch();
    }

    private async Task<List<ProjectCloudStorage>> GetCloudStorages()
    {
        await using var ctx = await _dbFactoryProject.CreateDbContextAsync();
        return await ctx.ProjectCloudStorages.AsNoTracking().Where(e => e.ProjectId == _project.Project_ID).ToListAsync();
    }

    private Task AddCloudStorageAccount(CloudStorageProviderType provider)
    {
        if (!_isUserProjectAdmin || _classification == ClassificationType.ProtectedB) return Task.CompletedTask;
        _storageProvider = provider;
        _storageSettings = new ProjectCloudStorage { Enabled = true, Name = $"{WorkspaceAcronym} Storage {provider}", Provider = provider.ToString() };
        OpenStorageForm("storage-add-button", "storage-configuration-heading");
        return Task.CompletedTask;
    }

    private async Task EditCloudStorageAccount(int id)
    {
        if (!_isUserProjectAdmin) return;
        var container = _cloudContainers.FirstOrDefault(c => c.Id == id);
        if (container is null) return;
        await using var context = await _dbFactoryProject.CreateDbContextAsync();
        _storageSettings = await context.ProjectCloudStorages.AsNoTracking().FirstOrDefaultAsync(c => c.Id == id && c.ProjectId == _projectId);
        if (_storageSettings is null) return;
        _storageProvider = container.CloudStorageProvider;
        OpenStorageForm("storage-edit-button", "storage-configuration-heading");
    }

    private void OpenStorageForm(string triggerId, string headingId)
    {
        _removalAccount = null;
        _storageStatus = null;
        _storageTriggerId = triggerId;
        _storageFocusId = headingId;
    }

    private async Task SaveCloudStorageAccountAsync((ProjectCloudStorage Settings, IDictionary<string, string> ConnectionData) result)
    {
        if (!_isUserProjectAdmin || _projectId is null) throw new InvalidOperationException("Storage administration is not authorized");
        var (settings, connectionData) = result;
        if (settings.Id == 0 && _classification == ClassificationType.ProtectedB) throw new InvalidOperationException("External storage is not permitted");
        await using var context = await _dbFactoryProject.CreateDbContextAsync();
        ProjectCloudStorage account;
        if (settings.Id == 0)
        {
            account = new ProjectCloudStorage { ProjectId = _projectId.Value, Provider = settings.Provider, Name = settings.Name, Enabled = settings.Enabled };
            context.ProjectCloudStorages.Add(account);
            await context.SaveChangesAsync();
            // Retain the ID so a Key Vault failure can be retried without adding a second account.
            settings.Id = account.Id;
        }
        else
        {
            account = await context.ProjectCloudStorages.FirstOrDefaultAsync(c => c.Id == settings.Id && c.ProjectId == _projectId)
                ?? throw new InvalidOperationException("Storage account no longer exists");
            account.Name = settings.Name;
            account.Enabled = settings.Enabled;
        }
        await _keyVaultUserService.StoreAllSecrets(account, WorkspaceAcronym, connectionData);
        await context.SaveChangesAsync();
        await LoadContainersAsync();
        _storageStatus = Localizer["Storage configuration saved"];
        await CloseStorageFormAsync();
    }

    private Task RemoveCloudStorageAccount(int id)
    {
        if (!_isUserProjectAdmin) return Task.CompletedTask;
        _removalAccount = _cloudContainers.FirstOrDefault(c => c.Id == id);
        _storageSettings = null;
        _storageStatus = null;
        _storageTriggerId = "storage-remove-button";
        _storageFocusId = "storage-removal-heading";
        return Task.CompletedTask;
    }

    private async Task ConfirmRemoveStorageAsync()
    {
        if (!_isUserProjectAdmin || _removalAccount?.Id is not int id) throw new InvalidOperationException("Storage administration is not authorized");
        await using var context = await _dbFactoryProject.CreateDbContextAsync();
        var account = await context.ProjectCloudStorages.FirstOrDefaultAsync(c => c.Id == id && c.ProjectId == _projectId);
        if (account is not null)
        {
            await _keyVaultUserService.DeleteAllSecrets(account, WorkspaceAcronym);
            context.ProjectCloudStorages.Remove(account);
            await context.SaveChangesAsync();
        }
        await LoadContainersAsync();
        _storageStatus = Localizer["Storage account removed"];
        await CloseStorageFormAsync();
    }

    private Task CloseStorageFormAsync()
    {
        _storageSettings = null;
        _removalAccount = null;
        _storageFocusId = _storageTriggerId;
        return Task.CompletedTask;
    }

    private Task SelectContainerAsync(CloudStorageContainer container)
    {
        _selectedContainer = container;
        ClearSearch();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_storageFocusId is null) return;
        var focusId = _storageFocusId;
        _storageFocusId = null;
        try
        {
            _storageModule ??= await StorageJsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/Workspace/Storage/FileExplorerPage.razor.js");
            await _storageModule.InvokeVoidAsync("focusStorageElement", focusId);
        }
        catch (JSDisconnectedException) { }
    }

    private async Task<bool> IsProjectKeyEnabled()
    {
        return await _keyVaultUserService.IsKeyEnabled(WorkspaceAcronym, _datahubPortalConfiguration.KeyVault.ProjectKey);
    }

    public CloudStorageContainer? SelectedContainer
    {
        get => _selectedContainer;
        set => _selectedContainer = value;
    }

    private void OnActiveTabChanged(int index)
    {
        // Tab indices: 0 = Workspace Files, 1 = Shared, 2 = Users (when ShouldShowSharedTab is true)
        if (!ShouldShowSharedTab)
        {
            return;
        }

        ClearSearch();
        _selectedContainer = index switch
        {
            1 => SharedContainer ?? _selectedContainer,
            2 => UsersContainer ?? _selectedContainer,
            _ => _workspaceContainer ?? _selectedContainer
        };
    }

    private void ClearSearch()
    {
        _searchVersion++;
        IsLoading = false;
        _searchQuery = string.Empty;
        _searchResults = new();
        _searchPerformed = false;
    }

    private async Task SearchFiles()
    {
        var container = SelectedContainer;
        var searchVersion = ++_searchVersion;
        if (container is null || string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults = new();
            _searchPerformed = true;
            return;
        }

        IsLoading = true;
        try
        {
            var results = await container.StorageManager.SearchFilesAsync(
                container.ContainerName,
                string.Empty,
                _searchQuery,
                _searchCancellationTokenSource.Token,
                false);

            if (searchVersion != _searchVersion) return;
            _searchResults = results
                .Select(file => new FileSearchResult
                {
                    Name = file.filename.Split('/').Last(),
                    Path = string.Join("/", file.filename.Split('/').SkipLast(1))
                })
                .ToList();
        }
        catch (OperationCanceledException) when (_searchCancellationTokenSource.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error searching files");
            if (searchVersion == _searchVersion) _searchResults = new();
        }
        finally
        {
            if (searchVersion == _searchVersion)
            {
                IsLoading = false;
                _searchPerformed = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _searchCancellationTokenSource.Cancel();
        _searchCancellationTokenSource.Dispose();
        if (_storageModule is not null)
        {
            try { await _storageModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
