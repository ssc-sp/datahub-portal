@using Datahub.Core.Storage
@using GcdsWrapper.Blazor

<section aria-label="@Localizer["Storage selection"]">
    <GcdsText id="storage-current-container" role="status" aria-live="polite">
        <strong>@Localizer["Current Container"]: </strong>
        @if (SelectedContainer is not null)
        {
            @Localizer[SelectedContainer.CloudStorageProvider.ToString()] <text> - @SelectedContainer.AccountName - @SelectedContainer.ContainerName</text>
        }
    </GcdsText>
    <div class="d-flex flex-wrap gap-4 align-start">
        @if (Accounts.Count > 1)
        {
            <GcdsSelect Id="storage-account-select" Name="storage-account-select" Label="@Localizer["Storage account"]"
                        Disabled="@Disabled" @bind-Value:get="_accountKey" @bind-Value:set="ChangeAccountAsync">
                @foreach (var account in Accounts)
                {
                    <option value="@AccountKey(account)">@Localizer[account.CloudStorageProvider.ToString()] — @account.AccountName</option>
                }
            </GcdsSelect>
        }
        @if (CurrentAccount is not null)
        {
            <GcdsSelect Id="storage-container-select" Name="storage-container-select" Label="@Localizer["Container"]"
                        Disabled="@(Disabled || !AccountContainers.Any(container => container.Enabled))"
                        DefaultValue="@Localizer["Please Select"]" @bind-Value:get="ContainerValue" @bind-Value:set="ChangeContainerAsync">
                @foreach (var container in AccountContainers)
                {
                    <option value="@container.ContainerName" disabled="@(!container.Enabled)">@container.ContainerName</option>
                }
            </GcdsSelect>
        }
    </div>
    <DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.WorkspaceAdmin" ProjectAcronym="@ProjectAcronymParam">
        <div class="d-flex flex-wrap gap-4 mt-4">
            @if (AllowBringYourOwn)
            {
                <GcdsButton Id="storage-add-button" Type="GcdsButtonType.Button" Disabled="@Disabled"
                            aria-expanded="@(FormOpen ? "true" : "false")" aria-controls="storage-configuration-form"
                            OnClick="AddAsync">@Localizer["Add storage container"]</GcdsButton>
            }
            @if (CurrentAccount?.Id is int id)
            {
                <GcdsButton Id="storage-edit-button" Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" Disabled="@Disabled"
                            aria-expanded="@(FormOpen ? "true" : "false")" aria-controls="storage-configuration-form"
                            OnClick="@(() => OnEditProviderClicked.InvokeAsync(id))">@Localizer["Edit account"]</GcdsButton>
                <GcdsButton Id="storage-remove-button" Type="GcdsButtonType.Button" Role="GcdsButtonRole.Danger" Disabled="@Disabled"
                            aria-expanded="@(RemovalOpen ? "true" : "false")" aria-controls="storage-removal-confirmation"
                            OnClick="@(() => OnRemoveProviderClicked.InvokeAsync(id))">@Localizer["Remove account"]</GcdsButton>
            }
        </div>
    </DatahubAuthView>
</section>

@code {
    [CascadingParameter(Name = "ProjectAcronym")] public required string ProjectAcronymParam { get; set; }
    [Parameter] public required IEnumerable<CloudStorageContainer> CloudContainers { get; set; }
    [Parameter] public CloudStorageContainer? SelectedContainer { get; set; }
    [Parameter] public bool AllowBringYourOwn { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FormOpen { get; set; }
    [Parameter] public bool RemovalOpen { get; set; }
    [Parameter] public EventCallback<CloudStorageContainer> SelectedContainerChanged { get; set; }
    [Parameter] public EventCallback<CloudStorageProviderType> OnAddProviderClicked { get; set; }
    [Parameter] public EventCallback<int> OnEditProviderClicked { get; set; }
    [Parameter] public EventCallback<int> OnRemoveProviderClicked { get; set; }

    private string? _accountKey;
    private CloudStorageContainer? _lastSelectedContainer;
    private List<CloudStorageContainer> Accounts => CloudContainers.DistinctBy(AccountKey).ToList();
    private CloudStorageContainer? CurrentAccount => Accounts.FirstOrDefault(account => AccountKey(account) == _accountKey);
    private IEnumerable<CloudStorageContainer> AccountContainers => CloudContainers.Where(container => AccountKey(container) == _accountKey);
    private string? ContainerValue => SelectedContainer is not null && AccountKey(SelectedContainer) == _accountKey ? SelectedContainer.ContainerName : null;

    private static string AccountKey(CloudStorageContainer container) => StorageContainerSelection.AccountKey(container);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastSelectedContainer, SelectedContainer) || !Accounts.Any(account => AccountKey(account) == _accountKey))
        {
            _accountKey = SelectedContainer is not null ? AccountKey(SelectedContainer) : Accounts.FirstOrDefault() is { } account ? AccountKey(account) : null;
            _lastSelectedContainer = SelectedContainer;
        }
    }

    private async Task ChangeAccountAsync(string? key)
    {
        if (Disabled || !Accounts.Any(account => AccountKey(account) == key)) return;
        _accountKey = key;
        var container = AccountContainers.FirstOrDefault(container => container.Enabled);
        if (container is not null) await SelectedContainerChanged.InvokeAsync(container);
    }

    private Task ChangeContainerAsync(string? name)
    {
        var container = AccountContainers.FirstOrDefault(container => container.ContainerName == name && container.Enabled);
        return Disabled || container is null ? Task.CompletedTask : SelectedContainerChanged.InvokeAsync(container);
    }

    private Task AddAsync() => Disabled || !AllowBringYourOwn ? Task.CompletedTask : OnAddProviderClicked.InvokeAsync(CloudStorageProviderType.Azure);
}
