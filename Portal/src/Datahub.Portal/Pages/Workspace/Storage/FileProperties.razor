@*FileProperties.razor*@
@using Azure.Storage.Blobs.Models;
@using Datahub.Core.Components.Code
@using Datahub.Core.Model.Projects
@using Datahub.Core.Services.Api;
@using Datahub.Metadata.Model
@using Datahub.Application.Services
@using Datahub.Core.Storage;
@using Datahub.Infrastructure.Services.Api
@using Datahub.Infrastructure.Services.Storage
@using Datahub.Portal.Components.User
@using Datahub.Shared.Entities

@inject CommonAzureServices _commonAzureServices;
@inject MudBlazor.IDialogService DialogService;
@inject Microsoft.FeatureManagement.IFeatureManagerSnapshot FeatureManager;

@if (File != null)
{
    <div class="storage-properties">
        <div class="title-container">
            <i class="@DatahubTools.GetFileTypeIcon(File.fileformat)"></i>
            <MudText Typo="Typo.h3" class="details-title-text">
                @Path.GetFileName(File.name)
            </MudText>
        </div>

        @if (StorageTier == AccessTier.Archive.ToString())
        {
            <DHAlert Severity="Severity.Info">
                <MudText Typo="Typo.h5">@Localizer["Archived Storage"]</MudText>
                <MudText Class="my-3">@Localizer["This file is currently in an archive storage tier for long-term storage."]</MudText>
                <MudText>@Localizer["To download or edit this file, you must first change the storage tier. This can take several hours to process."]</MudText>
            </DHAlert>
        }

        @if (StorageManager.ProviderType == CloudStorageProviderType.AWS)
        {
            <div role="status" aria-live="polite">
                @if (_archiveStatus != null && (_archiveStatus.State != CloudStorageArchiveState.Available || StorageTier is "GLACIER" or "DEEP_ARCHIVE"))
                {
                    <DHAlert Severity="Severity.Info">
                        <MudText Typo="Typo.h5">@Localizer["Archived Storage"]</MudText>
                        <MudText Class="my-3">@Localizer["This file is currently in an archive storage tier for long-term storage."]</MudText>
                        <MudText>@Localizer[_archiveStatus.State switch
                        {
                            CloudStorageArchiveState.RestoreRequired => "Restore this file through AWS tooling before downloading it or changing its storage class.",
                            CloudStorageArchiveState.Restoring => "Restoration is in progress. Refresh the status after AWS completes the restoration.",
                            _ => "This file is available for download and storage class changes."
                        }]</MudText>
                        @if (_archiveStatus.RestoredCopyExpiry is DateTime expiry)
                        {
                            <MudText>@Localizer["The restored copy is available until {0} (UTC).", expiry.ToUniversalTime().ToString("u")]</MudText>
                        }
                        <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" Disabled="@_refreshingArchive" OnClick="RefreshArchiveStatusAsync">@Localizer["Refresh archive status"]</GcdsButton>
                    </DHAlert>
                }
            </div>
            @if (_archiveError != null)
            {
                <div role="alert"><GcdsText>@_archiveError</GcdsText></div>
            }
            @if (_archiveError != null)
            {
                <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" Disabled="@_refreshingArchive" OnClick="RefreshArchiveStatusAsync">@Localizer["Refresh archive status"]</GcdsButton>
            }
        }

        @if (_workspaceStorageMetadataEnabled)
        {
            <FileMetadataEditor
                EditMode=false
                ContainerName=@ContainerName
                FileName=@_fullFileName
                StorageManager=@StorageManager
                ProjectAcronym=@ProjectAcronym
            />
        }

        <div class="properties">
            <MudText class="properties-title" Typo="Typo.h4">@Localizer["Storage Properties"]</MudText>
            <MudText class="label">
                @Localizer["Storage Tier"]
                <MudIconButton Icon="@Icons.Material.Filled.Help" Size="Size.Small" Class="ml-1" Href="@Localizer["http://documentation.sds.canada.ca/en/storage/Storage-Tiers.html"]" Target="_blank" />
            </MudText>
            <MudText class="text">@Localizer[AWSCloudStorageManager.GetStorageClassLabel(StorageTier)]</MudText>
            @foreach (var (key, value) in _properties)
            {
                if (!string.IsNullOrEmpty(value) && value != "[]")
                {
                    <MudText class="label">@Localizer[key]</MudText>
                    <MudText class="text">@value</MudText>
                }
            }

            @if (_classification != ClassificationType.ProtectedB)
            {
                <MudText class="label">@Localizer["Power BI URL"]</MudText>
                <InlineCodeWithCopy>@_powerBiPasteText</InlineCodeWithCopy>
                <MudText class="label">@Localizer["File URL"]</MudText>
                <InlineCodeWithCopy>@_fileLinkUrl</InlineCodeWithCopy>
            }            

            <MudText class="label">@Localizer["Access from Databricks"]</MudText>
            <InlineCodeWithCopy>@_databricksPasteText</InlineCodeWithCopy>

        </div>
    </div>
}


@code {

    [CascadingParameter(Name = "ProjectAcronym")]
    public string ProjectAcronym { get; set; } = null!;

    [CascadingParameter(Name = "StorageAccountMetadata")]
    public StorageMetadata StorageAccountMetadata { get; set; } = null!;

    [CascadingParameter(Name = "Project")]
    public required Datahub_Project Project { get; set; }

    [Parameter]
    public int? ProjectId { get; set; }

    [Parameter]
    public FileMetadata File { get; set; }

    [Parameter]
    public string ContainerName { get; set; } = "datahub";

    [Parameter]
    public string FolderName { get; set; }

    [Parameter]
    public EventCallback OnMetadataChanged { get; set; }

    [Parameter]
    public ICloudStorageManager StorageManager { get; set; }

    [Parameter]
    public EventCallback OnArchiveStatusChanged { get; set; }

    private CloudStorageArchiveStatus? _archiveStatus;
    private string? _archiveError;
    private bool _refreshingArchive;
    private ICloudStorageManager? _archiveManager;
    private string? _archivePath;
    private string? _archiveTier;
    private string? _archiveContainer;
    private int _archiveRefreshVersion;

    private async Task RefreshArchiveStatusAsync()
    {
        if (_refreshingArchive) return;
        await LoadArchiveStatusAsync();
        await OnArchiveStatusChanged.InvokeAsync();
    }

    private async Task LoadArchiveStatusAsync()
    {
        if (StorageManager.ProviderType != CloudStorageProviderType.AWS)
            return;
        var manager = StorageManager;
        var path = _fullFileName.TrimStart('/');
        var container = ContainerName;
        var version = ++_archiveRefreshVersion;
        _refreshingArchive = true;
        _archiveError = null;
        _archiveStatus = null;
        try
        {
            var status = await manager.GetFileArchiveStatusAsync(container, path);
            if (ReferenceEquals(manager, StorageManager) && path == _fullFileName.TrimStart('/')
                && container == ContainerName && version == _archiveRefreshVersion)
                _archiveStatus = status;
        }
        catch
        {
            if (version == _archiveRefreshVersion)
                _archiveError = Localizer["Unable to read AWS archive status. Please try again."];
        }
        finally
        {
            if (version == _archiveRefreshVersion) _refreshingArchive = false;
        }
    }

    private List<(string, string)> _properties;
    private string _powerBiPasteText;
    private string _fileLinkUrl;
    private string _databricksPasteText;
    private string _fullFileName;
    private ClassificationType _classification;
    private bool _workspaceStorageMetadataEnabled;

    [Parameter]
    public string StorageTier { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _workspaceStorageMetadataEnabled = await FeatureManager.IsEnabledAsync(Features.Workspace_Storage_Metadata_Feature);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (File == null)
            return;

        // Generate the correct path dynamically without modifying File.folderpath
        var effectiveFolderPath = GenerateEffectiveFolderPath();

        _properties = File.GetMetadataProperties()
            .Where(p => p.IsVisible)
            .Select(p => (p.Key, Value: File.GetMetadataPropertyValue(p.Key)))
            .ToList();

        var fullFilePath = $"{File.folderpath}/{File.filename}".Replace("//","/").TrimStart('/');
        if (StorageAccountMetadata is AzureStorageMetadata azureStorageMetadata && !string.IsNullOrEmpty(azureStorageMetadata.Url))
        {
            var accountName = azureStorageMetadata.Url.Split('.')[0].Replace("https://", "");
            _fileLinkUrl = $"{azureStorageMetadata.Url}/{effectiveFolderPath}/{File.filename}".Replace("//", "/");
            _powerBiPasteText = $"abfs://{_commonAzureServices.FileSystemName}@{accountName}.dfs.core.windows.net/{effectiveFolderPath}/{File.filename}".Replace("//", "/");
        }
        if (!string.IsNullOrEmpty(fullFilePath))
        {
            _databricksPasteText = $"/mnt/fsdh-dbk-main-mount/{fullFilePath}";
        }
        _classification = Project.Data_Sensitivity;
        var fileFolder = StorageManager.ProviderType == CloudStorageProviderType.AWS && FolderName != null
            ? FolderName : File.folderpath;
        _fullFileName = $"{fileFolder?.TrimEnd('/')}/{File.filename}".TrimStart('/');
        if (!ReferenceEquals(_archiveManager, StorageManager) || _archivePath != _fullFileName
            || _archiveTier != StorageTier || _archiveContainer != ContainerName)
        {
            _archiveManager = StorageManager;
            _archivePath = _fullFileName;
            _archiveTier = StorageTier;
            _archiveContainer = ContainerName;
            _archiveStatus = null;
            await LoadArchiveStatusAsync();
        }
    }

    private string GenerateEffectiveFolderPath()
    {
        if (string.IsNullOrEmpty(FolderName) || FolderName == "/")
        {
            return "/";
        }

        return $"{FolderName}/{File.folderpath}".Replace("//", "/");
    }
}

