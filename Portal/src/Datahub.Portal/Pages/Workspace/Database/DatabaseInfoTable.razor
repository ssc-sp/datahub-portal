@using Datahub.Portal.Model
<MudText Typo="Typo.h2" Class="mt-6">
    @Localizer["Database Information"]
</MudText>
<MudSimpleTable Dense Hover Striped Outlined>
    <thead>
    <tr>
        <th><strong>@Localizer["Property"]</strong></th>
        <th><strong>@Localizer["Value"]</strong></th>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Localizer["SKU"]
            </td>
            <td>
                <code>@dbServer?.SKU</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["InstanceType"]
            </td>
            <td>
                <code>@dbServer?.Type</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["vCores"]
            </td>
            <td>
                <code>@dbServer?.vCores</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["Memory Size"]
            </td>
            <td>
                <code>@dbServer?.MemorySize</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["MaxIOPS"]
            </td>
            <td>
                <code>@dbServer?.MaxIOPS</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["MaxBandwidth"]
            </td>
            <td>
                <code>@dbServer?.MaxBandwidth</code>
            </td>
        </tr>
        <tr>
            <td>
                @Localizer["Storage Size"]
            </td>
            <td>
                <code>@dbServer?.StorageSize</code>
            </td>
        </tr>
    <tr>
        <td>
            @Localizer["Host"]
        </td>
        <td>
                <code>@dbServer?.DatabaseHost</code>
        </td>
    </tr>
    <tr>
        <td>
            @Localizer["Database Name"]
        </td>
        <td>
                <code>@dbServer?.DatabaseName</code>
        </td>
    </tr>
    <tr>
        <td>
            @Localizer["Username"]
        </td>
        <td>
                <code>@dbServer?.Username</code>
        </td>
    </tr>
    <tr>
        <td>
            @Localizer["Password"]
        </td>
        <td>
                <code>@dbServer?.Password</code>
        </td>
    </tr>
    <tr>
        <td>
            @Localizer["Port"]
        </td>
        <td>
                <code>@dbServer?.Port</code>
        </td>
    </tr>
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public AzureDBServer dbServer { get; set; }
}