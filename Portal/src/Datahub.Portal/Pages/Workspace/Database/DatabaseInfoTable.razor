@using Datahub.Portal.Model
@using GcdsWrapper.Blazor

<GcdsHeading Tag="h2" MarginTop="0">@Localizer["Database Information"]</GcdsHeading>
@if (dbServer is not null)
{
    <GcdsTable Columns="@Columns"
               Data="@Rows"
               Filter="false"
               Sort="false"
               Pagination="false">
        <span slot="caption" class="sr-only">@Localizer["Database Information"]</span>
    </GcdsTable>
}

@code {
    [Parameter]
    public AzurePgsqlDBServer dbServer { get; set; }

    private IReadOnlyCollection<TableColumn> Columns =>
    [
        new("property", Localizer["Property"], true),
        new("value", Localizer["Value"])
    ];

    private IReadOnlyCollection<IReadOnlyDictionary<string, string>> Rows =>
    [
        CreateRow(Localizer["SKU"], dbServer.PostgresTier.SKUName),
        CreateRow(Localizer["Instance Type"], dbServer.PostgresTier.Type),
        CreateRow(Localizer["vCores"], dbServer.PostgresTier.Cores.ToString()),
        CreateRow(Localizer["Memory Size"], dbServer.PostgresTier.MemorySize),
        CreateRow(Localizer["MaxIOPS"], dbServer.PostgresTier.MaxIOPS.ToString()),
        CreateRow(Localizer["MaxBandwidth"], dbServer.PostgresTier.MaxBandwidth),
        CreateRow(Localizer["Storage Size"], dbServer.StorageSize.ToString()),
        CreateRow(Localizer["Host"], dbServer.DatabaseHost),
        CreateRow(Localizer["Database Name"], dbServer.DatabaseName),
        CreateRow(Localizer["Username"], dbServer.Username),
        CreateRow(Localizer["Password"], dbServer.Password),
        CreateRow(Localizer["Port"], dbServer.Port)
    ];

    private static IReadOnlyDictionary<string, string> CreateRow(string property, string value) =>
        new Dictionary<string, string>
        {
            ["property"] = property,
            ["value"] = value
        };

    private sealed record TableColumn(string Field, string Header, bool RowHeader = false);
}
