@using System.Net
@using GcdsWrapper.Blazor

@inject IHttpContextAccessor _httpContextAccessor
@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject DatahubPortalConfiguration _portalConfiguration
@inject ISnackbar _snackbar
@inject ILogger<DatabaseIpWhitelistTable> _logger
@inject IUserInformationService _userInformationService

<MudStack>
    <MudText Typo="Typo.h2" Class="mt-6">
        @Localizer["Database Firewall Rules"]
    </MudText>
    <MudText>
        @Localizer["The following IP addresses are whitelisted for the database. Names must be unique and can only contain letters, numbers, underscores and hyphens."]
    </MudText>
    <MudAlert Severity="Severity.Info">
        @Localizer["Changes to the firewall rules can take up to 15 minutes to apply."]
    </MudAlert>
    <MudStack Row>
        <DHButton OnClick="@AddCurrentIpAddress" Disabled="@(_userIpAddress is null || _savingRule)">
            @Localizer["Add current IP address ({0})", _userIpAddress]
        </DHButton>
        <DHButton OnClick="@StartAddingIpRange" Disabled="@_savingRule">
            @Localizer["Add a new IP address"]
        </DHButton>
        <MudSpacer />
    </MudStack>
</MudStack>

<MudText Typo="Typo.h3" Class="mt-6">
    @Localizer["Database IP Address Whitelist"]
</MudText>

<GcdsTable Columns="@Columns"
           Data="@Rows"
           Filter="true"
           Sort="true"
           Pagination="false"
           class="mt-6">
    <span slot="caption" class="sr-only">@Localizer["Database IP Address Whitelist"]</span>
</GcdsTable>

<MudStack Row Class="mt-6 mb-12" AlignItems="AlignItems.End">
    <GcdsSelect Id="firewall-rule-select"
                Name="firewall-rule-select"
                Label="@Localizer["Select a firewall rule"]"
                DefaultValue="@Localizer["Please Select"]"
                Disabled="@(!_firewallRules.Any() || _savingRule)"
                @bind-Value="_selectedRuleName">
        @foreach (var rule in _firewallRules)
        {
            <option value="@rule.Name">@rule.Name</option>
        }
    </GcdsSelect>
    <GcdsButton Type="GcdsButtonType.Button"
                Role="GcdsButtonRole.Secondary"
                OnClick="@StartEditingSelectedIpRange"
                Disabled="@(SelectedRule is null || _savingRule)">
        @Localizer["Edit"]
    </GcdsButton>
    <GcdsButton Type="GcdsButtonType.Button"
                Role="GcdsButtonRole.Danger"
                OnClick="@DeleteSelectedIpAddress"
                Disabled="@(SelectedRule is null || _savingRule)">
        @Localizer["Delete"]
    </GcdsButton>
    <MudSpacer />
</MudStack>

@if (_ruleFormMode is not RuleFormMode.None)
{
    <section role="region" aria-labelledby="firewall-rule-form-heading" class="mb-12">
        <GcdsHeading Id="firewall-rule-form-heading" Tag="h3">
            @Localizer[_ruleFormMode is RuleFormMode.Add ? "Add IP Address or Range" : "Edit IP Address or Range"]
        </GcdsHeading>
        @if (_ruleFormMode is RuleFormMode.Edit)
        {
            <GcdsInput Id="firewall-rule-name"
                       Name="firewall-rule-name"
                       Label="@Localizer["Name"]"
                       Required
                       Disabled="@_savingRule"
                       @bind-Value="_ruleName" />
        }
        <GcdsInput Id="firewall-rule-start-ip"
                   Name="firewall-rule-start-ip"
                   Label="@Localizer["Start IP Address"]"
                   Required
                   Disabled="@_savingRule"
                   @bind-Value="_startIpAddress" />
        <GcdsInput Id="firewall-rule-end-ip"
                   Name="firewall-rule-end-ip"
                   Label="@Localizer["End IP Address"]"
                   Disabled="@_savingRule"
                   @bind-Value="_endIpAddress" />
        @if (!string.IsNullOrWhiteSpace(_ruleFormError))
        {
            <GcdsErrorMessage MessageId="firewall-rule-form-error">
                @_ruleFormError
            </GcdsErrorMessage>
        }
        <GcdsButton Type="GcdsButtonType.Button"
                    OnClick="@SaveIpRange"
                    Disabled="@_savingRule">
            @Localizer["Save"]
        </GcdsButton>
        <GcdsButton Type="GcdsButtonType.Button"
                    Role="GcdsButtonRole.Secondary"
                    OnClick="@CancelIpRangeForm"
                    Disabled="@_savingRule">
            @Localizer["Cancel"]
        </GcdsButton>
    </section>
}

@code {

    [Parameter, EditorRequired]
    public string WorkspaceAcronym { get; set; }

    private IPAddress? _userIpAddress;
    private string? _selectedRuleName;
    private List<WhitelistIPAddressData> _firewallRules = [];
    private RuleFormMode _ruleFormMode;
    private string _ruleName = string.Empty;
    private string _startIpAddress = string.Empty;
    private string _endIpAddress = string.Empty;
    private string _editingOriginalName = string.Empty;
    private string _ruleFormError = string.Empty;
    private bool _savingRule;

    private WhitelistIPAddressData? SelectedRule =>
        _firewallRules.FirstOrDefault(rule => rule.Name == _selectedRuleName);

    private IReadOnlyCollection<TableColumn> Columns =>
    [
        new("name", Localizer["Name"], true),
        new("startIpAddress", Localizer["Start IP Address"]),
        new("endIpAddress", Localizer["End IP Address"])
    ];

    private IReadOnlyCollection<IReadOnlyDictionary<string, string>> Rows => _firewallRules
        .Select(rule => (IReadOnlyDictionary<string, string>)new Dictionary<string, string>
        {
            ["name"] = rule.Name,
            ["startIpAddress"] = rule.StartIPAddress?.ToString() ?? string.Empty,
            ["endIpAddress"] = rule.EndIPAddress?.ToString() ?? string.Empty
        })
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            var postgresResource = await BuildPostgresSqlFlexibleServerResource();

            await foreach (var firewallRule in postgresResource.GetPostgreSqlFlexibleServerFirewallRules())
            {
                _firewallRules.Add(new WhitelistIPAddressData(firewallRule.Data));
            }
        }
        catch (Exception x)
        {
            _logger.LogWarning(x, "Unable to load database firewall rules for workspace {WorkspaceAcronym}", WorkspaceAcronym);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (!firstRender)
        {
            return;
        }

        _userIpAddress = _httpContextAccessor?.HttpContext?.Connection.RemoteIpAddress;

        StateHasChanged();
    }

    private sealed record TableColumn(string Field, string Header, bool RowHeader = false);

    private enum RuleFormMode
    {
        None,
        Add,
        Edit
    }
}
