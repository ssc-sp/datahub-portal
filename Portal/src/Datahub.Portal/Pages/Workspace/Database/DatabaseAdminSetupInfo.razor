@using GcdsWrapper.Blazor

<GcdsHeading Tag="h2">@Localizer["Add Users to Database"]</GcdsHeading>
<GcdsText>
    @Localizer["The default postgres user should only be used for administrative tasks. You should create a new user for users in your workspace."]
</GcdsText>
<MudStack>
    <GcdsButton Type="GcdsButtonType.Link" Href="@Localizer[PageRoutes.ResourceSite_AddUserPostgres]" Target="_blank">
        @Localizer["Learn how to create a user in PostgreSQL"]
    </GcdsButton>
</MudStack>

@code {
    private bool _expanded = false;

    private void OnExpandCollapseClick()
    {
        _expanded = !_expanded;
    }
}
