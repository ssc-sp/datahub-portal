@using System.ComponentModel.DataAnnotations
@using System.Net.Mail
@using Datahub.Application.Commands
@using Datahub.Application.Services
@using Datahub.Application.Services.UserManagement
@using Datahub.Core.Model.Achievements
@using Datahub.Core.Model.Projects
@using Datahub.Core.Model.Users
@using GcdsWrapper.Blazor
@inject IMSGraphService _msGraphService
@inject IUserEnrollmentService _userEnrollmentService
@inject IUserInformationService _userInformationService
@inject IDbContextFactory<DatahubProjectDBContext> _dbFactory

<MudDialog Style="min-width: 40vw; max-width: 75vw;">
    <DialogContent>
        <MudStack>
          <MudText>@Localizer["Please provide a reason for deactivating the user."]</MudText>
            <MudTextField T="string"
                          Class="form-control"
                          @bind-value="_reasonForDeactivating"
                          Label=@Localizer["Deactivation reason"]
                          Required="true"
                          RequiredError=@Localizer["Deactivation reason is required"]
                          Variant="Variant.Outlined" HelperText=@Localizer["e.g. User is not needed for project"] />

        </MudStack>
    </DialogContent>
    <DialogActions>
      <MudGrid>
        <MudItem xs="6" class="d-flex justify-start">
            <GcdsButton Id="@CancelButtonId" Type="GcdsButtonType.Button" Size="GcdsButtonSize.Small" Role="GcdsButtonRole.Danger"
                                OnClick="Cancel">
                @Localizer["Cancel"]
            </GcdsButton>
        </MudItem>
        <MudItem xs="6" class="d-flex justify-end">
            <GcdsButton Id="@SaveChangesButtonId" Type="GcdsButtonType.Button" Size="GcdsButtonSize.Small" Role="GcdsButtonRole.Primary"
                            Disabled="(_reasonForDeactivating == (String.Empty))" OnClick="SaveUserChanges">
                @Localizer["Deactivate user"]
            </GcdsButton>
        </MudItem>
      </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    #nullable enable
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public UserRoleLinks SelectedUser { get; set; } = null!;

    [Parameter]
    public PortalUser CurrentUser { get; set; } = null!;

    private const string CancelButtonId = "cancel-button";
    private const string SaveChangesButtonId = "save-changes-button";

    private string _reasonForDeactivating = string.Empty;

    private void Cancel() => MudDialog.Cancel();


    private async Task SaveUserChanges()
    {
        await using var context = await _dbFactory.CreateDbContextAsync();

        var userRoleLinks = context.UserRolesLinks.Where(p => p.ProjectUser_ID == SelectedUser.ProjectUser_ID).Include(u => u.PortalUser).ThenInclude(u => u.ExternalUser).ToList();

        var currentUser = await context.PortalUsers
        .FirstOrDefaultAsync(p => p.Id == CurrentUser.Id);

        foreach (var userRoleLink in userRoleLinks)
        {
            if (userRoleLink.PortalUser.ExternalUser != null)
            {
                userRoleLink.PortalUser.ExternalUser.UserDeactivatedAt = DateTime.Now;
                userRoleLink.PortalUser.ExternalUser.DeactivationReason = _reasonForDeactivating;
                userRoleLink.PortalUser.ExternalUser.DeactivatedByUser = currentUser;

                context.Update(userRoleLink);
            }
        }
        await context.SaveChangesAsync();
        UpdateProject();
    }

    private void UpdateProject()
    {
        MudDialog.Close(DialogResult.Ok(SelectedUser));
    }

}
