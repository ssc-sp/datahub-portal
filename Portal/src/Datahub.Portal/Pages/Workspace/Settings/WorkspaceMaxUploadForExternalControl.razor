@using Datahub.Portal.Pages.Account

<SettingsField 
    Label="@Localizer["Maximum File Upload Size for External Users"]" 
    Description="@Localizer["The maximum file size, in MB, that can be uploaded by external users. Note: Setting this to 0 will prevent external users from uploading any files."]">
    <MudElement Style="max-width: 300px; display: block">
        <MudTextField T="long" Disabled="@Disabled" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@_maxUploadSize" ValueChanged="@OnValueChanged"/>
    </MudElement>
</SettingsField>

@code {

    [Parameter, EditorRequired] public long InitialValue { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter, EditorRequired] public EventCallback<long> OnValueChanged { get; set; }

    private long _maxUploadSize;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _maxUploadSize = InitialValue;
    }

}