@using Datahub.Portal.Pages.Account
@using GcdsWrapper.Blazor

<SettingsField Label="@Localizer["Prevent auto-delete"]" Description="@Localizer["This setting will prevent the workspace from being automatically deleted after a period of inactivity or from going over budget"]">
    <GcdsCheckboxes Name="prevent-auto-delete" Legend="@Localizer["Prevent auto-delete"]" Options="@PreventAutoDeleteOptions" Value="@PreventAutoDeleteValue" ValueChanged="HandleValueChanged" ValueExpression="@(() => PreventAutoDeleteValue)" Disabled="@Disabled" />
</SettingsField>

@code {

    [Parameter] public bool InitialValue { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> OnValueChanged { get; set; }

    private bool _autoDelete;

    private IReadOnlyCollection<GcdsCheckboxOption> PreventAutoDeleteOptions =>
        [new("prevent-auto-delete-option", Localizer["Prevent auto-delete"], "enabled")];

    private string[] PreventAutoDeleteValue => _autoDelete ? ["enabled"] : [];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _autoDelete = InitialValue;
    }
    
    private async Task HandleValueChanged(string[]? values)
    {
        _autoDelete = values?.Contains("enabled") == true;
        await OnValueChanged.InvokeAsync(_autoDelete);
    }

}
