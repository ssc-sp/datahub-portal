@using Datahub.Core.Model.Projects
@using Datahub.Portal.Pages.Explore

<MudPaper Elevation="0" Outlined>
    <MudStack Row Class="pa-2" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icon"/>
        <MudText>
            <strong>
                @Project.ProjectName
            </strong>
            (@Project.Project_Acronym_CD)
        </MudText>
        <MudSpacer/>
        <ProjectPreviewCardIconDetails
            NumberOfUsers="Project?.Users?.Count(x => x.RoleId != (int)Project_Role.RoleNames.Remove) ?? 0"
            NumberOfRepositories="Project?.Repositories?.Count ?? 0"
            NumberOfFiles="0"/>
        <DHButton Underline Color="Color.Primary"
                  Href="@($"/{PageRoutes.WorkspacePrefix}/{Project?.Project_Acronym_CD}")"
                  EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight">@Localizer["View workspace"]</DHButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public Datahub_Project Project { get; set; }
    [Parameter] public string? Icon { get; set; }

}