@using Datahub.Core.Model.Achievements
@using Datahub.Core.Model.Users
@using Datahub.Portal.Components.User

@inherits ViewUserBase<HomePage>

@inject DatahubPortalConfiguration _datahubPortalConfiguration
@inject IPortalUserTelemetryService _telemetryService
@inject IUserSettingsService _userSettingsService

@attribute [Route(PageRoutes.Home)]
@attribute [Route(PageRoutes.Home_FR)]


<MudStack>
    @if (_viewedPortalUser is null || _viewedPortalUser == _currentGuid)
    {
        <div role="group">
            <MudStack Row AlignItems="AlignItems.End">
                <DHMainContentTitle Title="@Localizer["Home"]" />
                <MudSpacer />
                @if (_viewedPortalUser is not null)
                {
                    <UserCard ViewedUserGraphId="@_viewedPortalUser.GraphGuid" RightAvatar ShowLoginTime />
                }
            </MudStack>
            <AnnouncementCarousel />
        </div>
    }
    else
    {
        <MudImage Src="@_datahubPortalConfiguration.Media.GetAchievementImageUrl(_viewedPortalUser?.BannerPictureUrl)"
                  Alt="@Localizer["User's background image"]"
                  Class="rounded-lg mud-elevation-4"
                  Style="width: 100%"
                  ObjectFit="ObjectFit.Cover"
                  Height="320"
                  ObjectPosition="ObjectPosition.Center" />
    }    
    <UserProjects EntraGraphID="@_userProjectGuid" SmSize="6" NewStyle />
</MudStack>

@code {

    private string _currentGuid;
    private PortalUser _viewedPortalUser;
    private string _userProjectGuid;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _currentGuid = await _userInformationService.GetCurrentUserEntraId();
        _viewedPortalUser = await GetViewedPortalUserAsync();
        if (_viewedPortalUser.GraphGuid != _currentGuid)
        {
            await _telemetryService.LogTelemetryEvent(TelemetryEvents.UserViewOtherProfile);
        }

        _userProjectGuid = _viewedPortalUser.GraphGuid;
    }


}