@using Datahub.Portal.Pages.Resources
<MudPaper Outlined Elevation="0" Class="pa-4">
    <MudStack Spacing="8">
        <MudText Typo="Typo.h3">
            @Localizer["Not sure where to start?"]
        </MudText>
        <MudText>
            @Localizer["Have a look at our extensive documentation to get started. These learning resources will guide you through the process of creating your first workspace, managing resources, and sharing data. They also provide detailed information on how to use the various tools and services available."]
        </MudText>
        <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd">
            <DHButton Underline Color="Color.Primary"
                      Href=@($"/{PageRoutes.ResourcePrefix}/{ResourcesPage.CreateAWorkspace}")
                      EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight">@Localizer["How do I create a workspace?"]</DHButton>
            <DHButton Underline Color="Color.Primary"
                      Href=@($"/{PageRoutes.ResourcePrefix}/{ResourcesPage.InviteAUser}")
                      EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight">@Localizer["How do I invite users to my workspace?"]</DHButton>
            <DHButton Underline Color="Color.Primary"
                      Href=@($"/{PageRoutes.ResourcePrefix}/{ResourcesPage.RequestSupport}")
                      EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight">@Localizer["How do I request support?"]</DHButton>
            <DHButton Variant="Variant.Filled" Color="Color.Primary" Underline
                      Href="@Localizer[PageRoutes.CreateWorkspace]"
                      EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight">@Localizer["View resources"]</DHButton>
        </MudStack>
    </MudStack>
</MudPaper>


