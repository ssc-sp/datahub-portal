@using Datahub.Core
@using Datahub.Core.Model.Projects
@using MudBlazor.Utilities

    <h2 class="sr-only">
        @Localizer["Workspace security level information"]
    </h2>
    <p style="@_styles">
        @Localizer[GetSecurityLabel(SecurityLevel)]
    </p>

@code {
    [Parameter] public int SecurityLevel { get; set; }

    [Parameter] public string? ChildContent { get; set; }

    private string _styles = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _styles = new StyleBuilder()
            .AddStyle("height", "20px")
            .AddStyle("width", "100%")
            .AddStyle("background-color", GetSecurityColor(SecurityLevel))
            .AddStyle("position", "fixed")
            .AddStyle("top", "0px")
            .AddStyle("left", "0px")
            .AddStyle("z-index", "1400")
            .AddStyle("text-align", "center")
            .AddStyle("font-size", "12px")
            .AddStyle("color", "white")
            .AddStyle("font-weight", "bold")
            .AddStyle("font-family", "Consolas, monospace")
            .Build();
    }

    private string GetSecurityColor(int securityLevel)
    {
        switch (securityLevel)
        {
            case 2:
                return "rgb(244, 67, 54)";
            case 1:
                return "rgb(255,152,0)";
            default:
                return "rgb(89, 74, 226)";
        }
    }

    private string GetSecurityLabel(int securityLevel)
    {
        switch (securityLevel)
        {
            case 2:
                return Localizer["Protected B"];
            case 1:
                return Localizer["Protected A"];
            default:
                return Localizer["Unclassified"];
        }
    }

}
