<SectionContent SectionName="@DatahubTheme.SideBarContentName">
    <MudDrawer
        Width="320px"
        Variant="DrawerVariant.Mini"
        @bind-Open="@Open"
        Overlay="false"
        Style="@DatahubTheme.SideBorderStyle"
        Elevation="0"
        OpenMiniOnHover="false"
        ClipMode="DrawerClipMode.Always" MiniWidth="70px">
        <CascadingValue Value="this">
                @ChildContent
        </CascadingValue>
    </MudDrawer>
</SectionContent>

@inject ILocalStorageService _localStorage

@code {
    private const string DrawerOpenKey = "dh-sidebar-open";

    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; }
    public bool Open { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await _localStorage.GetItemAsync<bool?>(DrawerOpenKey);
            // Default to open only if a preference was previously saved; first-time visitors
            // get the collapsed (mini) state to avoid the "massive box" snap-in effect.
            Open = saved ?? false;
            StateHasChanged();
        }
    }

    public async Task ToggleDrawer()
    {
        Open = !Open;
        await _localStorage.SetItemAsync(DrawerOpenKey, Open);
    }
}