<SkipLink Anchor Type="SkipLinkType.MainContent">
    @if (Title != null)
    {
        <MudText Typo="Typo.h1">@Title</MudText>
    }
    else
    {
        @ChildContent
    }
</SkipLink>

    @code {

    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    [Parameter] public string Title { get; set; } = null!;

}
