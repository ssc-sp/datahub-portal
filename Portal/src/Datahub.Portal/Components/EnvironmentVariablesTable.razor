@using Datahub.Core.Model.Projects
@using Datahub.Application.Services.UserManagement
@using GcdsWrapper.Blazor

@inject IKeyVaultUserService keyVaultUserService
@inject IDbContextFactory<DatahubProjectDBContext> _dbContextFactory
@inject ILogger<EnvironmentVariablesTable> _logger
@inject ISnackbar _snackbar
@inject IUserInformationService _userInformationService

<GcdsHeading Tag="h2">
  @Localizer["Environment variables"]
</GcdsHeading>
@if (loading || projectUser is null)
{
  <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (envError)
{
  <GcdsText>@Localizer["Error accessing the environment variables"]</GcdsText>
}
else
{
  <GcdsText>
    @Localizer["Environment variables are stored in Azure Keyvault and are made available to your web application as operating system level environment variables. They are available during the build process and the run process of your web application."]
  </GcdsText>

  <GcdsTable Columns="@Columns" Data="@Rows" Filter="true" Sort="true" Pagination="false">
    <span slot="caption" class="sr-only">@Localizer["Environment variables"]</span>
  </GcdsTable>
  @if (CanRevealValues)
  {
    <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" OnClick="ToggleValues">
      @Localizer[_show ? "Hide environment variable values" : "Show environment variable values"]
    </GcdsButton>
  }

  <DatahubAuthView AuthLevel="DatahubAuthView.AuthLevels.WorkspaceAdmin" ProjectAcronym="@projectAcronym"
                   ElevatedWorkspaceAccessEnabled="true">
    <Authorized>
      @if (isEditable)
      {
        <section id="environment-variable-editor" aria-labelledby="environment-variable-editor-heading" class="mt-6">
          <GcdsHeading Id="environment-variable-editor-heading" Tag="h3">
            @Localizer["Manage environment variables"]
          </GcdsHeading>

          @if (envVars.Any())
          {
            
            <GcdsSelect Id="environment-variable-selection" Name="environment-variable-selection"
                        Label="@Localizer["Select an environment variable to edit"]" DefaultValue="@Localizer["Please Select"]"
                        Disabled="@_isSaving" @bind-Value="SelectedEnvironmentVariableKey">
              @foreach (var environmentVariable in envVars.OrderBy(variable => variable.Key, StringComparer.Ordinal))
              {
                <option value="@environmentVariable.Key">@environmentVariable.Key</option>
              }
            </GcdsSelect>

            @if (_editorVisible)
            {
              <div class="my-4">
                <GcdsHeading Tag="h4">
                  @Localizer[_isAdding ? "Add environment variable" : "Edit environment variable"]
                </GcdsHeading>
                <GcdsInput Id="environment-variable-key" Name="environment-variable-key"
                           Label="@Localizer["Environment variable key"]" Required Disabled="@(!_isAdding || _isSaving)"
                           ErrorMessage="@_keyError" @bind-Value="EditorKey" />
                <GcdsInput Id="environment-variable-value" Name="environment-variable-value"
                           Label="@Localizer["Environment variable value"]" Type="GcdsInputType.Password" Required Disabled="@_isSaving"
                           ErrorMessage="@_valueError" @bind-Value="EditorValue" />
                <div class="d-flex gap-2 mt-4">
                  <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" Disabled="@_isSaving"
                              OnClick="CancelEditingEnvironmentVariable">
                    @Localizer["Cancel"]
                  </GcdsButton>
                  <GcdsButton Type="GcdsButtonType.Button" Disabled="@_isSaving" OnClick="SaveEnvironmentVariableAsync">
                    @Localizer[_isSaving ? "Saving..." : "Save"]
                  </GcdsButton>
                </div>
              </div>
            }
          }

          <GcdsButton Type="GcdsButtonType.Button" Role="GcdsButtonRole.Secondary" Disabled="@_isSaving"
                      OnClick="StartAddingEnvironmentVariable">
            @Localizer["Add environment variable"]
          </GcdsButton>
        </section>
      }

      @if (needsRestart)
      {
        <GcdsNotice NoticeRole="warning" NoticeTitle="@Localizer["Restart required"]" NoticeTitleTag="h3">
          <GcdsText>@Localizer["You must restart your web application to apply the latest changes."]</GcdsText>
        </GcdsNotice>
      }
    </Authorized>
  </DatahubAuthView>
}

@code {
  [Parameter] public Project_Resources2 resource { get; set; } = null!;
  [Parameter] public string projectAcronym { get; set; } = string.Empty;
  [Parameter] public bool isEditable { get; set; }

  public List<KeyValuePair> envVars = [];
  private bool _show = false;
  private bool envError = false;
  private bool loading = true;
  public bool needsRestart = false;
  private UserRoleLinks? projectUser;
  private bool _editorVisible;
  private bool _isAdding;
  private bool _isSaving;
  private string? _selectedEnvironmentVariableKey;
  private string? _editorKey;
  private string? _editorValue;
  private string? _keyError;
  private string? _valueError;

  private bool CanRevealValues => projectUser?.Role?.IsAtLeastAdmin == true && envVars.Any();

  private IReadOnlyCollection<TableColumn> Columns =>
  [
    new("key", Localizer["Key"], true),
    new("value", Localizer["Value"])
  ];

  private IReadOnlyCollection<IReadOnlyDictionary<string, string>> Rows => envVars
      .Select(environmentVariable => (IReadOnlyDictionary<string, string>)new Dictionary<string, string>
      {
        ["key"] = environmentVariable.Key,
        ["value"] = FormatValue(environmentVariable.Value)
      })
      .ToArray();

  private string? SelectedEnvironmentVariableKey
  {
    get => _selectedEnvironmentVariableKey;
    set => StartEditingEnvironmentVariable(value);
  }

  private string? EditorKey
  {
    get => _editorKey;
    set
    {
      _editorKey = value;
      _keyError = null;
    }
  }

  private string? EditorValue
  {
    get => _editorValue;
    set
    {
      _editorValue = value;
      _valueError = null;
    }
  }


  protected override async Task OnInitializedAsync()
  {
    try
    {
      await using var ctx = await _dbContextFactory.CreateDbContextAsync();
      var currentUser = await _userInformationService.GetCurrentPortalUserAsync()
          ?? throw new InvalidOperationException("Could not find current portal user");
      projectUser = ctx.UserRolesLinks.Include(datahubProjectUser => datahubProjectUser.Role)
          .FirstOrDefault(u => u.PortalUser.Id == currentUser.Id &&
                               u.Project.Project_Acronym_CD == projectAcronym);
      envVars = await GetEnvironmentVariables();
      loading = false;
      StateHasChanged();
    }
    catch (Exception ex)
    {
      _logger.LogError(ex, "Failed to get environment variables");
      envError = true;
      loading = false;
    }
  }

  private string FormatValue(string value)
  {
    if (!CanRevealValues)
    {
      return "********";
    }

    if (string.IsNullOrEmpty(value))
    {
      return Localizer["Could not find value"];
    }

    return _show ? value : GetHiddenValue(value);
  }

  private sealed record TableColumn(string Field, string Header, bool RowHeader = false);

}
