                stars--;
                <DenseProjectCard Project="@project" Icon="@Icons.Material.Outlined.StarOutline"/>
            }
            else
            {
                <DenseProjectCard Project="@project"/>
            }
        }
        @foreach (var project in _collaboratedProjects)
