            </MudStack>
        </MudPaper>
        <MudPaper Elevation="0" Outlined Height="200" Width="403px" Class="pa-4">
            <MudStack Row>
                <MudText>
                    <strong>
                        @Localizer["Example workspace 2"]
                    </strong>
                    (@Localizer["EW2"])
                </MudText>
                <MudSpacer/>
                <ProjectPreviewCardIconDetails
