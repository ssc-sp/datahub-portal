@*WorkspaceObjectMetadata.razor *@

@using Microsoft.AspNetCore.Components
@using Datahub.Core.Model.Onboarding
@using Datahub.Core.Model.Projects
@using Datahub.Core.Services.CatalogSearch;
@using Datahub.Metadata.DTO
@using Datahub.Metadata.Model
@using Datahub.Core
@using Datahub.Metadata.Utils
@using MudBlazor

@inject NavigationManager NavigationManager
@inject ILogger<ProjectObjectMetadata> Logger
@inject ISnackbar _snackbar
@inject IDbContextFactory<DatahubProjectDBContext> ContextFactory

<h3>GC Hosting Workspace Metadata</h3>
@if (!_loaded)
{
    <div>Loading...</div>
}
else if (_workspace is not null)
{
    <div class="workspace-metadata">
        <div class="workspace-metadata">
            <MudTextField Label="@Localizer["Workspace Name"]" Value="@_workspace.WorkspaceName" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Description"]" Value="@_workspace.WorkspaceDescription" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Subject"]" Value="@_workspace.Subject" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Keywords"]" Value="@_workspace.Keywords" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />

            <h4>@Localizer["Lead Info"]</h4>
            <MudTextField Label="@Localizer["Lead Name"]" Value="@($"{_workspace.LeadFirstName} {_workspace.LeadLastName}")" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Lead Email"]" Value="@_workspace.LeadEmail" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />

            <h4>@Localizer["Financial Authority"]</h4>
            <MudTextField Label="@Localizer["Name"]" Value="@($"{_workspace.FinancialAuthorityFirstName} {_workspace.FinancialAuthorityLastName}")" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Email"]" Value="@_workspace.FinancialAuthorityEmail" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Commitment ISRef"]" Value="@_workspace.FinancialAuthorityCommitmentIsRef" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Commitment ISOrg"]" Value="@_workspace.FinancialAuthorityCommitmentIsOrg" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />

            <h4>@Localizer["Budget & Retention"]</h4>
            <MudTextField Label="@Localizer["Budget"]" Value="@_workspace.WorkspaceBudget" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Retention Period"]" Value="@_workspace.RetentionPeriodYears.ToString()" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Retention Start Date"]" Value="@_workspace.RetentionPeriodStartDate.ToShortDateString()" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />
            <MudTextField Label="@Localizer["Retention Value"]" Value="@_workspace.RetentionValue" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />

            <h4>@Localizer["Security"]</h4>
            <MudTextField Label="@Localizer["Security Classification"]" Value="@_workspace.SecurityClassification" ReadOnly="true" Disabled="false" Variant="Variant.Outlined" />

        </div>

    </div>
}
else
{
    <div>@_message</div>
}

@code {
    [Parameter]
    public string ProjectAcronym { get; set; }

    private GCHostingWorkspaceDetails _workspace;
    private string _message = "Workspace has no GC Hosting Metadata";
    private bool _loaded = false;
    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _workspace = null;

        Console.WriteLine("OnParametersSetAsync started");

        if (string.IsNullOrWhiteSpace(ProjectAcronym))
        {
            _loaded = true;
            return;
        }

        try
        {
            using var context = await ContextFactory.CreateDbContextAsync();

            var project = await context.Projects.Include(p => p.Resources)
                .AsSingleQuery()
                .FirstOrDefaultAsync(p => p.Project_Acronym_CD == ProjectAcronym);

            if (project is not null && project.ParentGCHostingBudgetId.HasValue)
            {
                _message = "details: found";
                _workspace = await context.GCHostingWorkspaceDetails
                    .AsNoTracking()
                    .Include(b => b.WorkspacesInBudget)
                    .FirstOrDefaultAsync(b => b.Id == project.ParentGCHostingBudgetId); 
            }
            else  // fallback to demo workspace
            {
                _message = "details: default";
                _workspace = await context.GCHostingWorkspaceDetails
                    .AsNoTracking()
                    .Include(b => b.WorkspacesInBudget)
                    .FirstOrDefaultAsync(b => b.Id == 304);
                _message += " 304";
                Console.WriteLine($"Default workspace loaded: {(_workspace != null ? "yes" : "no")}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading workspace metadata."); 
            _workspace = null;
            Console.WriteLine("Exception: " + ex);
        }
        _loaded = true;
        StateHasChanged(); 
    }

}
