@using Datahub.Application.Services.Announcements
@using GcdsWrapper.Blazor
@using MudBlazor.Utilities

@inject IAnnouncementService _announcementService
@inject ICultureService CultureService

@if (_previewCount > 0)
{
    <MudText Typo="Typo.h2">@Localizer["Announcements"]</MudText>
}
<ul class="my-4 d-flex" style="gap: 25px; flex-wrap: wrap">
    @foreach (var index in _announcementIndices)
    {
        if (index != -1)
        {
            var preview = Previews[index];
            if (!preview.Preview.StartsWith("!["))
            {
                var result = SplitTitleAndBody(preview.Preview);
                // Remove any leading hash tag and space from the title if it exists
                if (result.title.StartsWith("# "))
                {
                    result.title = result.title.Substring(2);
                }
                <li class="flex-1">
                    <GcdsNotice NoticeRole=@GetSeverity(preview.Severity) NoticeTitle="@result.title" NoticeTitleTag="h3">
                        <DHMarkdown Content="@result.body" Style="@_descriptionTextStyle" />
                        <GcdsText Size="small">
                            <GcdsLink Href="@Localizer[PageRoutes.News]">@Localizer["Read more"]</GcdsLink>
                        </GcdsText>
                    </GcdsNotice>
                </li>
            }
        }
    }
</ul>

@code {
    private bool _isLoading = true;

    public List<AnnouncementPreview> Previews { get; set; } = new();

    private string _descriptionTextStyle;

    private int _previewCount;
    private int[] _announcementIndices = new int[3] { -1, -1, -1 };

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        _descriptionTextStyle = new StyleBuilder()
            .AddStyle("overflow", "hidden")
            .AddStyle("-webkit-line-clamp", "4")
            .AddStyle("-webkit-box-orient", "vertical")
            .AddStyle("display", "-webkit-box")
            .Build();

        Previews = (await _announcementService.GetActivePreviews(CultureService.IsFrench)).OrderBy(o => o.Severity).ToList();

        for (int i = 0; i < Math.Min(Previews.Count, 3); i++)
        {
            var preview = Previews[i];
            _announcementIndices[i] = i;
        }

        // There should really only be 1, 2, or 3 announcements at a time
        // The # of columns for the announcements is displayed accordingly
        _previewCount = Math.Min(Previews.Count, 3);
        _isLoading = false;
    }

    public static (string title, string body) SplitTitleAndBody(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return (string.Empty, string.Empty);
        }

        int newlineIndex = input.IndexOf('\n');
    
        if (newlineIndex == -1)
        {
            // No newline found - entire string is first line, remaining is empty
            return (input, string.Empty);
        }
    
        // Extract first line (everything before first newline)
        string title = input.Substring(0, newlineIndex);
    
        // Extract remaining content (everything after first newline)
        string body = input.Substring(newlineIndex + 1);
    
        return (title, body);
    }

    private string GetSeverity(int n)
    {
        if (n == 0) return "danger";
        if (n == 1) return "warning";
        return "info";
    }
}

