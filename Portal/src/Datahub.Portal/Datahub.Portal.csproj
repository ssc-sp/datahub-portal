<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Version>3.13.0</Version>
		<TargetFramework>net10.0</TargetFramework>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<UserSecretsId>b1e84dc3-b45f-428e-bf71-7eec3434b232</UserSecretsId>
		<CodeAnalysisRuleSet>..\..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
	</PropertyGroup>
	<ItemGroup>
		<Content Remove="Data\AzureFlexServers.json" />
		<Content Remove="i18n\*.json" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Controllers\OpenDataApprovalForm.docx" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Controllers\OpenDataApprovalForm.docx" />
		<EmbeddedResource Include="Data\AzureFlexServers.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Azure.Identity">
			<Aliases>AzIdentity</Aliases>
		</PackageReference>
		<PackageReference Include="Azure.ResourceManager" />
		<PackageReference Include="Azure.ResourceManager.Authorization" />
		<PackageReference Include="Azure.ResourceManager.PostgreSql" />
		<PackageReference Include="Blazor-ApexCharts" />
		<PackageReference Include="DocumentFormat.OpenXml" />
		<PackageReference Include="Blazored.SessionStorage" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
		<PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Azure" />
		<PackageReference Include="Microsoft.Graph" />
		<PackageReference Include="Microsoft.Identity.Web" />
		<PackageReference Include="Microsoft.Identity.Web.MicrosoftGraph" />
		<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
		<PackageReference Include="Microsoft.Kiota.Abstractions" />
		<PackageReference Include="Microsoft.PowerBI.JavaScript" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Core" />
		<PackageReference Include="MiniProfiler.AspNetCore.Mvc" />
		<PackageReference Include="MiniProfiler.EntityFrameworkCore" />
		<PackageReference Include="Octokit" />
		<PackageReference Include="PSC.Blazor.Components.MarkdownEditor" />
		<PackageReference Include="MudBlazor" />
		<PackageReference Include="Toolbelt.Blazor.LocalTimeText.Server" />
		<PackageReference Include="CsvHelper" />

		<!-- Add: build-time bundling/minification -->
		<PackageReference Include="BuildBundlerMinifier" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="wwwroot\infinite-scrolling.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\js\markdown-editor.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Datahub.Application\Datahub.Application.csproj" />
		<ProjectReference Include="..\Datahub.CatalogSearch\Datahub.CatalogSearch.csproj" />
		<ProjectReference Include="..\Datahub.Core\Datahub.Core.csproj" />
		<ProjectReference Include="..\Datahub.Infrastructure.Offline\Datahub.Infrastructure.Offline.csproj" />
		<ProjectReference Include="..\Datahub.Infrastructure\Datahub.Infrastructure.csproj" />
		<ProjectReference Include="..\Datahub.Metadata\Datahub.Metadata.csproj" />
		<ProjectReference Include="..\Datahub.Portal.Metadata\Datahub.Portal.Metadata.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Datahub.SpecflowTests" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="i18n\*.json" WithCulture="false" />
	</ItemGroup>

	<!-- Use the minified CSS during publish (Release) but keep your code referencing site.css -->
	<Target Name="UseMinifiedCssOnPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)'=='Release'">
		<ItemGroup>
			<!-- Serve the combined min as site.css -->
			<ResolvedFileToPublish Include="wwwroot\css\site.min.css">
				<RelativePath>wwwroot\css\site.css</RelativePath>
				<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<!-- Also serve the same combined min as site.dark.css -->
			<ResolvedFileToPublish Include="wwwroot\css\site.min.css">
				<RelativePath>wwwroot\css\site.dark.css</RelativePath>
				<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>
</Project>








