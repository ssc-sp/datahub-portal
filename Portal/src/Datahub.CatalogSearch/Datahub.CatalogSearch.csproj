<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Lucene\stopwords_en.txt" />
	  <None Remove="Lucene\stopwords_fr.txt" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Lucene\stopwords_en.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Lucene\stopwords_fr.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		
		
		<PackageReference Include="Azure.Core" Version="1.46.2" />
		
		
		<PackageReference Include="Azure.Identity" Version="1.14.1" />
		
		
		<PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00016" />
		
		
		<PackageReference Include="Microsoft.Identity.Client" Version="4.73.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Datahub.Metadata\Datahub.Metadata.csproj" />
	</ItemGroup>

</Project>
