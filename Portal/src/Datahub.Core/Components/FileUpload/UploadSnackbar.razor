@using Datahub.Core.Data
@if (ChildContent != null)
{
    @ChildContent
}

@if (ShowSnackbar)
{
    <div class="upload-snackbar">
        @foreach (var file in UploadingFiles)
        {
            <div class="upload-snack">
                <i class="fas fa-file-alt"></i>
                <span class="upload-text">
                    <MudText>
                        @file.filename
                    </MudText>
                    <MudText>
                        @UploadedByteSize(file.uploadedBytes)
                    </MudText>
                </span>
                <div class="snack-file-progress">
                    <div class="file-progress-bar" style="width: @CalculateProgress(file)%;">@CalculateProgress(file).ToString("0.00")%</div>
                </div>
            </div>
        }

        @foreach (var file in BlockedFiles)
        {
            <MudAlert Severity="Severity.Error" 
                ShowCloseIcon CloseIconClicked="() => BlockedFileClosed(file)" 
                Icon="@Icons.Material.Filled.Block" 
                Variant="Variant.Filled" Elevation="6">
                 @Localizer["{0} has been blocked.", file]
            </MudAlert>
        }
    </div>
}

@code {

    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter, EditorRequired]
    public required List<FileMetaData> UploadingFiles { get; set; }

    [Parameter, EditorRequired]
    public required List<string> BlockedFiles { get; set; }

    private bool ShowSnackbar => (UploadingFiles?.Any() ?? false) || (BlockedFiles?.Any() ?? false);

    private string UploadedByteSize(long size)
    {
        return ByteSizeLib.ByteSize.FromBytes(size).ToString();
    }

    private float CalculateProgress(FileMetaData file)
    {
        return file.bytesToUpload > 0 ? (float) file.uploadedBytes / file.bytesToUpload * 100F : -1F;
    }

    private void BlockedFileClosed(string file)
    {
        BlockedFiles?.Remove(file);
    }

}