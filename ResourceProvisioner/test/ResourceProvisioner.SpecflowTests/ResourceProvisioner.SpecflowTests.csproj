<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>3aec5266-30a7-48a0-a649-6a97a1b7c505</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.*" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.*" />
        <PackageReference Include="NSubstitute" Version="5.3.*" />
        <PackageReference Include="Reqnroll" Version="3.2.*" />
        <PackageReference Include="Reqnroll.xUnit" Version="3.2.*" />        
        <PackageReference Include="xunit" Version="2.9.*" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="8.8.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ResourceProvisioner.Application\ResourceProvisioner.Application.csproj" />
        <ProjectReference Include="..\..\src\ResourceProvisioner.Functions\ResourceProvisioner.Functions.csproj" />
        <ProjectReference Include="..\..\src\ResourceProvisioner.Infrastructure\ResourceProvisioner.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.test.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Features\*.feature" />
    </ItemGroup>

</Project>













